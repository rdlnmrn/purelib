import CCL.Knot.ClosureComponents

/-!
# Executable torus-knot genus and Alexander data

This file supplies finite integer-polynomial and positive-braid surface
certificates for the torus family.  Polynomial coefficients are stored in
low-to-high order.  Equality is coefficientwise over one explicit finite
bound, so concrete certificates reduce by kernel computation.

The Alexander candidate uses the numerical semigroup generated by `p` and
`q`: below the conductor `(p-1)(q-1)`, its coefficient at `n` is the change
in the semigroup-membership indicator from `n-1` to `n`.  A certificate checks
the familiar exact identity

`Delta(t) (1-t^p) (1-t^q) = (1-t^(pq)) (1-t)`.

No completed Laurent series or quotient field is constructed.
-/

namespace CCL.Knot.TorusInvariants

open CCL.Knot.TorusBraid

/-! ## Finite integer polynomials -/

namespace IntPolynomial

abbrev Polynomial := List Int

def coefficient : Polynomial → Nat → Int
  | [], _ => 0
  | value :: _, 0 => value
  | _ :: remaining, degree + 1 => coefficient remaining degree

def add : Polynomial → Polynomial → Polynomial
  | [], right => right
  | left, [] => left
  | left :: leftTail, right :: rightTail =>
      (left + right) :: add leftTail rightTail

def scale (factor : Int) (polynomial : Polynomial) : Polynomial :=
  polynomial.map fun coefficient => factor * coefficient

def mul : Polynomial → Polynomial → Polynomial
  | [], _ => []
  | left :: leftTail, right =>
      add (scale left right) (0 :: mul leftTail right)

def monomial (degree : Nat) (coefficient : Int) : Polynomial :=
  List.replicate degree 0 ++ [coefficient]

def oneSubPower (exponent : Nat) : Polynomial :=
  add [1] (monomial exponent (-1))

/-- Executable check that a displayed coefficient tail is entirely zero. -/
def allZero : Polynomial → Bool
  | [] => true
  | coefficient :: remaining =>
      decide (coefficient = 0) && allZero remaining

/-- Executable coefficientwise equality, ignoring only trailing zeros. -/
def same? : Polynomial → Polynomial → Bool
  | [], right => allZero right
  | left :: leftTail, [] => decide (left = 0) && allZero leftTail
  | left :: leftTail, right :: rightTail =>
      decide (left = right) && same? leftTail rightTail

def Same (left right : Polynomial) : Prop := same? left right = true

theorem same?_self (polynomial : Polynomial) :
    same? polynomial polynomial = true := by
  induction polynomial with
  | nil =>
      unfold same?
      rfl
  | cons head tail inductionHypothesis =>
      rw [same?, decide_eq_true rfl, inductionHypothesis]
      rfl

theorem same_refl (polynomial : Polynomial) : Same polynomial polynomial :=
  same?_self polynomial

instance decidableSame (left right : Polynomial) : Decidable (Same left right) :=
  by
    unfold Same
    infer_instance

def reverseCoefficients (polynomial : Polynomial) : Polynomial :=
  polynomial.reverse

def Symmetric (polynomial : Polynomial) : Prop :=
  polynomial.reverse = polynomial

instance decidableSymmetric (polynomial : Polynomial) :
    Decidable (Symmetric polynomial) := by
  unfold Symmetric
  infer_instance

end IntPolynomial

/-! ## Semigroup Alexander candidate -/

def conductor (p q : Nat) : Nat := (p - 1) * (q - 1)

/-- Bounded search for `value = a*p + b*q`.  Searching through `value` for
both coefficients is sufficient for positive generators and remains total on
all displayed natural inputs. -/
def semigroupMember (p q value : Nat) : Bool :=
  (List.range (value + 1)).any fun left =>
    (List.range (value + 1)).any fun right =>
      decide (left * p + right * q = value)

def semigroupIndicator (p q value : Nat) : Int :=
  if semigroupMember p q value then 1 else 0

def alexanderCoefficient (p q degree : Nat) : Int :=
  if degree = 0 then semigroupIndicator p q 0
  else semigroupIndicator p q degree - semigroupIndicator p q (degree - 1)

/-- Normalized low-to-high Alexander candidate through the conductor. -/
def alexanderPolynomial (p q : Nat) : IntPolynomial.Polynomial :=
  List.ofFn fun degree : Fin (conductor p q + 1) =>
    alexanderCoefficient p q degree.val

@[simp] theorem alexanderPolynomial_length (p q : Nat) :
    (alexanderPolynomial p q).length = conductor p q + 1 := by
  simp only [alexanderPolynomial, List.length_ofFn]

def alexanderDenominator (p q : Nat) : IntPolynomial.Polynomial :=
  IntPolynomial.mul (IntPolynomial.oneSubPower p)
    (IntPolynomial.oneSubPower q)

def alexanderNumerator (p q : Nat) : IntPolynomial.Polynomial :=
  IntPolynomial.mul (IntPolynomial.oneSubPower (p * q))
    (IntPolynomial.oneSubPower 1)

/-- Exact finite validation of a normalized torus Alexander polynomial. -/
structure AlexanderCertificate (p q : Nat) where
  polynomial : IntPolynomial.Polynomial
  expectedLength : polynomial.length = conductor p q + 1
  constantOne : IntPolynomial.coefficient polynomial 0 = 1
  leadingOne : IntPolynomial.coefficient polynomial (conductor p q) = 1
  symmetric : IntPolynomial.Symmetric polynomial
  quotientIdentity : IntPolynomial.Same
    (IntPolynomial.mul polynomial (alexanderDenominator p q))
    (alexanderNumerator p q)

/-- Package the semigroup candidate once its wholly finite checks have been
proved.  Concrete examples discharge these propositions with kernel
`decide`; the fields retain the checked equations for downstream use. -/
def alexanderCertificate (p q : Nat)
    (constantOne : IntPolynomial.coefficient (alexanderPolynomial p q) 0 = 1)
    (leadingOne : IntPolynomial.coefficient (alexanderPolynomial p q)
      (conductor p q) = 1)
    (symmetric : IntPolynomial.Symmetric (alexanderPolynomial p q))
    (identity : IntPolynomial.Same
      (IntPolynomial.mul (alexanderPolynomial p q)
        (alexanderDenominator p q))
      (alexanderNumerator p q)) : AlexanderCertificate p q where
  polynomial := alexanderPolynomial p q
  expectedLength := alexanderPolynomial_length p q
  constantOne := constantOne
  leadingOne := leadingOne
  symmetric := symmetric
  quotientIdentity := identity

/-! ## Canonical positive-braid surface -/

/-- Familiar torus-knot genus candidate. -/
def canonicalGenus (p q : Nat) : Nat := conductor p q / 2

/-- Finite cell-count certificate for the canonical positive-braid Seifert
surface.  It has `p` disks, `q(p-1)` bands, and one boundary component.  The
Euler equation is stored without natural-number subtraction. -/
structure CanonicalSurfaceCertificate (singularity : PowerSingularity) where
  genus : Nat
  genus_eq : genus = canonicalGenus singularity.p singularity.q
  diskCount : Nat
  diskCount_eq : diskCount = singularity.p
  bandCount : Nat
  bandCount_eq : bandCount = singularity.q * (singularity.p - 1)
  boundaryCount : Nat
  boundaryCount_eq : boundaryCount = 1
  eulerIdentity :
    2 * genus + diskCount + boundaryCount = 2 + bandCount

def canonicalSurfaceCertificate (singularity : PowerSingularity)
    (eulerIdentity :
      2 * canonicalGenus singularity.p singularity.q + singularity.p + 1 =
        2 + singularity.q * (singularity.p - 1)) :
    CanonicalSurfaceCertificate singularity where
  genus := canonicalGenus singularity.p singularity.q
  genus_eq := rfl
  diskCount := singularity.p
  diskCount_eq := rfl
  bandCount := singularity.q * (singularity.p - 1)
  bandCount_eq := rfl
  boundaryCount := 1
  boundaryCount_eq := rfl
  eulerIdentity := eulerIdentity

/-- A complete finite invariant package for one coprime torus example. -/
structure TorusKnotInvariantCertificate (singularity : PowerSingularity) where
  gcdOne : (RFAP.CanonicalGCD.compute singularity.p singularity.q).gcd = 1
  surface : CanonicalSurfaceCertificate singularity
  alexander : AlexanderCertificate singularity.p singularity.q
  alexanderDegree_eq_twiceGenus :
    conductor singularity.p singularity.q = 2 * surface.genus

theorem TorusKnotInvariantCertificate.isKnot
    {singularity : PowerSingularity}
    (certificate : TorusKnotInvariantCertificate singularity) :
    singularity.closure.IsKnot :=
  CCL.Knot.TorusKnot.PowerSingularity.closure_isKnot_of_gcdOne
    singularity certificate.gcdOne

end CCL.Knot.TorusInvariants
