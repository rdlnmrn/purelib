module
import Purelib.Geometry.Rotations.Projective.Action
import Purelib.NumberTheory.SquareClass.Rational.Signature
import Purelib.Data.Vector.Boolean.Basic
public import Purelib.Examples.Geometry.Rotations.QuaternionObstruction

import Purelib.Algebra.Quaternion.Projective.Basic
import Purelib.NumberTheory.SquareClass.Rational.Span
public import Purelib.Geometry.Rotations.Rational.Generators.Profile
import Purelib.Geometry.Rotations.Basic
import Purelib.Data.Rat.Fraction.Field
import Purelib.LinearAlgebra.Span.Boolean.Basic

open Purelib

open Purelib.Geometry

open Purelib.NumberTheory.SquareClass

@[expose] public section

/-!
# Checked finite chi-profile examples

These examples exercise the exact finite Boolean image on a trivial system,
one independent square class, and a rank-two system with redundant classes.
-/

namespace formalisations.RationalRotations.Chapters

open Purelib.Geometry.Rotations.Basic

namespace GeneratorProfileExamples

open Purelib.NumberTheory.SquareClass.Rational.Signature.PositiveSquareClassSignatures
open _root_.Purelib.NumberTheory.SquareClass.Rational.Signature renaming Positive -> Signature

/-- The positive rational square-class target represented by one. -/
def one : Rational.Span.GeneratorProfiles.Target :=
  positiveNaturalTarget 1 (by decide)

/-- The positive rational square-class target represented by two. -/
def two : Rational.Span.GeneratorProfiles.Target :=
  positiveNaturalTarget 2 (by decide)

/-- The positive rational square-class target represented by three. -/
def three : Rational.Span.GeneratorProfiles.Target :=
  positiveNaturalTarget 3 (by decide)

/-- The positive rational square-class target represented by six. -/
def six : Rational.Span.GeneratorProfiles.Target :=
  positiveNaturalTarget 6 (by decide)

/-- The finite generator profile consisting of the trivial square class. -/
def trivialProfile :=
  Rational.Span.GeneratorProfiles.visibleGeneratorProfile [one]

/-- The finite generator profile with the square class of two repeated twice. -/
def rankOneProfile :=
  Rational.Span.GeneratorProfiles.visibleGeneratorProfile [two, two]

/-- The rank-two generator profile with representatives 2, 3, 6 and 2.

The product class and repeated class are retained as redundant input generators. -/
def redundantRankTwoProfile :=
  Rational.Span.GeneratorProfiles.visibleGeneratorProfile [two, three, six, two]

/-- The profile generated by the trivial square class has rank zero. -/
theorem trivialProfile_rank : trivialProfile.span.rank = 0 := by
  decide +kernel

/-- The trivial square-class profile has one image entry. -/
theorem trivialProfile_image_length : trivialProfile.span.entries.length = 1 :=
  by decide +kernel

/-- The profile with two repeated generators of class two has rank one. -/
theorem rankOneProfile_rank : rankOneProfile.span.rank = 1 := by
  decide +kernel

/-- The repeated-class rank-one profile has two image entries. -/
theorem rankOneProfile_image_length :
    rankOneProfile.span.entries.length = 2 := by decide +kernel

/-- The profile with representatives 2, 3, 6 and 2 has rank two. -/
theorem redundantRankTwoProfile_rank :
    redundantRankTwoProfile.span.rank = 2 := by decide +kernel

/-- The rank-two profile with redundant generators has four image entries. -/
theorem redundantRankTwoProfile_image_length :
    redundantRankTwoProfile.span.entries.length = 4 := by decide +kernel

/-- The same rank-two pattern at the rotation-facing boundary: norms `2` and
`5`, their product, and a repeated first generator. -/
def productRotation : Rotation Rotations.Rational.Generators.Profile.RotationProfiles.Scalar :=
  (Rotations.Projective.Action.NonNullProportion.rotation (Algebra.Quaternion.Projective.Basic.NonNullProportion.mul
    Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn
    Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.threeFourFive))

/-- The rotation-facing profile of a quarter-turn, a three-four-five rotation, their product and the repeated
quarter-turn. -/
def redundantRotationProfile :=
  Rotations.Rational.Generators.Profile.RotationProfiles.visibleRotationProfile
    [(Rotations.Projective.Action.NonNullProportion.rotation
      Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn),
      (Rotations.Projective.Action.NonNullProportion.rotation
        Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.threeFourFive),
      productRotation,
      (Rotations.Projective.Action.NonNullProportion.rotation
        Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn)]

/-- The rotation profile retains all four displayed generator occurrences. -/
theorem redundantRotationProfile_generators_length :
    redundantRotationProfile.generators.length = 4 := by decide +kernel

/-- The displayed rotation profile has square-class rank two. -/
theorem redundantRotationProfile_rank :
    redundantRotationProfile.targetProfile.span.rank = 2 := by
  decide +kernel

/-- The displayed rotation profile has four square-class image entries. -/
theorem redundantRotationProfile_image_length :
    redundantRotationProfile.targetProfile.span.entries.length = 4 := by
  decide +kernel

/-- The forward quarter-turn letter with its membership witness in the retained rotation profile. -/
def firstForward :
    Rotations.Rational.Generators.Profile.RotationProfiles.SignedLetter redundantRotationProfile where
  generator := Rotations.Rational.Generators.Profile.RotationProfiles.generatorEntry
    (Rotations.Projective.Action.NonNullProportion.rotation
      Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn)
  member := by
    change Rotations.Rational.Generators.Profile.RotationProfiles.generatorEntry
      (Rotations.Projective.Action.NonNullProportion.rotation
        Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn) ∈
        Rotations.Rational.Generators.Profile.RotationProfiles.generatorEntries
          [(Rotations.Projective.Action.NonNullProportion.rotation
            Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn),
            (Rotations.Projective.Action.NonNullProportion.rotation
              Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.threeFourFive),
            productRotation,
            (Rotations.Projective.Action.NonNullProportion.rotation
              Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn)]
    exact List.mem_cons_self
  inverse := false

/-- The inverse quarter-turn letter with the same retained generator membership witness. -/
def firstInverse :
    Rotations.Rational.Generators.Profile.RotationProfiles.SignedLetter redundantRotationProfile where
  generator := Rotations.Rational.Generators.Profile.RotationProfiles.generatorEntry
    (Rotations.Projective.Action.NonNullProportion.rotation
      Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn)
  member := firstForward.member
  inverse := true

/-- The word consisting of the forward quarter-turn followed by its inverse. -/
def inversePairWord := [firstForward, firstInverse]

/-- The forward–inverse pair has zero Boolean signature vector. -/
theorem inversePairWord_vector :
    Rotations.Rational.Generators.Profile.RotationProfiles.signedWordVector redundantRotationProfile
        inversePairWord =
      Data.Vector.Boolean.Basic.zero
        redundantRotationProfile.targetProfile.finiteSupport.length := by
  unfold Rotations.Rational.Generators.Profile.RotationProfiles.signedWordVector
    Rotations.Rational.Generators.Profile.RotationProfiles.signedWordVectors inversePairWord
  simp only [List.map_cons, List.map_nil, List.foldr]
  rw [Data.Vector.Boolean.Basic.xor_zero]
  change Data.Vector.Boolean.Basic.xor
      (Rational.Span.GeneratorProfiles.signatureVector
        redundantRotationProfile.targetProfile.finiteSupport
        (Rotations.Rational.Generators.Profile.RotationProfiles.generatorEntry
          (Rotations.Projective.Action.NonNullProportion.rotation
            Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn)).target)
      (Rational.Span.GeneratorProfiles.signatureVector
        redundantRotationProfile.targetProfile.finiteSupport
        (Rotations.Rational.Generators.Profile.RotationProfiles.generatorEntry
          (Rotations.Projective.Action.NonNullProportion.rotation
            Examples.Geometry.Rotations.QuaternionObstruction.ExampleSixtyFour.quarterTurn)).target) =
    Data.Vector.Boolean.Basic.zero
      redundantRotationProfile.targetProfile.finiteSupport.length
  exact Data.Vector.Boolean.Basic.xor_self _

/-- The proportion product of the forward–inverse pair has zero square-class signature vector. -/
theorem inversePairWord_product_signature :
    Rational.Span.GeneratorProfiles.signatureVector
        redundantRotationProfile.targetProfile.finiteSupport
        (Rotations.Rational.Generators.Profile.RotationProfiles.proportionTarget
          (Rotations.Rational.Generators.Profile.RotationProfiles.signedWordProduct redundantRotationProfile
            inversePairWord)) =
      Data.Vector.Boolean.Basic.zero
        redundantRotationProfile.targetProfile.finiteSupport.length := by
  rw [Rotations.Rational.Generators.Profile.RotationProfiles.signedWordProduct_signature,
    inversePairWord_vector]

/-- The forward–inverse word is assigned an entry in the exact finite square-class image. -/
theorem inversePairWord_classified :
    ∃ entry ∈ redundantRotationProfile.targetProfile.span.entries,
      Rotations.Rational.Generators.Profile.RotationProfiles.signedWordVector redundantRotationProfile
          inversePairWord = entry.vector :=
  Rotations.Rational.Generators.Profile.RotationProfiles.classifySignedWord redundantRotationProfile
    inversePairWord

end GeneratorProfileExamples

end formalisations.RationalRotations.Chapters
