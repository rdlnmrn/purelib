import FTA.CCLBranchEventOwner
import FTA.CCLClearanceExclusion

/-!
# Finite assembly of CCL branch families

The bounded chart pipeline presents the positive-event and all-interior
parts of Theorem 10.2 as finite lists.  This module performs the first global
controller assembly step on those lists.

Every re-isolated algebraic event cell has an exact three-way owner
classification.  A structural traversal therefore returns the first unique
child owner or proves that every cell has the terminal `neither` table.  The
all-interior traversal similarly returns the first exact rational root or a
single proof-bearing `AllClear` family.  Both traversals are ordinary finite
recursion and introduce no persistence search or recursion-limit override.
-/

namespace FTA
namespace CCLBranchController

open CCL
open FTA.CCLBranchEvidence
open FTA.CCLBranchCells
open FTA.CCLBranchEvent
open FTA.CCLBranchEventOwner
open FTA.CCLBranchPlan
open FTA.CCLClearanceExclusion
open FTA.CCLFormulaPullback
open FTA.CCLGeometry
open FTA.RootTrackSeparation

abbrev QI := CCL.GaussianRat
abbrev GaussianPolynomial :=
  FTA.ComputablePolynomial.DensePolynomial QI

/-! ## Positive-event owner traversal -/

/-- The exact truth table associated with a selected raw bit. -/
def ownerPair : Bool → Bool × Bool
  | false => (true, false)
  | true => (false, true)

@[simp] theorem ownerPair_fst (bit : Bool) : (ownerPair bit).1 = !bit := by
  cases bit <;> rfl

@[simp] theorem ownerPair_snd (bit : Bool) : (ownerPair bit).2 = bit := by
  cases bit <;> rfl

/-- A finite event-owner family either contains a uniquely owned cell or
every member has the `neither` table.  The impossible two-owner table was
already removed algebraically in `CCLBranchEventOwner`. -/
inductive EventOwnerFamilyDecision
    {p : GaussianPolynomial} {box : RatBox} {state : RawParser.State} :
    (candidates : List (SourceInputEventCell p box state)) → Type where
  | owner {candidates : List (SourceInputEventCell p box state)}
      (candidate : SourceInputEventCell p box state)
      (member : candidate ∈ candidates) (bit : Bool)
      (checks : candidate.inputCell.ownerChecks = ownerPair bit) :
      EventOwnerFamilyDecision candidates
  | allNeither {candidates : List (SourceInputEventCell p box state)}
      (none : ∀ candidate ∈ candidates,
        candidate.inputCell.ownerChecks = (false, false)) :
      EventOwnerFamilyDecision candidates

/-- Select the first uniquely owned algebraic event cell, retaining an exact
all-`neither` certificate if no such member occurs. -/
def decideEventOwnerFamily
    {p : GaussianPolynomial} {box : RatBox} {state : RawParser.State} :
    (candidates : List (SourceInputEventCell p box state)) →
      EventOwnerFamilyDecision candidates
  | [] => .allNeither (by simp)
  | candidate :: candidates => by
      cases falseCheck : candidate.inputCell.ownerChecks.1 with
      | false =>
          cases trueCheck : candidate.inputCell.ownerChecks.2 with
          | false =>
              exact match decideEventOwnerFamily candidates with
              | .owner selected member bit checks =>
                  .owner selected (by simp [member]) bit checks
              | .allNeither allNone =>
                  .allNeither (by
                    intro selected member
                    rcases List.mem_cons.mp member with rfl | tailMember
                    · exact Prod.ext falseCheck trueCheck
                    · exact allNone selected tailMember)
          | true =>
              exact .owner candidate (by simp) true
                (Prod.ext falseCheck trueCheck)
      | true =>
          cases trueCheck : candidate.inputCell.ownerChecks.2 with
          | false =>
              exact .owner candidate (by simp) false
                (Prod.ext falseCheck trueCheck)
          | true =>
              exact (candidate.inputCell.ownerChecks_ne_both_algebraic
                (Prod.ext falseCheck trueCheck)).elim

/-- Concrete specialization to every source-labelled event-owner cell
generated by the denominator-separated parser branch family. -/
def decideSeparatedEventOwners
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} (state : RawParser.State)
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) :
    EventOwnerFamilyDecision (separatedInputEventCells p state output) :=
  decideEventOwnerFamily (separatedInputEventCells p state output)

/-- A selected separated owner cell together with its executable positive-
count or identically-zero source-curve decision. -/
structure SelectedEventCount
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) where
  candidate : SourceInputEventCell p output.state.box state
  member : candidate ∈ separatedInputEventCells p state output
  bit : Bool
  checks : candidate.inputCell.ownerChecks = ownerPair bit
  decision : CurveEventCountDecision p
    candidate.sourceEvent.partition.entry.chart.path output.state.box
    candidate.sourceEvent.event

theorem SelectedEventCount.falseCheck
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} (selected : SelectedEventCount output) :
    selected.candidate.inputCell.ownerChecks.1 = !selected.bit := by
  rw [selected.checks]
  exact ownerPair_fst selected.bit

theorem SelectedEventCount.trueCheck
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} (selected : SelectedEventCount output) :
    selected.candidate.inputCell.ownerChecks.2 = selected.bit := by
  rw [selected.checks]
  exact ownerPair_snd selected.bit

/-- The selected owner bit has its original parser-formula meaning at every
exact rational event zero retained by the final sign-refined cell. -/
theorem SelectedEventCount.selected_holds_at_rational_zero
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} (selected : SelectedEventCount output)
    {t : ℚ}
    (lower : (selected.candidate.inputCell.branch.computeEventSigns
      selected.candidate.inputCell.parent).refined.interval.lower ≤ t)
    (upper : t ≤ (selected.candidate.inputCell.branch.computeEventSigns
      selected.candidate.inputCell.parent).refined.interval.upper)
    (eventZero : selected.candidate.inputCell.branch.factor.polynomial.eval t = 0) :
    (inputAdvanceFormula state selected.bit).Holds
      (selected.candidate.sourceEvent.partition.entry.chart.path.value t) := by
  cases bitEq : selected.bit with
  | false =>
      have check : selected.candidate.inputCell.ownerChecks.1 = true := by
        simpa only [bitEq, Bool.not_false] using selected.falseCheck
      simpa only [bitEq] using
        (selected.candidate.inputCell.false_ownerCheck_iff
          lower upper eventZero).mp check
  | true =>
      have check : selected.candidate.inputCell.ownerChecks.2 = true := by
        simpa only [bitEq] using selected.trueCheck
      simpa only [bitEq] using
        (selected.candidate.inputCell.true_ownerCheck_iff
          lower upper eventZero).mp check

/-- The unselected owner bit fails at the same retained exact rational event
zero.  This records the complete semantic owner table, not only its positive
entry. -/
theorem SelectedEventCount.other_fails_at_rational_zero
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} (selected : SelectedEventCount output)
    {t : ℚ}
    (lower : (selected.candidate.inputCell.branch.computeEventSigns
      selected.candidate.inputCell.parent).refined.interval.lower ≤ t)
    (upper : t ≤ (selected.candidate.inputCell.branch.computeEventSigns
      selected.candidate.inputCell.parent).refined.interval.upper)
    (eventZero : selected.candidate.inputCell.branch.factor.polynomial.eval t = 0) :
    ¬(inputAdvanceFormula state (!selected.bit)).Holds
      (selected.candidate.sourceEvent.partition.entry.chart.path.value t) := by
  cases bitEq : selected.bit with
  | false =>
      have check : selected.candidate.inputCell.ownerChecks.2 = false := by
        simp only [selected.checks, bitEq, ownerPair]
      intro holds
      have contradiction :=
        (selected.candidate.inputCell.true_ownerCheck_iff
          lower upper eventZero).mpr (by
            simpa only [bitEq, Bool.not_false] using holds)
      rw [check] at contradiction
      contradiction
  | true =>
      have check : selected.candidate.inputCell.ownerChecks.1 = false := by
        simp only [selected.checks, bitEq, ownerPair]
      intro holds
      have contradiction :=
        (selected.candidate.inputCell.false_ownerCheck_iff
          lower upper eventZero).mpr (by
            simpa only [bitEq, Bool.not_true] using holds)
      rw [check] at contradiction
      contradiction

/-- A selected separated owner cell retains its executable positive-count or
identically-zero source-curve decision. -/
def EventOwnerFamilyDecision.selectedCountDecision
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)}
    (decision : EventOwnerFamilyDecision
      (separatedInputEventCells p state output)) :
    Option (SelectedEventCount output) :=
  match decision with
  | .owner candidate member bit checks =>
      some
        { candidate := candidate
          member := member
          bit := bit
          checks := checks
          decision := candidate.decideSourceCount member }
  | .allNeither _ => none

/-! ## Cell-local guarded-event owner traversal -/

/-- Owner classification for the relevant curve events extracted directly
from terminal guard cells. -/
inductive GuardEventOwnerFamilyDecision
    {p : GaussianPolynomial} {box : RatBox} {state : RawParser.State} :
    (candidates : List (SourceGuardInputEventCell p box state)) → Type where
  | owner {candidates : List (SourceGuardInputEventCell p box state)}
      (candidate : SourceGuardInputEventCell p box state)
      (member : candidate ∈ candidates) (bit : Bool)
      (checks : candidate.inputCell.ownerChecks = ownerPair bit) :
      GuardEventOwnerFamilyDecision candidates
  | allNeither {candidates : List (SourceGuardInputEventCell p box state)}
      (none : ∀ candidate ∈ candidates,
        candidate.inputCell.ownerChecks = (false, false)) :
      GuardEventOwnerFamilyDecision candidates

def decideGuardEventOwnerFamily
    {p : GaussianPolynomial} {box : RatBox} {state : RawParser.State} :
    (candidates : List (SourceGuardInputEventCell p box state)) →
      GuardEventOwnerFamilyDecision candidates
  | [] => .allNeither (by simp)
  | candidate :: candidates => by
      cases falseCheck : candidate.inputCell.ownerChecks.1 with
      | false =>
          cases trueCheck : candidate.inputCell.ownerChecks.2 with
          | false =>
              exact match decideGuardEventOwnerFamily candidates with
              | .owner selected member bit checks =>
                  .owner selected (by simp [member]) bit checks
              | .allNeither allNone =>
                  .allNeither (by
                    intro selected member
                    rcases List.mem_cons.mp member with rfl | tailMember
                    · exact Prod.ext falseCheck trueCheck
                    · exact allNone selected tailMember)
          | true =>
              exact .owner candidate (by simp) true
                (Prod.ext falseCheck trueCheck)
      | true =>
          cases trueCheck : candidate.inputCell.ownerChecks.2 with
          | false =>
              exact .owner candidate (by simp) false
                (Prod.ext falseCheck trueCheck)
          | true =>
              exact (candidate.inputCell.ownerChecks_ne_both_algebraic
                (Prod.ext falseCheck trueCheck)).elim

def decideSeparatedGuardEventOwners
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} (state : RawParser.State)
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) :
    GuardEventOwnerFamilyDecision
      (separatedGuardInputEventCells p state output) :=
  decideGuardEventOwnerFamily (separatedGuardInputEventCells p state output)

/-- A selected cell-local owner retains its exact guard provenance and its
ordinary identically-zero/positive curve-count decision. -/
structure SelectedGuardEventCount
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) where
  candidate : SourceGuardInputEventCell p output.state.box state
  member : candidate ∈ separatedGuardInputEventCells p state output
  bit : Bool
  checks : candidate.inputCell.ownerChecks = ownerPair bit
  decision : CurveEventCountDecision p
    candidate.sourceEvent.sourceCell.partition.entry.chart.path
    output.state.box candidate.sourceEvent.event

/-- Common downstream view of a selected global or cell-local parser-owner
cell. -/
inductive SelectedEventCandidate
    (p : GaussianPolynomial) (box : RatBox) (state : RawParser.State) where
  | global (candidate : SourceInputEventCell p box state)
  | guarded (candidate : SourceGuardInputEventCell p box state)

def SelectedEventCandidate.sourceEvent
    {p : GaussianPolynomial} {box : RatBox} {state : RawParser.State} :
    SelectedEventCandidate p box state → SourceRelevantCurveEvent p box
  | .global candidate => candidate.sourceEvent
  | .guarded candidate => candidate.sourceEvent.toSourceRelevant

def SelectedEventCandidate.inputCell
    {p : GaussianPolynomial} {box : RatBox} {state : RawParser.State}
    (candidate : SelectedEventCandidate p box state) :
    InputEventCell state candidate.sourceEvent.event := by
  cases candidate with
  | global candidate => exact candidate.inputCell
  | guarded candidate => exact candidate.inputCell

/-- Geometry-facing selected-event payload independent of which finite event
representation produced it. -/
structure SelectedEventPayload
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) where
  candidate : SelectedEventCandidate p output.state.box state
  bit : Bool
  checks : candidate.inputCell.ownerChecks = ownerPair bit
  decision : CurveEventCountDecision p
    candidate.sourceEvent.partition.entry.chart.path output.state.box
    candidate.sourceEvent.event
  sourceMember : candidate.sourceEvent.partition.entry.source ∈ inputPlan state

theorem SelectedEventPayload.falseCheck
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} (selected : SelectedEventPayload output) :
    selected.candidate.inputCell.ownerChecks.1 = !selected.bit := by
  rw [selected.checks]
  exact ownerPair_fst selected.bit

theorem SelectedEventPayload.trueCheck
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} (selected : SelectedEventPayload output) :
    selected.candidate.inputCell.ownerChecks.2 = selected.bit := by
  rw [selected.checks]
  exact ownerPair_snd selected.bit

def SelectedEventCount.toPayload
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)}
    (selected : SelectedEventCount output) : SelectedEventPayload output :=
  { candidate := .global selected.candidate
    bit := selected.bit
    checks := selected.checks
    decision := selected.decision
    sourceMember := selected.candidate.source_mem_inputPlan selected.member }

def SelectedGuardEventCount.toPayload
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)}
    (selected : SelectedGuardEventCount output) :
    SelectedEventPayload output :=
  { candidate := .guarded selected.candidate
    bit := selected.bit
    checks := selected.checks
    decision := selected.decision
    sourceMember := selected.candidate.source_mem_inputPlan selected.member }

instance
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} :
    Coe (SelectedEventCount output) (SelectedEventPayload output) :=
  ⟨SelectedEventCount.toPayload⟩

instance
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)} :
    Coe (SelectedGuardEventCount output) (SelectedEventPayload output) :=
  ⟨SelectedGuardEventCount.toPayload⟩

def GuardEventOwnerFamilyDecision.selectedCountDecision
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    {output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)}
    (decision : GuardEventOwnerFamilyDecision
      (separatedGuardInputEventCells p state output)) :
    Option (SelectedGuardEventCount output) :=
  match decision with
  | .owner candidate member bit checks =>
      some
        { candidate := candidate
          member := member
          bit := bit
          checks := checks
          decision := candidate.decideSourceCount }
  | .allNeither _ => none

/-- Combined owner result for both the original global isolation family and
the cell-local family that closes terminal guard-cell provenance. -/
inductive CombinedEventOwnerDecision
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} {state : RawParser.State}
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) where
  | globalOwner (selected : SelectedEventCount output)
  | guardOwner (selected : SelectedGuardEventCount output)
  | allNeither
      (globalNone : ∀ candidate ∈ separatedInputEventCells p state output,
        candidate.inputCell.ownerChecks = (false, false))
      (guardNone : ∀ candidate ∈
        separatedGuardInputEventCells p state output,
        candidate.inputCell.ownerChecks = (false, false))

/-- Traverse both finite event representations, preferring the established
global family and retaining exact all-neither certificates for both when no
owner exists. -/
def decideCombinedEventOwners
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} (state : RawParser.State)
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) :
    CombinedEventOwnerDecision output :=
  match decideSeparatedEventOwners state output with
  | .owner candidate member bit checks =>
      .globalOwner
        { candidate := candidate
          member := member
          bit := bit
          checks := checks
          decision := candidate.decideSourceCount member }
  | .allNeither globalNone =>
      match decideSeparatedGuardEventOwners state output with
      | .owner candidate member bit checks =>
          .guardOwner
            { candidate := candidate
              member := member
              bit := bit
              checks := checks
              decision := candidate.decideSourceCount }
      | .allNeither guardNone =>
          .allNeither globalNone guardNone

/-! ## All-interior clearance traversal -/

/-- Order-preserving provenance for an all-clear family.  Each output arc is
the arc constructed from the corresponding generated source cell; unlike a
bare length equality, this retains the path, form, and parameter interval
needed by the later boundary-coverage proof. -/
inductive ClearFamilyAlignment (p : GaussianPolynomial) (box : RatBox) :
    List (SourceRelevantClearCell p box) → List (BoundaryArc p) → Prop where
  | nil : ClearFamilyAlignment p box [] []
  | cons
      {candidate : SourceRelevantClearCell p box}
      {candidates : List (SourceRelevantClearCell p box)}
      {arcs : List (BoundaryArc p)}
      (head : ClearBoundaryArc p candidate)
      (tail : ClearFamilyAlignment p box candidates arcs) :
      ClearFamilyAlignment p box (candidate :: candidates) (head.arc :: arcs)

theorem ClearFamilyAlignment.length_eq
    {p : GaussianPolynomial} {box : RatBox}
    {candidates : List (SourceRelevantClearCell p box)}
    {arcs : List (BoundaryArc p)}
    (alignment : ClearFamilyAlignment p box candidates arcs) :
    arcs.length = candidates.length := by
  induction alignment with
  | nil => rfl
  | cons _ tail inductionHypothesis => simp [inductionHypothesis]

/-- Every generated source cell recovers the exact proof-bearing arc placed
at its aligned position in the output family. -/
theorem ClearFamilyAlignment.result_of_mem
    {p : GaussianPolynomial} {box : RatBox}
    {candidates : List (SourceRelevantClearCell p box)}
    {arcs : List (BoundaryArc p)}
    (alignment : ClearFamilyAlignment p box candidates arcs)
    {candidate : SourceRelevantClearCell p box}
    (member : candidate ∈ candidates) :
    ∃ result : ClearBoundaryArc p candidate, result.arc ∈ arcs := by
  induction alignment with
  | nil => simp at member
  | @cons headCandidate candidates arcs head tail inductionHypothesis =>
      rcases List.mem_cons.mp member with equality | tailMember
      · subst candidate
        exact ⟨head, by simp⟩
      · rcases inductionHypothesis tailMember with ⟨result, resultMember⟩
        exact ⟨result, by simp [resultMember]⟩

/-- Membership therefore retains the source form, chart path, and precise
stable parameter interval, not only list cardinality. -/
theorem ClearFamilyAlignment.source_arc_of_mem
    {p : GaussianPolynomial} {box : RatBox}
    {candidates : List (SourceRelevantClearCell p box)}
    {arcs : List (BoundaryArc p)}
    (alignment : ClearFamilyAlignment p box candidates arcs)
    {candidate : SourceRelevantClearCell p box}
    (member : candidate ∈ candidates) :
    ∃ arc ∈ arcs,
      arc.form = candidate.sourceCell.partition.entry.source.form ∧
      arc.path = candidate.sourceCell.partition.entry.chart.path ∧
      arc.interval = candidate.relevant.cell.interval := by
  rcases alignment.result_of_mem member with ⟨result, resultMember⟩
  exact ⟨result.arc, resultMember, result.form_eq, result.path_eq,
    result.interval_eq⟩

/-- Total result of traversing relevant all-interior cells.  A terminal
cleared path supplies an exact rational root; otherwise the output is one
aligned finite family carrying clearance evidence for every constructed arc. -/
inductive ClearFamilyDecision (p : GaussianPolynomial) (box : RatBox) :
    (candidates : List (SourceRelevantClearCell p box)) → Type where
  | terminal {candidates : List (SourceRelevantClearCell p box)}
      (candidate : SourceRelevantClearCell p box)
      (member : candidate ∈ candidates) (point : QI)
      (contains : box.Contains point) (root : p.eval point = 0) :
      ClearFamilyDecision p box candidates
  | allClear {candidates : List (SourceRelevantClearCell p box)}
      (arcs : List (BoundaryArc p)) (evidence : AllClear p arcs)
      (alignment : ClearFamilyAlignment p box candidates arcs) :
      ClearFamilyDecision p box candidates

private def decideSeparatedClearFamilyAux
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} (state : RawParser.State)
    (stateDeterminant : determinant state.matrix ≠ 0)
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) (ownerLabel : Bool) :
    (candidates : List (SourceRelevantClearCell p output.state.box)) →
    (subset : ∀ candidate ∈ candidates,
      candidate ∈ separatedRelevantClearCells p state output) →
      ClearFamilyDecision p output.state.box candidates
  | [], _ => .allClear [] .nil .nil
  | candidate :: candidates, subset =>
      match decideSeparatedRelevantClearCell state stateDeterminant output
          candidate (subset candidate (by simp)) ownerLabel with
      | .terminal point contains root =>
          .terminal candidate (by simp) point contains root
      | .clear result =>
          match decideSeparatedClearFamilyAux state stateDeterminant output
              ownerLabel candidates (by
                intro tail tailMember
                exact subset tail (by simp [tailMember])) with
          | .terminal terminal terminalMember point contains root =>
              .terminal terminal (by simp [terminalMember]) point contains root
          | .allClear arcs evidence alignment =>
              let head : ClearEvidence p result.arc :=
                { certificate := result.certificate }
              .allClear (result.arc :: arcs) (.cons head evidence)
                (.cons result alignment)

/-- Traverse all relevant all-interior cells of a separated parser state.
The owner label is inert in the all-clear branch and is retained only because
`BoundaryArc` records source metadata. -/
def decideSeparatedClearFamily
    {p : GaussianPolynomial} {ambient : RatBox}
    {current : WindingOneState p ambient} (state : RawParser.State)
    (stateDeterminant : determinant state.matrix ≠ 0)
    (output : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) (ownerLabel : Bool) :
    ClearFamilyDecision p output.state.box
      (separatedRelevantClearCells p state output) :=
  decideSeparatedClearFamilyAux state stateDeterminant output ownerLabel
    (separatedRelevantClearCells p state output) (by simp)

/-- The all-interior half of the controller after executing its quantitative
two-call clearance refinement.  A terminal cleared path bypasses refinement;
the other branch retains both the finite arc family and the exact refinement
budgets used by the sampler contradiction. -/
inductive ClearRefinementDecision
    (p : GaussianPolynomial) (ambient : RatBox)
    (current : WindingOneState p ambient) (state : RawParser.State)
    (separation : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) where
  | terminal (point : QI) (contains : separation.state.box.Contains point)
      (root : p.eval point = 0)
  | refined (arcs : List (BoundaryArc p)) (evidence : AllClear p arcs)
      (alignment : ClearFamilyAlignment p separation.state.box
        (separatedRelevantClearCells p state separation) arcs)
      (output : RefinementOutput p ambient separation.state evidence)

/-- Compose finite all-interior traversal with the explicit clearance
refinement from Theorem 10.2's zero-count case. -/
def refineSeparatedClearFamily
    {p : GaussianPolynomial} {ambient : RatBox}
    (track : WindingOneTrack p ambient)
    (current : WindingOneState p ambient) (state : RawParser.State)
    (stateDeterminant : determinant state.matrix ≠ 0)
    (separation : CCLDenominator.SeparationOutput p ambient current
      (adjugate state.matrix)) (ownerLabel : Bool) :
    ClearRefinementDecision p ambient current state separation :=
  match decideSeparatedClearFamily state stateDeterminant separation
      ownerLabel with
  | .terminal _candidate _member point contains root =>
      .terminal point contains root
  | .allClear arcs evidence alignment =>
      .refined arcs evidence alignment
        (refineForClearance track separation.state evidence)

/-! ## Denominator and branch-family composition -/

/-- Total finite opening analysis for one parser state.  It composes the
rational pole decision with both bounded branch-family traversals.  The
`noEventOwner` constructor makes the remaining controller obligation
explicit: interpret the all-`neither` algebraic-event certificate together
with the refined clear family as a terminal or strict-cell next-bit result. -/
inductive BranchFamilyDecision
    (p : GaussianPolynomial) (ambient : RatBox)
    (current : WindingOneState p ambient) (state : RawParser.State) where
  | terminalPole (point : QI) (root : p.eval point = 0)
      (contains : current.box.Contains point)
      (strict : current.box.StrictContains point)
      (denominatorZero :
        (adjugate state.matrix).c * point +
          (adjugate state.matrix).d = 0)
  | eventOwner
      (separation : CCLDenominator.SeparationOutput p ambient current
        (adjugate state.matrix))
      (selected : SelectedEventCount separation)
  | guardEventOwner
      (separation : CCLDenominator.SeparationOutput p ambient current
        (adjugate state.matrix))
      (selected : SelectedGuardEventCount separation)
  | noEventOwner
      (separation : CCLDenominator.SeparationOutput p ambient current
        (adjugate state.matrix))
      (none : ∀ candidate ∈ separatedInputEventCells p state separation,
        candidate.inputCell.ownerChecks = (false, false))
      (guardNone : ∀ candidate ∈
        separatedGuardInputEventCells p state separation,
        candidate.inputCell.ownerChecks = (false, false))
      (clear : ClearRefinementDecision p ambient current state separation)

/-- Execute the denominator decision, select the first algebraic event owner
when present, and otherwise run the complete all-interior clearance
refinement. -/
def analyzeBranchFamilies
    {p : GaussianPolynomial} {ambient : RatBox}
    (track : WindingOneTrack p ambient)
    (current : WindingOneState p ambient) (state : RawParser.State)
    (stateDeterminant : determinant state.matrix ≠ 0)
    (clearOwnerLabel : Bool) :
    BranchFamilyDecision p ambient current state :=
  match CCLDenominator.decide track current (adjugate state.matrix)
      (CCLBranchEvidence.adjugate_lowerRow_ne state.matrix
        stateDeterminant) with
  | .terminal point root contains strict denominatorZero =>
      .terminalPole point root contains strict denominatorZero
  | .separated separation =>
      match decideCombinedEventOwners state separation with
      | .globalOwner selected =>
          .eventOwner separation selected
      | .guardOwner selected =>
          .guardEventOwner separation selected
      | .allNeither allNone guardNone =>
          .noEventOwner separation allNone guardNone
            (refineSeparatedClearFamily track current state stateDeterminant
              separation clearOwnerLabel)

end CCLBranchController
end FTA
