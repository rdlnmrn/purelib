module

public import Purelib.Algebra.Ring.Basic
import Purelib.Algebra.Group.Negation
-- Exposed scalar numerals retain their natural successor certificates.
public import Purelib.Data.Nat.Order
import Purelib.Tactic.Ring
meta import Purelib.Elab.ConstructiveInjectivity

/-!
# A finite quadratic pair ring

`Pair K b` is the two-coordinate commutative ring generated by an
element `j` with `j² = -b`.  It is an executable finite algebraic
construction: no roots, quotient ring, basis choice, or carrier enumeration
is used.
-/

namespace Purelib.Algebra.Quadratic

-- The retained nominal type and operation namespace both carry the original Pair name.

open scoped Purelib.Data.Nat

open Purelib.Algebra.Group in
attribute [local instance high] Negation.subNegZeroMonoid

public section

@[expose] public section

set_option genInjectivity false in
/-- Two coordinates for a formal quadratic extension with a retained scalar parameter.

The first coordinate multiplies the unit and the second multiplies a generator whose square is minus the parameter; the
record stores the coordinates directly. -/
@[ext]
structure Pair (K : Type*) (radialSquare : K) where
  /-- The coefficient of the unit basis element. -/ re : K
  /-- The coefficient of the formal quadratic generator. -/ im : K
deriving DecidableEq

constructive_injectivity Pair

namespace Pair

end Pair
end

namespace Pair

variable {K : Type*} {radialSquare : K}

/-- The zero quadratic pair has both coordinates zero. -/
instance [Zero K] : Zero (Pair K radialSquare) :=
  ⟨⟨0, 0⟩⟩

/-- The unit quadratic pair has first coordinate one and second coordinate zero. -/
instance [Zero K] [One K] : One (Pair K radialSquare) :=
  ⟨⟨1, 0⟩⟩

/-- Add quadratic pairs coordinate by coordinate. -/
instance [Add K] : Add (Pair K radialSquare) :=
  ⟨fun left right => ⟨left.re + right.re, left.im + right.im⟩⟩

/-- Negate quadratic pairs coordinate by coordinate. -/
instance [Neg K] : Neg (Pair K radialSquare) :=
  ⟨fun value => ⟨-value.re, -value.im⟩⟩

/-- Multiply two quadratic pairs using the supplied square parameter.

The first coordinate subtracts the parameter times the imaginary-coordinate product; the second coordinate is the sum of
the cross products. -/
@[expose] def multiply [CommRing K] (left right : Pair K radialSquare) : Pair K radialSquare :=
  ⟨left.re * right.re - radialSquare * left.im * right.im,
    left.re * right.im + left.im * right.re⟩

/-- Use the displayed quadratic multiplication as the pair multiplication operation. -/
instance [CommRing K] : Mul (Pair K radialSquare) := ⟨multiply⟩

/-- Conjugate a quadratic pair by negating its imaginary coordinate. -/
@[expose] def conjugate [Neg K] (value : Pair K radialSquare) : Pair K radialSquare :=
  ⟨value.re, -value.im⟩

/-- Multiply both coordinates of a quadratic pair by the supplied scalar. -/
@[expose] def scale [Mul K] (factor : K) (value : Pair K radialSquare) : Pair K radialSquare :=
  ⟨factor * value.re, factor * value.im⟩

/-- Compute the sum of the two coordinate squares for parameter one. -/
@[expose] def quadrance [CommRing K] (value : Pair K (1 : K)) : K :=
  value.re ^ 2 + value.im ^ 2

/-- Quadrance preserves multiplication of pairs with parameter one.

The identity holds over any commutative base ring. -/
theorem quadrance_mul [CommRing K] (left right : Pair K (1 : K)) :
    (multiply left right).quadrance = left.quadrance * right.quadrance := by
  unfold multiply quadrance
  ring1

/-- Conjugation leaves the quadrance of a parameter-one pair unchanged.

Negating the imaginary coordinate leaves its square unchanged, so the sum of the two coordinate squares is preserved. -/
theorem quadrance_conjugate [CommRing K] (pair : Pair K (1 : K)) :
    pair.conjugate.quadrance = pair.quadrance := by
  unfold conjugate quadrance
  ring1

/-- A parameter-one pair times its conjugate is the scalar pair of its quadrance.

The real coordinate is the sum of the two coordinate squares, and the imaginary coordinate vanishes. The equality
retains the supplied pair and its conjugate. -/
theorem mul_conjugate [CommRing K] (pair : Pair K (1 : K)) :
    multiply pair pair.conjugate = ⟨pair.quadrance, 0⟩ := by
  apply Pair.ext <;> unfold multiply conjugate quadrance <;> ring1

/-- Scaling a parameter-one pair multiplies its quadrance by the scalar square.

Both coordinates receive the same scalar factor. Their squared contributions therefore share the square of that factor.
-/
theorem quadrance_scale [CommRing K] (factor : K) (pair : Pair K (1 : K)) :
    (scale factor pair).quadrance = factor ^ 2 * pair.quadrance := by
  unfold scale quadrance
  ring1

/-- Read the real coordinate of the zero pair. -/
@[simp] theorem zero_re [Zero K] :
    (0 : Pair K radialSquare).re = 0 := rfl

/-- Read the imaginary coordinate of the zero pair. -/
@[simp] theorem zero_im [Zero K] :
    (0 : Pair K radialSquare).im = 0 := rfl

/-- Read the real coordinate of the unit pair. -/
@[simp] theorem one_re [Zero K] [One K] :
    (1 : Pair K radialSquare).re = 1 := rfl

/-- Read the imaginary coordinate of the unit pair. -/
@[simp] theorem one_im [Zero K] [One K] :
    (1 : Pair K radialSquare).im = 0 := rfl

/-- Read the real coordinate of the sum of two pairs. -/
@[simp] theorem add_re [Add K] (left right : Pair K radialSquare) :
    (left + right).re = left.re + right.re := rfl

/-- Read the imaginary coordinate of the sum of two pairs. -/
@[simp] theorem add_im [Add K] (left right : Pair K radialSquare) :
    (left + right).im = left.im + right.im := rfl

/-- Read the real coordinate of the negative pair. -/
@[simp] theorem neg_re [Neg K] (value : Pair K radialSquare) :
    (-value).re = -value.re := rfl

/-- Read the imaginary coordinate of the negative pair. -/
@[simp] theorem neg_im [Neg K] (value : Pair K radialSquare) :
    (-value).im = -value.im := rfl

/-- Read the real coordinate of the product of two pairs. -/
@[simp] theorem mul_re [CommRing K]
    (left right : Pair K radialSquare) :
    (left * right).re =
      left.re * right.re - radialSquare * left.im * right.im := rfl

/-- Read the imaginary coordinate of the product of two pairs. -/
@[simp] theorem mul_im [CommRing K]
    (left right : Pair K radialSquare) :
    (left * right).im = left.re * right.im + left.im * right.re := rfl

/-- Coordinatewise quadratic-pair addition is associative.

Associativity in the scalar ring identifies each of the two coordinates of the displayed sums. -/
private theorem add_assoc [CommRing K]
    (first second third : Pair K radialSquare) :
    first + second + third = first + (second + third) := by
  ext <;> simp only [add_re, add_im] <;> ring1

/-- The zero quadratic pair is a left additive identity. -/
private theorem zero_add [CommRing K]
    (value : Pair K radialSquare) : 0 + value = value := by
  ext <;> simp only [add_re, add_im, zero_re, zero_im] <;> ring1

/-- A quadratic pair and its coordinatewise negative sum to zero.

The real and imaginary coordinates each cancel with their negatives, yielding the displayed zero pair. -/
private theorem neg_add_cancel [CommRing K]
    (value : Pair K radialSquare) : -value + value = 0 := by
  ext <;> simp only [neg_re, neg_im, add_re, add_im, zero_re, zero_im] <;>
    ring1

/-- Quadratic-pair multiplication is associative.

The scalar square parameter is shared by all three pairs over the commutative base ring. -/
private theorem mul_assoc [CommRing K]
    (first second third : Pair K radialSquare) :
    first * second * third = first * (second * third) := by
  ext <;> simp only [mul_re, mul_im] <;> ring1

/-- Quadratic-pair multiplication is commutative over a commutative base ring.

The two real product terms and the two imaginary product terms agree after commuting scalar multiplication. The square
parameter is unchanged. -/
private theorem mul_comm [CommRing K]
    (left right : Pair K radialSquare) : left * right = right * left := by
  ext <;> simp only [mul_re, mul_im] <;> ring1

/-- The unit quadratic pair is a left multiplicative identity. -/
private theorem one_mul [CommRing K]
    (value : Pair K radialSquare) : 1 * value = value := by
  ext <;> simp only [mul_re, mul_im, one_re, one_im] <;> ring1

/-- Quadratic-pair multiplication distributes over addition in its right input.

The scalar distributive laws identify both coordinates of the product with the sum of the corresponding product
coordinates. -/
private theorem left_distrib [CommRing K]
    (first second third : Pair K radialSquare) :
    first * (second + third) = first * second + first * third := by
  ext <;> simp only [mul_re, mul_im, add_re, add_im] <;> ring1

/-- Assemble the commutative-ring structure of the displayed quadratic pairs.

The structure retains the coordinatewise additive operations and the
multiplication determined by the fixed square parameter. Subtraction is
addition followed by coordinate negation; scalar multiples, powers and casts
use the standard recursive operations. -/
instance instCommRing [CommRing K] : CommRing (Pair K radialSquare) :=
  open Purelib.Algebra.Ring in commRingOfAxioms (by exact Pair.add_assoc) (by exact Pair.zero_add)
    (by exact neg_add_cancel) (by exact mul_assoc) (by exact mul_comm)
    (by exact one_mul) (by exact left_distrib)
    (fun left right => left + -right) (fun _ _ => rfl)

/-- Read the real coordinate of the difference of two pairs. -/
@[simp] theorem sub_re [CommRing K]
    (left right : Pair K radialSquare) :
    (left - right).re = left.re - right.re := by
  change (left + -right).re = left.re - right.re
  rw [add_re, neg_re, sub_eq_add_neg]

/-- Read the imaginary coordinate of the difference of two pairs. -/
@[simp] theorem sub_im [CommRing K]
    (left right : Pair K radialSquare) :
    (left - right).im = left.im - right.im := by
  change (left + -right).im = left.im - right.im
  rw [add_im, neg_im, sub_eq_add_neg]

/-- Embed a base scalar as a quadratic pair with imaginary coordinate zero. -/
@[expose] def scalar [Zero K] (value : K) : Pair K radialSquare := ⟨value, 0⟩

/-- The quadratic generator is the pair with coordinates zero and one. -/
@[expose] def generator [Zero K] [One K] : Pair K radialSquare := ⟨0, 1⟩

/-- Read the real coordinate of the scalar embedding. -/
@[simp] theorem scalar_re [Zero K] (value : K) :
    (scalar (radialSquare := radialSquare) value).re = value := rfl

/-- Read the imaginary coordinate of the scalar embedding. -/
@[simp] theorem scalar_im [Zero K] (value : K) :
    (scalar (radialSquare := radialSquare) value).im = 0 := rfl

/-- Read the real coordinate of the quadratic generator. -/
@[simp] theorem generator_re [Zero K] [One K] :
    (generator (K := K) (radialSquare := radialSquare)).re = 0 := rfl

/-- Read the imaginary coordinate of the quadratic generator. -/
@[simp] theorem generator_im [Zero K] [One K] :
    (generator (K := K) (radialSquare := radialSquare)).im = 1 := rfl

/-- The scalar embedding takes zero to the zero quadratic pair. -/
@[simp] theorem scalar_zero [CommRing K] :
    scalar (radialSquare := radialSquare) (0 : K) = 0 := by
  ext <;> rfl

/-- The scalar embedding takes one to the unit quadratic pair. -/
@[simp] theorem scalar_one [CommRing K] :
    scalar (radialSquare := radialSquare) (1 : K) = 1 := by
  ext <;> rfl

/-- The scalar embedding preserves addition.

Its real coordinate is the supplied scalar sum, while its imaginary coordinate
remains zero by the original additive zero law. -/
@[simp] theorem scalar_add [CommRing K] (left right : K) :
    scalar (radialSquare := radialSquare) (left + right) =
      scalar left + scalar right := by
  apply Pair.ext
  · rfl
  · change (0 : K) = 0 + 0
    exact (_root_.add_zero (0 : K)).symm

/-- The scalar embedding preserves negation.

Coordinate negation preserves the retained zero imaginary coordinate and
negates the original real scalar. -/
@[simp] theorem scalar_neg [CommRing K] (value : K) :
    scalar (radialSquare := radialSquare) (-value) = -scalar value := by
  apply Pair.ext
  · rfl
  · change (0 : K) = -0
    exact (_root_.neg_zero : -(0 : K) = 0).symm

/-- The scalar embedding preserves subtraction.

Both subtraction operations use addition followed by negation, and the
embedding preserves those two displayed operations. -/
@[simp] theorem scalar_sub [CommRing K] (left right : K) :
    scalar (radialSquare := radialSquare) (left - right) =
      scalar left - scalar right := by
  calc
    scalar (radialSquare := radialSquare) (left - right) =
        scalar (left + -right) := congrArg scalar (sub_eq_add_neg left right)
    _ = scalar left + scalar (-right) := scalar_add left (-right)
    _ = scalar left + -scalar right :=
      congrArg (fun value => scalar left + value) (scalar_neg right)
    _ = scalar left - scalar right := (sub_eq_add_neg _ _).symm

/-- The scalar embedding preserves multiplication.

Both embedded inputs have imaginary coordinate zero. Their product has the product of the base scalars as real
coordinate and zero as imaginary coordinate. -/
@[simp] theorem scalar_mul [CommRing K] (left right : K) :
    scalar (radialSquare := radialSquare) (left * right) =
      scalar left * scalar right := by
  ext <;> simp only [scalar_re, scalar_im, mul_re, mul_im] <;> ring1

/-- The scalar embedding preserves every natural power.

Both sides use the same fixed quadratic parameter. -/
@[simp] theorem scalar_pow [CommRing K] (value : K) :
    ∀ exponent : Nat,
      scalar (radialSquare := radialSquare) (value ^ exponent) =
        scalar value ^ exponent
  | 0 => by rw [pow_zero, pow_zero, scalar_one]
  | exponent + 1 => by
      rw [pow_succ, pow_succ, scalar_mul, scalar_pow value exponent]

/-- A natural cast into quadratic pairs is the scalar embedding of the base cast.

The recursive natural cast uses the retained pair ring structure. Induction on the natural number identifies its two
coordinates with the scalar embedding. -/
@[simp] theorem natCast_eq_scalar [CommRing K] (value : Nat) :
    (value : Pair K radialSquare) =
      scalar (radialSquare := radialSquare) (value : K) := by
  induction value with
  | zero => rw [Nat.cast_zero, Nat.cast_zero, scalar_zero]
  | succ value inductionHypothesis =>
      rw [Nat.cast_succ, Nat.cast_succ, inductionHypothesis, ← scalar_one,
        ← scalar_add]

/-- The quadratic-pair numeral two is the scalar embedding of two. -/
@[simp] theorem two_eq_scalar [CommRing K] :
    (2 : Pair K radialSquare) =
      scalar (radialSquare := radialSquare) (2 : K) := by
  exact natCast_eq_scalar 2

/-- The quadratic-pair numeral four is the scalar embedding of four. -/
@[simp] theorem four_eq_scalar [CommRing K] :
    (4 : Pair K radialSquare) =
      scalar (radialSquare := radialSquare) (4 : K) := by
  exact natCast_eq_scalar 4

/-- The generator square is the scalar embedding of the negative square parameter.

Multiplication of the pair with coordinates zero and one gives real coordinate equal to the negative parameter and
imaginary coordinate zero. -/
@[simp] theorem generator_square [CommRing K] :
    generator (K := K) (radialSquare := radialSquare) ^ 2 =
      scalar (-radialSquare) := by
  ext <;> simp only [pow_two, mul_re, mul_im, generator_re, generator_im,
    scalar_re, scalar_im] <;> ring1

/-- Every even generator power is a scalar power of the negative square parameter.

The exponent is twice the supplied natural index. -/
@[simp] theorem generator_even_power [CommRing K] (index : Nat) :
    generator (K := K) (radialSquare := radialSquare) ^ (index + index) =
      scalar ((-radialSquare) ^ index) := by
  calc
    generator (K := K) (radialSquare := radialSquare) ^ (index + index) =
        generator ^ (2 * index) := by
          have twice : 2 * index = index + index :=
            (Nat.succ_mul 1 index).trans
              (congrArg (fun value => value + index) (Nat.one_mul index))
          exact congrArg (fun exponent =>
            generator (K := K) (radialSquare := radialSquare) ^ exponent) twice.symm
    _ = (generator (K := K) (radialSquare := radialSquare) ^ 2) ^ index := by
      rw [pow_mul]
    _ = scalar (radialSquare := radialSquare) (-radialSquare) ^ index := by
      rw [generator_square]
    _ = scalar ((-radialSquare) ^ index) := by rw [scalar_pow]

end Pair

end

end Purelib.Algebra.Quadratic
