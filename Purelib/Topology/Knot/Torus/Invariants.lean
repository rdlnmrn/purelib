module
meta import Purelib.Elab.ConstructiveInjectivity
import Purelib.Data.Nat.GCD.Extended
public import Purelib.Topology.Knot.Torus.Alexander
import Purelib.Topology.Knot.Torus.Basic
import Purelib.Topology.Knot.Torus.Knot
public import Purelib.Topology.Knot.Torus.Surface
import Purelib.Topology.Knot.Closure.Basic

open Purelib.Data.Nat.GCD

open Purelib.Topology.Knot

open Purelib.Topology.Knot.Torus

section
@[expose] public section

/-!
# Executable torus-knot genus and Alexander data

This file supplies finite integer-polynomial and positive-braid surface
certificates for the torus family.  Polynomial coefficients are stored in
low-to-high order.  Equality is coefficientwise over one explicit finite
bound, so concrete certificates reduce by kernel computation.

The Alexander candidate uses the numerical semigroup generated by `p` and
`q`: below the conductor `(p-1)(q-1)`, its coefficient at `n` is the change
in the semigroup-membership indicator from `n-1` to `n`.  A certificate checks
the familiar exact identity

`Delta(t) (1-t^p) (1-t^q) = (1-t^(pq)) (1-t)`.

No completed Laurent series or quotient field is constructed.
-/

namespace Purelib.Topology.Knot.Torus.Invariants

/-! ## Finite integer polynomials -/

set_option genInjectivity false in
/-- A complete finite invariant package for one coprime torus example. -/
structure TorusKnotInvariantCertificate (singularity :
  Torus.Basic.PowerSingularity) where
  /-- The executable Euclidean gcd of the positive exponents equals one. -/ gcdOne : (Extended.compute singularity.p
    singularity.q).gcd = 1
  /-- The retained canonical positive-braid surface certificate. -/ surface : Surface.CanonicalSurfaceCertificate
    singularity
  /-- The retained normalized Alexander coefficient certificate. -/ alexander : Alexander.AlexanderCertificate
    singularity.p singularity.q
  /-- The conductor degree equals twice the certified surface genus. -/ alexanderDegree_eq_twiceGenus :
    Torus.Basic.conductor singularity.p singularity.q = 2 * surface.genus

constructive_injectivity TorusKnotInvariantCertificate

open Purelib.Topology.Knot.Torus in
/-- A torus invariant certificate proves that the retained closure has one permutation cycle. -/
theorem TorusKnotInvariantCertificate.isKnot
    {singularity : Torus.Basic.PowerSingularity}
    (certificate : TorusKnotInvariantCertificate singularity) :
    singularity.closure.IsKnot :=
  Torus.PowerSingularity.closure_isKnot_of_gcdOne
    singularity certificate.gcdOne

end Purelib.Topology.Knot.Torus.Invariants

end
