module

public import Purelib.Data.Nat.Positive
public import Purelib.Topology.Knot.Torus.Basic
meta import Purelib.Elab.ConstructiveInjectivity

open Purelib.Data.Nat

open Purelib.Topology.Knot

section
@[expose] public section

/-!
# Executable torus-knot genus and Alexander data

This file supplies finite integer-polynomial and positive-braid surface
certificates for the torus family.  Polynomial coefficients are stored in
low-to-high order.  Equality is coefficientwise over one explicit finite
bound, so concrete certificates reduce by kernel computation.

The Alexander candidate uses the numerical semigroup generated by `p` and
`q`: below the conductor `(p-1)(q-1)`, its coefficient at `n` is the change
in the semigroup-membership indicator from `n-1` to `n`.  A certificate checks
the familiar exact identity

`Delta(t) (1-t^p) (1-t^q) = (1-t^(pq)) (1-t)`.

No completed Laurent series or quotient field is constructed.
-/

namespace Purelib.Topology.Knot.Torus.Surface

/-! ## Finite integer polynomials -/

/-! ## Canonical positive-braid surface -/

/-- Familiar torus-knot genus candidate. -/
def TorusInvariants.canonicalGenus (p q : Nat) : Nat := Torus.Basic.conductor
  p q / 2

open Purelib.Topology.Knot.Torus.Surface in
set_option genInjectivity false in
/-- Finite cell-count certificate for the canonical positive-braid Seifert surface. It has `p` disks, `q(p-1)` bands,
and one boundary component. The Euler equation is stored without natural-number subtraction. -/
structure CanonicalSurfaceCertificate (singularity :
  Torus.Basic.PowerSingularity) where
  /-- The retained natural genus value. -/ genus : Nat
  /-- The retained genus equals the conductor divided by two. -/ genus_eq : genus = TorusInvariants.canonicalGenus
    singularity.p singularity.q
  /-- The retained number of disks. -/ diskCount : Nat
  /-- The disk count equals the positive strand exponent. -/ diskCount_eq : diskCount = singularity.p
  /-- The retained number of positive bands. -/ bandCount : Nat
  /-- The band count equals q times (p minus one). -/ bandCount_eq : bandCount = singularity.q * (singularity.p - 1)
  /-- The retained number of boundary components. -/ boundaryCount : Nat
  /-- The retained surface has one boundary component. -/ boundaryCount_eq : boundaryCount = 1
  /-- The cell counts and genus satisfy the subtraction-free Euler equation. -/ eulerIdentity :
    2 * genus + diskCount + boundaryCount = 2 + bandCount

constructive_injectivity CanonicalSurfaceCertificate

open Purelib.Topology.Knot.Torus in
open Purelib.Topology.Knot.Torus.Surface in
/-- Package the canonical cell counts using a supplied Euler identity.

The certificate retains genus conductor divided by two, p disks, q times (p minus one) bands, and one boundary
component. -/
def canonicalSurfaceCertificate (singularity : Torus.Basic.PowerSingularity)
    (eulerIdentity :
      2 * TorusInvariants.canonicalGenus singularity.p singularity.q + singularity.p + 1 =
        2 + singularity.q * (singularity.p - 1)) :
    CanonicalSurfaceCertificate singularity where
  genus := TorusInvariants.canonicalGenus singularity.p singularity.q
  genus_eq := rfl
  diskCount := singularity.p
  diskCount_eq := rfl
  bandCount := singularity.q * (singularity.p - 1)
  bandCount_eq := rfl
  boundaryCount := 1
  boundaryCount_eq := rfl
  eulerIdentity := eulerIdentity
end Purelib.Topology.Knot.Torus.Surface

end

section
@[expose] public section

/-!
# The explicit power-polynomial loop has torus-band monodromy

For every displayed degree `p >= 2`, `PowerMonodromy` supplies an explicit
rational coefficient circuit for `Z^p-w`, all of its finite Rouché chamber
steps, and a proof that the resulting owner permutation is one `p`-cycle.
Inverse-orbit labelling identifies that cycle with the cyclic predecessor,
which is exactly the endpoint permutation of the positive Artin band
`sigma_1 ... sigma_(p-1)`.

Repeating the rational circuit `q` times therefore produces the precise word
`(sigma_1 ... sigma_(p-1))^q` in the displayed labelling.  The extracted
closure is definitionally the finite torus-link model after the word theorem,
so the component, knot, surface, and Alexander interfaces apply directly.
-/

namespace Purelib.Topology.Knot.Torus.Surface.PowerTorusBridge

open Purelib.Topology.Knot.Torus.Surface in
/-- The familiar genus value attached to the explicit coprime polynomial closure's canonical positive-braid surface. -/
def canonicalGenus (degree : Positive.RootDegree) (q : Nat)
  : Nat :=
  TorusInvariants.canonicalGenus degree.value q
end Purelib.Topology.Knot.Torus.Surface.PowerTorusBridge

end
