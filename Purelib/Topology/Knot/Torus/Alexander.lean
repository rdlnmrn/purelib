@[expose] public section

/-!
# Executable torus-knot genus and Alexander data

This file supplies finite integer-polynomial and positive-braid surface
certificates for the torus family.  Polynomial coefficients are stored in
low-to-high order.  Equality is coefficientwise over one explicit finite
bound, so concrete certificates reduce by kernel computation.

The Alexander candidate uses the numerical semigroup generated by `p` and
`q`: below the conductor `(p-1)(q-1)`, its coefficient at `n` is the change
in the semigroup-membership indicator from `n-1` to `n`.  A certificate checks
the familiar exact identity

`Delta(t) (1-t^p) (1-t^q) = (1-t^(pq)) (1-t)`.

No completed Laurent series or quotient field is constructed.
-/

namespace Purelib.Topology.Knot.Torus.Alexander

/-! ## Finite integer polynomials -/

/-- Take the finite difference of the two-generator semigroup membership indicator.

At degree zero the coefficient is the indicator itself; at positive degrees subtract the preceding indicator. -/
def alexanderCoefficient (p q degree : Nat) : Int :=
  if degree = 0 then TwoGenerator.semigroupIndicator p q 0
  else TwoGenerator.semigroupIndicator p q degree - TwoGenerator.semigroupIndicator p q (degree - 1)

open Purelib.Topology.Knot.Torus in
/-- Normalized low-to-high Alexander candidate through the conductor. -/
def TorusInvariants.alexanderPolynomial (p q : Nat) :
  Polynomial.Ascending.Integer.Basic.CoefficientList :=
  List.ofFn fun degree : Fin (Torus.Basic.conductor p q + 1) =>
    alexanderCoefficient p q degree.val

open Purelib.Topology.Knot.Torus.Alexander in
/-- The semigroup Alexander candidate has conductor plus one stored coefficients. -/
@[simp] theorem alexanderPolynomial_length (p q : Nat) :
    (TorusInvariants.alexanderPolynomial p q).length = Torus.Basic.conductor p q + 1 := by
  rw [TorusInvariants.alexanderPolynomial]
  exact OfFn.Basic.length_ofFn

/-- The finite integer polynomial (1 - t^p)(1 - t^q). -/
def alexanderDenominator (p q : Nat) :
  Polynomial.Ascending.Integer.Basic.CoefficientList :=
  TorusInvariants.mul (Products.oneSubPower p)
    (Products.oneSubPower q)

/-- The finite integer polynomial (1 - t^(p q))(1 - t). -/
def alexanderNumerator (p q : Nat) :
  Polynomial.Ascending.Integer.Basic.CoefficientList :=
  TorusInvariants.mul (Products.oneSubPower (p * q))
    (Products.oneSubPower 1)

set_option genInjectivity false in
open Purelib.Topology.Knot.Torus in
/-- Exact finite validation of a normalized torus Alexander polynomial. -/
structure AlexanderCertificate (p q : Nat) where
  /-- The retained integer coefficient list, in increasing degree order. -/ polynomial :
    Polynomial.Ascending.Integer.Basic.CoefficientList
  /-- The stored coefficient list has conductor plus one entries. -/ expectedLength : polynomial.length =
    Torus.Basic.conductor p q + 1
  /-- The constant coefficient is one. -/ constantOne : Integer.Basic.coefficient polynomial 0 = 1
  /-- The coefficient at the conductor degree is one. -/ leadingOne : Integer.Basic.coefficient polynomial
    (Torus.Basic.conductor p q) = 1
  /-- The coefficient list agrees with its reversal. -/ symmetric : Comparison.Symmetric polynomial
  /-- Multiplying the polynomial by the displayed denominator gives the displayed numerator coefficientwise. -/
    quotientIdentity : Comparison.Same
    (TorusInvariants.mul polynomial (alexanderDenominator p q))
    (alexanderNumerator p q)

constructive_injectivity AlexanderCertificate

open Purelib.Topology.Knot.Torus in
open Purelib.Topology.Knot.Torus.Alexander in
/-- Package the semigroup coefficient list with its finite normalization and product equations.

The supplied constant, leading, symmetry and quotient proofs certify the computed candidate; its length equation is
retained automatically. -/
def alexanderCertificate (p q : Nat)
    (constantOne : Integer.Basic.coefficient (TorusInvariants.alexanderPolynomial p q) 0 = 1)
    (leadingOne : Integer.Basic.coefficient (TorusInvariants.alexanderPolynomial p q)
      (Torus.Basic.conductor p q) = 1)
    (symmetric : Comparison.Symmetric (TorusInvariants.alexanderPolynomial p q))
    (identity : Comparison.Same
      (TorusInvariants.mul (TorusInvariants.alexanderPolynomial p q)
        (alexanderDenominator p q))
      (alexanderNumerator p q)) : AlexanderCertificate p q where
  polynomial := TorusInvariants.alexanderPolynomial p q
  expectedLength := alexanderPolynomial_length p q
  constantOne := constantOne
  leadingOne := leadingOne
  symmetric := symmetric
  quotientIdentity := identity
end Purelib.Topology.Knot.Torus.Alexander

end

section
@[expose] public section

/-!
# The explicit power-polynomial loop has torus-band monodromy

For every displayed degree `p >= 2`, `PowerMonodromy` supplies an explicit
rational coefficient circuit for `Z^p-w`, all of its finite Rouché chamber
steps, and a proof that the resulting owner permutation is one `p`-cycle.
Inverse-orbit labelling identifies that cycle with the cyclic predecessor,
which is exactly the endpoint permutation of the positive Artin band
`sigma_1 ... sigma_(p-1)`.

Repeating the rational circuit `q` times therefore produces the precise word
`(sigma_1 ... sigma_(p-1))^q` in the displayed labelling.  The extracted
closure is definitionally the finite torus-link model after the word theorem,
so the component, knot, surface, and Alexander interfaces apply directly.
-/

namespace Purelib.Topology.Knot.Torus.Alexander.PowerTorusBridge

open Purelib.Topology.Knot.Torus.Alexander in
/-- Read the semigroup Alexander candidate at a retained positive root degree.

The coefficient list uses the degree value and supplied exponent without introducing a completed series. -/
def alexanderPolynomial (degree : Positive.RootDegree) (q
  : Nat) : List Int :=
  TorusInvariants.alexanderPolynomial degree.value q
end Purelib.Topology.Knot.Torus.Alexander.PowerTorusBridge

end
