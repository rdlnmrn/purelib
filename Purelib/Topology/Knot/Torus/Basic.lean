/-!
# Finite torus braids

This file constructs the positive braid
`(σ₁ · … · σₚ₋₁)^q` as an executable finite word on `p`
strands.  It is the combinatorial braid predicted for the algebraic
singularity `z^p = w^q`.  The construction exposes exact crossing count,
writhe, and endpoint permutation iteration without invoking a completed
curve or a topological quotient.
-/

namespace Purelib.Topology.Knot.Torus.Basic

open Purelib.Topology.Knot.Braid

/-! ## The algebraic torus-link model -/

set_option genInjectivity false in
/-- Positive integral exponents for the finite singularity model `z^p = w^q`. -/
structure PowerSingularity where
  /-- The positive strand exponent in the power singularity. -/ p : Nat
  /-- The positive band-repetition exponent in the power singularity. -/ q : Nat
  /-- The strand exponent is strictly positive. -/ pPositive : 0 < p
  /-- The repetition exponent is strictly positive. -/ qPositive : 0 < q

constructive_injectivity PowerSingularity

derive_exposed_repr PowerSingularity

namespace PowerSingularity

section
open Purelib.Topology.Knot
/-- The braid `(σ₁…σₚ₋₁)^q` predicted by the singularity. -/
def braidWord (singularity : PowerSingularity) :
  Word singularity.p :=
  Word.repeatWord (PositiveBand.Basic.positiveBand singularity.p) singularity.q

/-- Close the repeated positive band on its retained number of strands. -/
def closure (singularity : PowerSingularity) :
  Braid.Closure :=
  { strands := singularity.p
    word := singularity.braidWord }

end

section
open Purelib.Topology.Knot
open Purelib.Topology.Knot.Torus.Basic
/-- The torus braid has q times (p minus one) generator occurrences. -/
@[simp] theorem braidWord_length (singularity :
  PowerSingularity) :
    singularity.braidWord.length = singularity.q * (singularity.p - 1) := by
  simp only [braidWord, Word.repeatWord_length, PositiveBand.Basic.positiveBand_length, -eq_self,
    -iff_self]
  rfl

/-- The torus braid writhe is q times (p minus one). -/
@[simp] theorem braidWord_writhe (singularity :
  PowerSingularity) :
    singularity.braidWord.writhe =
      (singularity.q : Int) * (singularity.p - 1 : Nat) := by
  simp only [braidWord, Word.repeatWord_writhe, PositiveBand.Basic.positiveBand_writhe, -eq_self,
    -iff_self]
  rfl

end

open Purelib.Topology.Knot in
/-- The torus closure acts by q iterations of its positive band permutation. -/
theorem closure_permutation (singularity :
  PowerSingularity)
    (index : Fin singularity.p) :
    singularity.closure.permutation.forward index =
      Data.Fin.Bijection.iterateForward
        (PositiveBand.Basic.positiveBand singularity.p).permutation singularity.q index := by
  exact Word.repeatWord_permutation (PositiveBand.Basic.positiveBand singularity.p)
    singularity.q index

end PowerSingularity

end Purelib.Topology.Knot.Torus.Basic

end

end

section
@[expose] public section

/-!
# Executable torus-knot genus and Alexander data

This file supplies finite integer-polynomial and positive-braid surface
certificates for the torus family.  Polynomial coefficients are stored in
low-to-high order.  Equality is coefficientwise over one explicit finite
bound, so concrete certificates reduce by kernel computation.

The Alexander candidate uses the numerical semigroup generated by `p` and
`q`: below the conductor `(p-1)(q-1)`, its coefficient at `n` is the change
in the semigroup-membership indicator from `n-1` to `n`.  A certificate checks
the familiar exact identity

`Delta(t) (1-t^p) (1-t^q) = (1-t^(pq)) (1-t)`.

No completed Laurent series or quotient field is constructed.
-/

namespace Purelib.Topology.Knot.Torus.Basic

/-! ## Finite integer polynomials -/

/-! ## Semigroup Alexander candidate -/

/-- The natural number (p minus one) times (q minus one).

Natural subtraction is used for arbitrary input exponents; for positive coprime exponents this is the two-generator
conductor. -/
def conductor (p q : Nat) : Nat := (p - 1) * (q - 1)
end Purelib.Topology.Knot.Torus.Basic

end
