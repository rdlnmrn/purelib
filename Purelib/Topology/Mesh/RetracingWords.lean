open _root_.Purelib.Data.Gaussian.Norm.Sum.Basic (gaussianSum)

variable {count : Nat}

namespace CutPath

open Purelib.Topology.Surface.Cut.JumpPaths.CutPath (reverse)

/-- Reversing a word moves its reversed leading edge to the end.

The original list reversal places the leading occurrence after the reversed tail. Mapping edge reversal preserves that
tail and the same final oriented edge. -/
theorem reverse_cons (edge : Stokes.OrientedEdge count) (word : List (Stokes.OrientedEdge count)) :
    CutPath.reverse (edge :: word) = CutPath.reverse word ++ [edge.reverse] := by
  rw [CutPath.reverse, Reverse.reverse_cons, Map.map_append]
  rfl

/-- Reversal exchanges the order of two concatenated edge words.

The original reversal and mapping operations retain every signed occurrence. Their structural concatenation laws put the
reversed right word before the reversed left word. -/
theorem reverse_append (first last : List (Stokes.OrientedEdge count)) :
    CutPath.reverse (first ++ last) = CutPath.reverse last ++ CutPath.reverse first := by
  rw [CutPath.reverse, Reverse.reverse_append, Map.map_append]
  rfl

open Purelib.Topology.Mesh.RetracingWords in
/-- Reversing an oriented edge word twice restores it. -/
theorem reverse_reverse (word : List (Stokes.OrientedEdge count)) : CutPath.reverse (CutPath.reverse word) = word := by
  induction word with
  | nil => rfl
  | cons edge rest ih =>
      rw [reverse_cons, reverse_append]
      change [edge.reverse.reverse] ++ CutPath.reverse (CutPath.reverse rest) = _
      rw [OrientedEdge.reverse_reverse, ih]
      rfl

end CutPath

/-- Equivalence of edge words generated by concatenation and adjacent opposite-edge cancellation.

The certificate preserves the order of surviving occurrences and does not admit arbitrary edge permutations. -/
inductive Retracing : List (Stokes.OrientedEdge count) → List (Stokes.OrientedEdge count) → Prop
  /-- Retain an unchanged edge word. -/ | refl (word) : Retracing word word
  /-- Reverse the direction of a retracing certificate. -/ | symm {first last} (same :
    Retracing first last) : Retracing last
    first
  /-- Compose two retracing certificates through their common word. -/ | trans {first middle last} (initial :
    Retracing first middle) (final : Retracing
    middle last) : Retracing first last
  /-- Concatenate two certified retracings in their original order. -/ | append {a b c d} (first :
    Retracing a b) (last : Retracing c d) :
    Retracing (a ++ c) (b ++ d)
  /-- Delete one adjacent edge and its reverse. -/ | cancel (edge) : Retracing
    [edge, edge.reverse] []

namespace Retracing

open Purelib.Topology.Mesh in
/-- Equal edge words carry a reflexive retracing certificate. -/
theorem of_eq {first last : List (Stokes.OrientedEdge count)} (equal : first = last) : Retracing first
  last := by
  cases equal
  exact .refl first

section
open Purelib.Topology.Mesh
open Purelib.Topology.Mesh.RetracingWords
/-- Reversal transports a retracing certificate to the reversed words. -/
theorem reverse {first last : List (Stokes.OrientedEdge count)} (same : Retracing first last) :
    Retracing (CutPath.reverse first) (CutPath.reverse last) := by
  induction same with
  | refl word => exact .refl _
  | symm same ih => exact ih.symm
  | trans initial final ihInitial ihFinal => exact ihInitial.trans ihFinal
  | append first last ihFirst ihLast =>
      rw [CutPath.reverse_append, CutPath.reverse_append]
      exact ihLast.append ihFirst
  | cancel edge =>
      change Retracing [edge.reverse.reverse, edge.reverse] []
      rw [OrientedEdge.reverse_reverse]
      exact .cancel edge

/-- A word followed by its reverse cancels to the empty word.

Structural recursion cancels the retained tail between the same leading edge and its reverse. Concatenation
associativity then exposes that adjacent opposite pair without permuting any surviving occurrence. -/
theorem retrace (word : List (Stokes.OrientedEdge count)) : Retracing (word ++ CutPath.reverse word) []
  := by
  induction word with
  | nil => exact .refl []
  | cons edge rest ih =>
      have cancelled := ((refl [edge]).append ih).append (refl [edge.reverse])
      apply (of_eq ?_).trans (cancelled.trans (cancel edge))
      simp only [CutPath.reverse_cons, List.cons_append, Append.append_assoc, List.nil_append, -eq_self]
      rfl

/-- A reversed word followed by the original cancels to the empty word. -/
theorem reverse_retrace (word : List (Stokes.OrientedEdge count)) : Retracing (CutPath.reverse word ++
  word) [] := by
  have cancelled := retrace (CutPath.reverse word)
  rw [CutPath.reverse_reverse] at cancelled
  exact cancelled

end

open Purelib.Topology.Mesh in
/-- Retracing preserves the total of any antisymmetric Gaussian rational edge reading.

The certificate retains concatenation order and permits only adjacent opposite-edge cancellation. Antisymmetry makes
that pair contribute zero to the same word-value fold. -/
theorem values {first last : List (Stokes.OrientedEdge count)} (same : Retracing first last)
    (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (anti : ∀ edge, value edge.reverse = -value edge) :
    SewingRetraction.wordValue value first = SewingRetraction.wordValue value last := by
  induction same with
  | refl => rfl
  | symm same ih => exact ih.symm
  | trans first last ihFirst ihLast => exact ihFirst.trans ihLast
  | append first last ihFirst ihLast =>
    rw [SewingRetraction.wordValue_append, SewingRetraction.wordValue_append, ihFirst, ihLast]
  | cancel edge =>
      change value edge + (value edge.reverse + 0) = 0
      rw [anti, add_zero, add_neg_cancel]

end Retracing

/-- Evaluate the cumulative increment area of the ordered edge readings. -/
@[expose] def wordArea (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (word : List (Stokes.OrientedEdge
  count)) : Gaussian.Basic.Canonical :=
  IncrementArea.pathArea (word.map value)

/-- The finite Gaussian sum of mapped edge readings equals the word-value fold. -/
theorem sum_map_eq_wordValue (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (word : List
  (Stokes.OrientedEdge count)) :
    Data.Gaussian.Norm.Sum.Basic.gaussianSum (word.map value) = SewingRetraction.wordValue value word := by
  induction word with
  | nil => rfl
  | cons edge rest ih => exact congrArg (value edge + ·) ih

/-- The total of paired edge readings is the pair of their exact word valuations.

Mapping the same ordered word into paired readings retains both coordinates.
Each coordinate sum is the original word-value fold of its own edge reading. -/
theorem paired_total_map_eq_wordValue
    (left right : Stokes.OrientedEdge count → Gaussian.Basic.Canonical)
    (word : List (Stokes.OrientedEdge count)) :
    PairedIncrementArea.total
      (word.map (fun edge => (⟨left edge, right edge⟩ : Stokes.PrimitivePoint))) =
      (⟨SewingRetraction.wordValue left word,
        SewingRetraction.wordValue right word⟩ : Stokes.PrimitivePoint) := by
  apply congrArg₂ Stokes.PrimitivePoint.mk
  · rw [Map.map_map]
    exact sum_map_eq_wordValue left word
  · rw [Map.map_map]
    exact sum_map_eq_wordValue right word

section
open Purelib.Topology.Mesh
/-- Concatenated word area includes both internal areas and the cross term of their totals. -/
theorem wordArea_append (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (first last : List
  (Stokes.OrientedEdge count)) :
    wordArea value (first ++ last) = wordArea value first + wordArea value
      last +
      BoundaryRibbon.area (SewingRetraction.wordValue value first) (SewingRetraction.wordValue value last) := by
  rw [wordArea, Map.map_append, IncrementArea.pathArea_append, RetracingWords.sum_map_eq_wordValue,
    RetracingWords.sum_map_eq_wordValue]
  rfl

/-- Retracing preserves cumulative word area for antisymmetric edge readings. -/
theorem Retracing.areas {first last : List (Stokes.OrientedEdge count)} (same : Retracing first last)
    (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (anti : ∀ edge, value edge.reverse = -value edge) :
    wordArea value first = wordArea value last := by
  induction same with
  | refl => rfl
  | symm same ih => exact ih.symm
  | trans first last ihFirst ihLast => exact ihFirst.trans ihLast
  | append first last ihFirst ihLast =>
      rw [wordArea_append, wordArea_append, ihFirst, ihLast, first.values value anti,
        last.values value anti]
  | cancel edge =>
      simp only [wordArea, List.map_cons, List.map_nil, IncrementArea.pathArea_cons,
        Data.Gaussian.Norm.Sum.Basic.gaussianSum, anti, add_zero, IncrementArea.area_zero_right]
      change 0 + BoundaryRibbon.area (value edge) (-value edge) = 0
      rw [zero_add]
      apply Gaussian.Basic.ext <;>
        simp only [BoundaryRibbon.area, Data.Gaussian.Basic.conj,
          Gaussian.Basic.neg_re, Gaussian.Basic.neg_im,
          Gaussian.Basic.sub_re, Gaussian.Basic.sub_im,
          Gaussian.Basic.mul_re, Gaussian.Basic.mul_im,
          Gaussian.Basic.zero_re, Gaussian.Basic.zero_im] <;> ring1

end

/-- Negating the second increment negates its oriented cross area. -/
private theorem area_neg_right (first last : Gaussian.Basic.Canonical) :
    BoundaryRibbon.area first (-last) = -BoundaryRibbon.area first last := by
  change Data.Gaussian.Basic.conj first * (-last) -
    (-Data.Gaussian.Basic.conj last) * first = _
  unfold BoundaryRibbon.area
  ring1

/-- Exchanging the two increments negates their oriented cross area. -/
private theorem area_skew (first last : Gaussian.Basic.Canonical) :
    BoundaryRibbon.area first last = -BoundaryRibbon.area last first := by
  unfold BoundaryRibbon.area
  ring1

open Purelib.Topology.Mesh in
open Purelib.Topology.Mesh.RetracingWords in
/-- Reversing an edge word negates its cumulative area for antisymmetric readings. -/
theorem wordArea_reverse (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (anti : ∀ edge, value
  edge.reverse = -value edge)
    (word : List (Stokes.OrientedEdge count)) : wordArea value (CutPath.reverse word) =
      -wordArea value word := by
  have cancelled := (Retracing.retrace word).areas value anti
  rw [wordArea_append, SewingRetraction.wordValue_reverse value anti, area_neg_right,
    IncrementArea.area_self, neg_zero, add_zero] at cancelled
  change wordArea value word + wordArea value (CutPath.reverse word) = 0 at cancelled
  calc
    _ = (wordArea value word + wordArea value (CutPath.reverse word)) -
      wordArea value word := by
      ring1
    _ = _ := by rw [cancelled, zero_sub]

open Purelib.Topology.Mesh in
/-- Moving a closed-sheet boundary to a common base keeps its internal area and the full translation term, even if its
total is small or zero. -/
theorem wordArea_conjugate (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (anti : ∀ edge, value
  edge.reverse = -value edge)
    (stem loop : List (Stokes.OrientedEdge count)) :
    wordArea value (stem ++ (loop ++ CutPath.reverse stem)) = wordArea value loop +
      2 * BoundaryRibbon.area (SewingRetraction.wordValue value stem) (SewingRetraction.wordValue value loop) := by
  rw [wordArea_append, wordArea_append, SewingRetraction.wordValue_append,
    wordArea_reverse value anti,
    SewingRetraction.wordValue_reverse value anti]
  rw [IncrementArea.area_add_right, area_neg_right, area_neg_right,
    IncrementArea.area_self,
    area_skew (SewingRetraction.wordValue value loop) (SewingRetraction.wordValue value stem)]
  ring1

set_option genInjectivity false in
/-- Explicit internal polygons and translation terms.

A polygon term retains one ordered edge word. A cross term retains its integer coefficient and two ordered words, whose
original totals determine the oriented cross area. -/
inductive AreaTerm (count : Nat) where
  /-- Retain the internal area of one ordered edge word. -/ | polygon (word : List (Stokes.OrientedEdge count))
  /-- Retain an integer multiple of the cross area of two word totals. -/ | cross (coefficient : Int) (first last : List
    (Stokes.OrientedEdge count))

constructive_injectivity AreaTerm

namespace AreaTerm

section
open Purelib.Topology.Mesh
/-- Evaluate a retained polygon or integral cross-area term on an edge reading. -/
@[expose] def evaluate (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) : AreaTerm count →
  Gaussian.Basic.Canonical
  | .polygon word => wordArea value word
  | .cross coefficient first last => (coefficient : Gaussian.Basic.Canonical) *
      BoundaryRibbon.area (SewingRetraction.wordValue value first) (SewingRetraction.wordValue value last)

/-- Sum the evaluations of the retained area terms in list order. -/
@[expose] def total (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) : List (AreaTerm
  count) → Gaussian.Basic.Canonical
  | [] => 0
  | term :: rest => term.evaluate value + total value rest

end

open Purelib.Topology.Mesh in
open Purelib.Topology.Mesh.RetracingWords in
/-- Evaluation of concatenated area-term lists is additive.

The original fold evaluates terms in retained list order. Structural induction isolates the current term and transports
only the unchanged tail identity through scalar addition. -/
theorem total_append (value : Stokes.OrientedEdge count → Gaussian.Basic.Canonical) (first last : List
  (AreaTerm count)) :
    total value (first ++ last) = total value first + total value last := by
  induction first with
  | nil =>
      change total value last = 0 + total value last
      exact (Gaussian.Basic.zero_add (total value last)).symm
  | cons term rest ih =>
      change term.evaluate value + total value (rest ++ last) =
        (term.evaluate value + total value rest) + total value last
      rw [ih, add_assoc]

end AreaTerm

end Purelib.Topology.Mesh.RetracingWords
