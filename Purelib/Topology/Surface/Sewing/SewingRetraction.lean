variable {vertices faceCount : Nat}

/-- Sum the Gaussian reading of every original oriented edge occurrence in order.

The empty word has reading zero. Each retained edge contributes its displayed Gaussian value before the recursively
evaluated tail. -/
@[expose] def wordValue (value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical) : List (Stokes.OrientedEdge
  vertices) → Gaussian.Basic.Canonical
  | [] => 0
  | edge :: rest => value edge + Purelib.Topology.Surface.Sewing.SewingRetraction.wordValue value rest

/-- Evaluating concatenated original edge words gives the sum of their two readings.

Structural induction follows the first word, retaining each edge reading and transporting the equality for its unchanged
tail. -/
theorem wordValue_append (value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical)
    (first last : List (Stokes.OrientedEdge vertices)) :
    SewingRetraction.wordValue value (first ++ last) = SewingRetraction.wordValue value first +
      SewingRetraction.wordValue value last := by
  induction first with
  | nil =>
      simp only [List.nil_append, SewingRetraction.wordValue, zero_add, -eq_self, -iff_self]
      rfl
  | cons edge rest ih =>
      simp only [List.cons_append, SewingRetraction.wordValue, ih, add_assoc, -eq_self, -iff_self]
      rfl

/-- Reordering original edge occurrences preserves their Gaussian reading.

The incidence certificate is generated by empty lists, unchanged heads, adjacent swaps and composition. Each constructor
preserves the finite sum of the retained readings. -/
theorem wordValue_reordering (value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical)
    {first last : List (Stokes.OrientedEdge vertices)} (order : Stokes.EdgeReordering first last) :
    SewingRetraction.wordValue value first = SewingRetraction.wordValue value last := by
  induction order with
  | nil => rfl
  | cons edge rest ih => exact congrArg (value edge + ·) ih
  | swap =>
      simp only [SewingRetraction.wordValue, -eq_self, -iff_self]; ring1
  | trans first last ihFirst ihLast => exact ihFirst.trans ihLast

/-- Reversing an original edge word negates every antisymmetric reading.

The supplied antisymmetry law is specialized to each retained edge. Reversal changes their order and orientation while
preserving the resulting negative total reading. -/
theorem wordValue_reverse (value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical)
    (antisymmetric : ∀ edge, value edge.reverse = -value edge) (word : List (Stokes.OrientedEdge vertices)) :
    SewingRetraction.wordValue value (CutPath.reverse word) = -SewingRetraction.wordValue value word := by
  induction word with
  | nil =>
      simp only [CutPath.reverse, List.reverse_nil, List.map_nil, SewingRetraction.wordValue, neg_zero, -eq_self,
        -iff_self]
      rfl
  | cons edge rest ih =>
      simp only [CutPath.reverse, Reverse.reverse_cons, Map.map_append, List.map_cons, List.map_nil,
        SewingRetraction.wordValue_append, SewingRetraction.wordValue, antisymmetric, -eq_self, -iff_self]
      change SewingRetraction.wordValue value (CutPath.reverse rest) + (-value edge + 0) = _
      rw [ih]
      ring1

/-- An integer multiplicity paired with its original bounded face index. -/
abbrev FaceTerm (count : Nat) := Int × Fin count

/-- Sum the integer-weighted boundary readings of the retained original face terms.

Each retained pair supplies its signed integer multiplicity and original bounded face index. Recursion multiplies that
face boundary reading by the multiplicity and adds the unchanged tail. -/
@[expose] def faceValue (faces : Fin faceCount → Stokes.OrientedTriangle vertices) (value : Stokes.OrientedEdge vertices
  → Gaussian.Basic.Canonical) :
    List (SewingRetraction.FaceTerm faceCount) → Gaussian.Basic.Canonical
  | [] => 0
  | term :: rest => (term.1 : Gaussian.Basic.Canonical) * SewingRetraction.wordValue value (faces term.2).boundary +
    Purelib.Topology.Surface.Sewing.SewingRetraction.faceValue faces value rest

/-- Evaluating concatenated original face-term lists gives the sum of their two readings.

The first retained face list is traversed structurally. Its integer multiplicities and bounded face indices are
preserved in the additive decomposition. -/
theorem faceValue_append (faces : Fin faceCount → Stokes.OrientedTriangle vertices)
    (value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical) (first last : List (SewingRetraction.FaceTerm
      faceCount)) :
    SewingRetraction.faceValue faces value (first ++ last) = SewingRetraction.faceValue faces value first +
      SewingRetraction.faceValue faces value last := by
  induction first with
  | nil =>
      simp only [List.nil_append, SewingRetraction.faceValue, zero_add, -eq_self, -iff_self]
      rfl
  | cons term rest ih =>
      simp only [List.cons_append, SewingRetraction.faceValue, ih, add_assoc, -eq_self, -iff_self]
      rfl

/-- Negate each retained integer face multiplicity while preserving its original face index.

The finite map changes only the signed multiplicity. The ordered occurrence list and each bounded index into the same
face bank are retained. -/
@[expose] def negative (terms : List (SewingRetraction.FaceTerm faceCount)) : List (SewingRetraction.FaceTerm faceCount)
  :=
  terms.map fun term => (-term.1, term.2)

/-- Negating original face multiplicities negates their complete boundary reading.

The integer cast law identifies each negated multiplicity with the negative Gaussian coefficient. Structural induction
then preserves the complete signed boundary sum. -/
theorem faceValue_negative (faces : Fin faceCount → Stokes.OrientedTriangle vertices)
    (value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical) (terms : List (SewingRetraction.FaceTerm
      faceCount)) :
    SewingRetraction.faceValue faces value (SewingRetraction.negative terms) = -SewingRetraction.faceValue faces value
      terms := by
  induction terms with
  | nil =>
      simp only [SewingRetraction.negative, List.map_nil, SewingRetraction.faceValue, neg_zero, -eq_self, -iff_self]
      rfl
  | cons term rest ih =>
      change ((-term.1 : Int) : Gaussian.Basic.Canonical) * SewingRetraction.wordValue value (faces term.2).boundary +
        SewingRetraction.faceValue faces value (SewingRetraction.negative rest) = _
      have castNeg : ((-term.1 : Int) : Gaussian.Basic.Canonical) =
          -(term.1 : Gaussian.Basic.Canonical) := IntCast.neg term.1
      rw [castNeg, ih, SewingRetraction.faceValue]
      ring1

/-- Give every original face-index occurrence multiplicity one.

The finite map retains each index and its position while attaching the integer unit multiplicity. -/
@[expose] def whole (indices : List (Fin faceCount)) : List (SewingRetraction.FaceTerm faceCount) := indices.map (1, ·)

/-- Unit-weighting original face indices preserves concatenation.

Mapping the unit multiplicity over the two retained lists separately gives the same ordered face terms as mapping over
their concatenation. -/
theorem whole_append (first last : List (Fin faceCount)) : SewingRetraction.whole (first ++ last) =
  SewingRetraction.whole first ++ SewingRetraction.whole last :=
  Map.map_append ..

variable (faces : Fin faceCount → Stokes.OrientedTriangle vertices)

set_option genInjectivity false in
/-- A supported boundary path replacing one original edge with explicit signed face corrections.

The retained endpoints are those of the original edge, and every antisymmetric reading satisfies the exact
path-plus-face identity. -/
structure EdgeRoute (boundary : List (Stokes.OrientedEdge vertices)) (edge : Stokes.OrientedEdge vertices) where
  /-- Cached original boundary-supported replacement edge list. -/ path : List (Stokes.OrientedEdge vertices)
  /-- The retained route starts and finishes at the original edge's endpoints. -/ endpoints : PathBoundary.PathEndpoints
    OrientedEdge.start OrientedEdge.finish path edge.start edge.finish
  /-- Every route occurrence is supported by the original retained boundary up to reversal. -/ supported :
    CutPath.Supported boundary path
  /-- Cached signed original face terms accounting for the replacement. -/ correction : List (SewingRetraction.FaceTerm
    faceCount)
  /-- Every antisymmetric original edge reading equals route value plus the full retained face correction. -/ value_eq :
    ∀ value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical,
    (∀ edge, value edge.reverse = -value edge) →
    value edge = SewingRetraction.wordValue value path + SewingRetraction.faceValue faces value correction

constructive_injectivity EdgeRoute

set_option genInjectivity false in
/-- A supported boundary route for an original edge word with its complete signed face correction.

Original path endpoints are preserved whenever certified, and the value identity holds for every antisymmetric edge
reading. -/
structure WordRoute (boundary original : List (Stokes.OrientedEdge vertices)) where
  /-- Cached boundary-supported replacement for the original ordered edge word. -/ path : List (Stokes.OrientedEdge
    vertices)
  /-- The exact retained route uses only the original boundary support up to reversal. -/ supported : CutPath.Supported
    boundary path
  /-- Cached complete signed face correction for the original word substitution. -/ correction : List
    (SewingRetraction.FaceTerm faceCount)
  /-- Every certified original path transfers its same endpoints to the retained route. -/ endpoints : ∀ {start finish},
    PathBoundary.PathEndpoints OrientedEdge.start OrientedEdge.finish original start finish →
    PathBoundary.PathEndpoints OrientedEdge.start OrientedEdge.finish path start finish
  /-- The original word value equals retained route value plus its complete signed face correction. -/ value_eq : ∀
    value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical,
    (∀ edge, value edge.reverse = -value edge) →
    SewingRetraction.wordValue value original = SewingRetraction.wordValue value path + SewingRetraction.faceValue faces
      value correction

constructive_injectivity WordRoute

variable {faces}

namespace EdgeRoute

/-- Retain an already supported original edge as its one-edge route with no face correction.

The supplied boundary membership or reversed membership certifies support. The route keeps the edge endpoints and an
empty correction list with its exact value identity. -/
@[expose] def identity {boundary : List (Stokes.OrientedEdge vertices)} (edge : Stokes.OrientedEdge vertices)
    (member : edge ∈ boundary ∨ edge.reverse ∈ boundary) : SewingRetraction.EdgeRoute faces boundary edge :=
  ⟨[edge], .cons (.nil _), fun other h => by
      rcases Membership.mem_cons.mp h with same | absent
      · cases same; exact member
      · exact (List.not_mem_nil absent).elim,
    [], fun _ _ => by
      simp only [SewingRetraction.wordValue, SewingRetraction.faceValue, add_zero, -eq_self, -iff_self]
      rfl⟩

/-- Reverse the original route and negate all retained face corrections.

The reversed path keeps the same boundary support and exchanged endpoints. Negating the retained face multiplicities
transports the antisymmetric value identity. -/
@[expose] def reverse {boundary : List (Stokes.OrientedEdge vertices)} {edge : Stokes.OrientedEdge vertices}
    (route : SewingRetraction.EdgeRoute faces boundary edge) : SewingRetraction.EdgeRoute faces boundary edge.reverse :=
  ⟨CutPath.reverse route.path, CutPath.reverse_endpoints route.endpoints,
    CutPath.supported_reverse route.supported, SewingRetraction.negative route.correction,
    fun value anti => by
      rw [anti, SewingRetraction.wordValue_reverse value anti, SewingRetraction.faceValue_negative, route.value_eq value
        anti]
      ring1⟩

/-- Substitute a retained word route into the original edge route and concatenate their complete face corrections.

The replacement path supplies the same endpoints and retained support. The correction lists are combined in their
specified order so every antisymmetric reading obeys the composed identity. -/
@[expose] def trans {first last : List (Stokes.OrientedEdge vertices)} {edge : Stokes.OrientedEdge vertices}
    (route : SewingRetraction.EdgeRoute faces first edge) (next : SewingRetraction.WordRoute faces last route.path) :
      SewingRetraction.EdgeRoute faces last edge :=
  ⟨next.path, next.endpoints route.endpoints, next.supported, next.correction ++ route.correction,
    fun value anti => by
      rw [SewingRetraction.faceValue_append, route.value_eq value anti, next.value_eq value anti]
      ring1⟩

end EdgeRoute

/-- Route each actual occurrence, keeping both signed face corrections and the entire concatenated boundary word as
executable data.

Each supplied occurrence is routed using its retained support witness. Recursive concatenation preserves the complete
path, signed face corrections, endpoints and value equality. -/
@[expose] def routeWord {source boundary : List (Stokes.OrientedEdge vertices)}
    (route : ∀ edge, edge ∈ source ∨ edge.reverse ∈ source → SewingRetraction.EdgeRoute faces boundary edge) :
    (word : List (Stokes.OrientedEdge vertices)) → CutPath.Supported source word → SewingRetraction.WordRoute faces
      boundary word
  | [], _ => ⟨[], fun _ member => (List.not_mem_nil member).elim, [],
      fun endpoints => endpoints, fun _ _ => by
        simp only [SewingRetraction.wordValue, SewingRetraction.faceValue, add_zero, -eq_self, -iff_self]
        rfl⟩
  | edge :: rest, supported =>
      let first := route edge (supported edge List.mem_cons_self)
      let last := Purelib.Topology.Surface.Sewing.SewingRetraction.routeWord route rest (fun next member => supported
        next (List.mem_cons_of_mem _ member))
      ⟨first.path ++ last.path, CutPath.supported_append first.supported last.supported,
        first.correction ++ last.correction,
        fun endpoints => by
          cases endpoints with
          | cons tail => exact PathEndpoints.append first.endpoints (last.endpoints tail),
        fun value anti => by
          rw [SewingRetraction.wordValue, SewingRetraction.wordValue_append, SewingRetraction.faceValue_append,
            first.value_eq value anti, last.value_eq value anti]
          ring1⟩

/-- An original boundary edge different from the selected seam belongs to its retained cyclic tail.

The boundary split retains its exact prefix, seam and suffix. Membership outside the selected seam is transported into
the same cyclic remainder. -/
private theorem mem_rest {boundary : List (Stokes.OrientedEdge vertices)} (split : PolygonStokes.BoundarySplit boundary)
    {edge : Stokes.OrientedEdge vertices} (member : edge ∈ boundary) (different : edge ≠ split.edge) : edge ∈ split.rest
      := by
  rw [split.equation] at member
  rcases Membership.mem_append.mp member with before | after
  · exact Membership.mem_append.mpr (Or.inr before)
  · rcases Membership.mem_cons.mp after with same | after
    · exact (different same).elim
    · exact Membership.mem_append.mpr (Or.inl after)

/-- Replace the selected seam in either direction.

The forward seam uses the supplied route and the reverse seam uses its reversal. Every other retained occurrence keeps
its literal one-edge route and boundary support witness. -/
@[expose] def replace {source boundary : List (Stokes.OrientedEdge vertices)} (split : PolygonStokes.BoundarySplit
  source)
    (rest : ∀ edge ∈ split.rest, edge ∈ boundary) (seam : SewingRetraction.EdgeRoute faces boundary split.edge)
    (edge : Stokes.OrientedEdge vertices) (member : edge ∈ source ∨ edge.reverse ∈ source) :
    SewingRetraction.EdgeRoute faces boundary edge :=
  if same : edge = split.edge then same ▸ seam
  else if backwards : edge = split.edge.reverse then backwards ▸ seam.reverse
  else SewingRetraction.EdgeRoute.identity edge (by
    rcases member with forward | reverse
    · exact Or.inl (rest edge (SewingRetraction.mem_rest split forward same))
    · apply Or.inr (rest edge.reverse (SewingRetraction.mem_rest split reverse ?_))
      intro equal
      exact backwards ((congrArg OrientedEdge.reverse equal).symm.trans (OrientedEdge.reverse_reverse edge)).symm)

set_option genInjectivity false in
/-- Routing of a patch's actual triangle occurrences.

The retained closed boundary has its exact signed face reading. Each original face-edge occurrence or its reverse
receives a supported route carrying the same endpoints and full face correction. -/
structure Retraction (faces : Fin faceCount → Stokes.OrientedTriangle vertices)
    (indices : List (Fin faceCount)) (boundary : List (Stokes.OrientedEdge vertices)) where
  /-- The original retained patch boundary is a certified closed path. -/ closed : ∃ anchor, PathBoundary.PathEndpoints
    OrientedEdge.start OrientedEdge.finish boundary anchor anchor
  /-- Every antisymmetric reading of the original boundary equals the complete included face sum. -/ boundary_eq : ∀
    value : Stokes.OrientedEdge vertices → Gaussian.Basic.Canonical,
    (∀ edge, value edge.reverse = -value edge) →
    SewingRetraction.wordValue value boundary = SewingRetraction.faceValue faces value (SewingRetraction.whole indices)
  /-- Retained boundary-route constructor for each original face-edge occurrence and its reverse. -/ edge : ∀ edge, edge
    ∈ (indices.flatMap fun index => (faces index).boundary) ∨
    edge.reverse ∈ (indices.flatMap fun index => (faces index).boundary) → SewingRetraction.EdgeRoute faces boundary
      edge

constructive_injectivity Retraction

namespace Retraction

/-- Build the original triangle's boundary retraction using its literal edge routes and complete face reading.

The three boundary edges and the supplied face index are retained. Each supported edge receives its identity route, and
the unit face multiplicity certifies the complete boundary reading. -/
@[expose] def triangle (faces : Fin faceCount → Stokes.OrientedTriangle vertices) (index : Fin faceCount) :
    SewingRetraction.Retraction faces [index] (faces index).boundary :=
  { closed := ⟨(faces index).first, .cons (.cons (.cons (.nil _)))⟩
    boundary_eq := fun value _ => by
      simp only [SewingRetraction.whole, List.map_cons, List.map_nil, SewingRetraction.faceValue, Int.cast_one, one_mul,
        add_zero, -eq_self, -iff_self]
      rfl
    edge := fun edge member => SewingRetraction.EdgeRoute.identity edge (by
      change edge ∈ (faces index).boundary ++ [] ∨
        edge.reverse ∈ (faces index).boundary ++ [] at member
      rw [Append.append_nil] at member
      exact member) }

/-- The other patch supplies a path in the seam's original direction; its whole face sum appears with a minus sign in
the correction.

The selected boundary split retains its cyclic remainder and exchanged seam endpoints. The supplied support inclusion
and closed boundary identity certify the negative face correction. -/
@[expose] def across {indices : List (Fin faceCount)} {source boundary : List (Stokes.OrientedEdge vertices)}
    (other : SewingRetraction.Retraction faces indices source) (split : PolygonStokes.BoundarySplit source)
    (edge : Stokes.OrientedEdge vertices) (opposite : split.edge = edge.reverse)
    (rest : ∀ next ∈ split.rest, next ∈ boundary) : SewingRetraction.EdgeRoute faces boundary edge := by
  refine ⟨split.rest, ?_, fun next member => Or.inl (rest next member), SewingRetraction.negative
    (SewingRetraction.whole indices), ?_⟩
  · obtain ⟨anchor, closed⟩ := other.closed
    have path := split.rest_path closed
    rw [opposite] at path
    exact path
  · intro value anti
    have equation := other.boundary_eq value anti
    rw [SewingRetraction.wordValue_reordering value split.ordering, SewingRetraction.wordValue, opposite,
      anti] at equation
    rw [SewingRetraction.faceValue_negative]
    rw [← equation]
    ring1

/-- Eliminate only this actual sewn edge.

The two seam splits and their reversal equality determine the retained combined boundary. Each routed occurrence keeps
its source support and the ordered correction lists of the two patches. -/
@[expose] def sew {firstIndices lastIndices : List (Fin faceCount)}
    {firstBoundary lastBoundary : List (Stokes.OrientedEdge vertices)}
    (first : SewingRetraction.Retraction faces firstIndices firstBoundary) (last : SewingRetraction.Retraction faces
      lastIndices lastBoundary)
    (firstSplit : PolygonStokes.BoundarySplit firstBoundary) (lastSplit : PolygonStokes.BoundarySplit lastBoundary)
    (opposite : lastSplit.edge = firstSplit.edge.reverse) :
    SewingRetraction.Retraction faces (firstIndices ++ lastIndices) (firstSplit.rest ++ lastSplit.rest) := by
  let fromFirst := SewingRetraction.replace firstSplit
    (fun edge member => Membership.mem_append.mpr (Or.inl member))
    (last.across lastSplit firstSplit.edge opposite (fun edge member => Membership.mem_append.mpr (Or.inr member)))
  have reverseOpposite : firstSplit.edge = lastSplit.edge.reverse := by
    rw [opposite, OrientedEdge.reverse_reverse]
  let fromLast := SewingRetraction.replace lastSplit
    (fun edge member => Membership.mem_append.mpr (Or.inr member))
    (first.across firstSplit lastSplit.edge reverseOpposite (fun edge member => Membership.mem_append.mpr (Or.inl
      member)))
  refine ⟨?_, ?_, ?_⟩
  · obtain ⟨firstAnchor, firstClosed⟩ := first.closed
    obtain ⟨lastAnchor, lastClosed⟩ := last.closed
    exact ⟨firstSplit.edge.finish, PolygonStokes.sew_closed firstSplit lastSplit opposite firstClosed lastClosed⟩
  · intro value anti
    have firstValue := first.boundary_eq value anti
    have lastValue := last.boundary_eq value anti
    rw [SewingRetraction.wordValue_reordering value firstSplit.ordering, SewingRetraction.wordValue] at firstValue
    rw [SewingRetraction.wordValue_reordering value lastSplit.ordering, SewingRetraction.wordValue] at lastValue
    rw [SewingRetraction.wordValue_append, SewingRetraction.whole_append, SewingRetraction.faceValue_append, ←
      firstValue, ← lastValue, opposite, anti]
    ring1
  · intro edge member
    if inFirst : edge ∈ (firstIndices.flatMap fun index => (faces index).boundary) ∨
        edge.reverse ∈ (firstIndices.flatMap fun index => (faces index).boundary) then
      let original := first.edge edge inFirst
      exact original.trans (SewingRetraction.routeWord fromFirst original.path original.supported)
    else
      have inLast : edge ∈ (lastIndices.flatMap fun index => (faces index).boundary) ∨
          edge.reverse ∈ (lastIndices.flatMap fun index => (faces index).boundary) := by
        simp only [Flatten.flatMap_append, -eq_self, -iff_self] at member
        rcases member with forward | reverse
        · rcases Membership.mem_append.mp forward with first | last
          · exact (inFirst (Or.inl first)).elim
          · exact Or.inl last
        · rcases Membership.mem_append.mp reverse with first | last
          · exact (inFirst (Or.inr first)).elim
          · exact Or.inr last
      let original := last.edge edge inLast
      exact original.trans (SewingRetraction.routeWord fromLast original.path original.supported)

/-- Every recorded cut assembly constructs its retraction.

A triangle uses its identity boundary routes. A sewing constructor composes the two retained recursive retractions using
its supplied seam splits and reversal certificate. -/
@[expose] def ofAssembly : {indices : List (Fin faceCount)} → {boundary : List (Stokes.OrientedEdge vertices)} →
    {patch : Patch.CutPatch faces indices boundary} → CutPatch.Assembly faces patch → SewingRetraction.Retraction faces
      indices boundary
  | _, _, _, .triangle index => Retraction.triangle faces index
  | _, _, _, .sew first last firstSplit lastSplit opposite _ =>
      (Purelib.Topology.Surface.Sewing.SewingRetraction.Retraction.ofAssembly first).sew
        (Purelib.Topology.Surface.Sewing.SewingRetraction.Retraction.ofAssembly last) firstSplit lastSplit opposite

/-- Construct the boundary retraction from the exact original sewn patch assembly.

The patch supplies its retained face-index list, boundary and assembly witness. The resulting retraction is built
directly from that same witness. -/
@[expose] def ofPatch (patch : SewingTree.SewnPatch faces) : SewingRetraction.Retraction faces patch.faceIndices
  patch.boundary :=
  Retraction.ofAssembly patch.assembly

/-- Route a supported original face-incidence word through the retained patch retraction.

Each supplied occurrence uses the retraction's existing edge route and support witness. The resulting word route retains
the full ordered path and face corrections. -/
@[expose] def word {indices : List (Fin faceCount)} {boundary : List (Stokes.OrientedEdge vertices)}
    (retraction : SewingRetraction.Retraction faces indices boundary) (original : List (Stokes.OrientedEdge vertices))
    (supported : CutPath.Supported (indices.flatMap fun index => (faces index).boundary) original) :
    SewingRetraction.WordRoute faces boundary original := SewingRetraction.routeWord retraction.edge original supported

end Retraction

end Purelib.Topology.Surface.Sewing.SewingRetraction
