/-- Finite endpoint identifications generated by the displayed cut pairs. No quotient carrier or choice of
equivalence-class representatives is used. -/
inductive PairVertexJoin {source target : Nat} {labels : Fin source → Fin target}
    (pairs : List (ProjectedEdgePairs.ProjectedEdgePair labels)) : Fin source → Fin source → Prop
  /-- Each cut vertex is joined to itself. -/ | refl (vertex) : PairVertexJoin
    pairs vertex vertex
  /-- Identify the first start with the second finish of an original retained cut pair. -/ | start (pair) (member : pair
    ∈ pairs) : PairVertexJoin pairs pair.first.start pair.second.finish
  /-- Identify the first finish with the second start of an original retained cut pair. -/ | finish (pair) (member :
    pair ∈ pairs) : PairVertexJoin pairs pair.first.finish pair.second.start
  /-- Reverse a finite chain of pair-generated vertex identifications. -/ | symm {first last} :
    PairVertexJoin pairs first last →
    PairVertexJoin pairs last first
  /-- Concatenate two pair-generated identification chains through their common cut vertex. -/ | trans {first middle
    last} : PairVertexJoin pairs first middle →
    PairVertexJoin pairs middle last →
    PairVertexJoin pairs first last

open Purelib.Topology.Surface.Cut in
/-- Every identification generated by original cut pairs preserves the surface-vertex label. -/
theorem PairVertexJoin.projected {source target : Nat} {labels : Fin source → Fin target}
    {pairs : List (ProjectedEdgePairs.ProjectedEdgePair labels)} {first last : Fin source}
    (joined : PairVertexJoin pairs first last) : labels first = labels last := by
  induction joined with
  | refl => rfl
  | start pair => exact (congrArg OrientedEdge.finish pair.opposite).symm
  | finish pair => exact (congrArg OrientedEdge.start pair.opposite).symm
  | symm previous ih => exact ih.symm
  | trans left right ihLeft ihRight => exact ihLeft.trans ihRight

namespace ProjectedEdgePair

/-- Paired occurrence expansion preserves concatenation of pair lists. -/
private theorem occurrences_append {source target : Nat} {labels : Fin source → Fin target}
    (first last : List (ProjectedEdgePairs.ProjectedEdgePair labels)) : ProjectedEdgePair.occurrences (first ++ last) =
      ProjectedEdgePair.occurrences first ++ ProjectedEdgePair.occurrences last := by
  induction first with
  | nil => rfl
  | cons pair rest ih => exact congrArg (List.cons pair.first) (congrArg (List.cons pair.second) ih)

/-- Every paired edge occurrence comes from one original pair and one of its two sides.

The ordered occurrence expansion selects an original member pair and
records whether its first or second edge supplied the entry. -/
private theorem of_mem_occurrences {source target : Nat} {labels : Fin source → Fin target}
    {edge : Stokes.OrientedEdge source} : (pairs : List (ProjectedEdgePairs.ProjectedEdgePair labels)) → edge ∈
      ProjectedEdgePair.occurrences pairs →
      ∃ pair ∈ pairs, edge = pair.first ∨ edge = pair.second
  | [], member => (List.not_mem_nil member).elim
  | pair :: rest, member => by
      rcases Membership.mem_cons.mp member with same | member
      · exact ⟨pair, List.mem_cons_self, Or.inl same⟩
      · rcases Membership.mem_cons.mp member with same | member
        · exact ⟨pair, List.mem_cons_self, Or.inr same⟩
        · obtain ⟨found, foundMember, same⟩ :=
            of_mem_occurrences rest member
          exact ⟨found, List.mem_cons_of_mem _ foundMember, same⟩

/-- Both sides of each original pair belong to the complete paired occurrence list.

Membership in the original pair list supplies both edges in its ordered
two-entry occurrence expansion. -/
private theorem occurrence_mem {source target : Nat} {labels : Fin source → Fin target}
    {pair : ProjectedEdgePairs.ProjectedEdgePair labels} : (pairs : List (ProjectedEdgePairs.ProjectedEdgePair labels))
      → pair ∈ pairs →
      pair.first ∈ ProjectedEdgePair.occurrences pairs ∧ pair.second ∈ ProjectedEdgePair.occurrences pairs
  | [], member => (List.not_mem_nil member).elim
  | head :: rest, member => by
      rcases Membership.mem_cons.mp member with same | member
      · subst pair
        exact ⟨List.mem_cons_self, List.mem_cons_of_mem _ List.mem_cons_self⟩
      · have tail := occurrence_mem rest member
        exact ⟨List.mem_cons_of_mem _ (List.mem_cons_of_mem _ tail.1),
          List.mem_cons_of_mem _ (List.mem_cons_of_mem _ tail.2)⟩

end ProjectedEdgePair

namespace ProjectedEdgePairing

open Purelib.Topology.Surface.Cut in
open Purelib.Topology.Surface.Cut.VertexGluing in
/-- Unique projected incidence transfers the retained pair-endpoint relation to every opposite input edge pair.

Unique projected incidence identifies the original opposite edge pair.
The supplied relation joins the corresponding endpoints of that same pair. -/
private theorem opposite_joined {source target : Nat} {labels : Fin source → Fin target}
    {edges : List (Stokes.OrientedEdge source)} (pairing : ProjectedEdgePairs.ProjectedEdgePairing labels edges)
    (unique : (edges.map (OrientedEdge.map labels)).Nodup)
    (relation : Fin source → Fin source → Prop)
    (symmetric : ∀ {first last}, relation first last → relation last first)
    (matched : ∀ pair ∈ pairing.pairs, relation pair.first.start pair.second.finish ∧ relation pair.first.finish
      pair.second.start)
    {first last : Stokes.OrientedEdge source} (firstMember : first ∈ edges) (lastMember : last ∈ edges)
    (opposite : OrientedEdge.map labels last = (OrientedEdge.map labels first).reverse) :
    relation first.start last.finish ∧ relation first.finish last.start := by
  have firstPaired : first ∈ ProjectedEdgePair.occurrences pairing.pairs := by
    rcases Membership.mem_append.mp ((EdgeReordering.mem_iff pairing.incidence first).mp firstMember) with physical |
      paired
    · have missing := ((ProjectedEdgePairing.boundary_iff pairing unique (OrientedEdge.map labels first)).mp
        (Map.mem_map_of_mem physical)).2
      exact (missing (opposite ▸ Map.mem_map_of_mem lastMember)).elim
    · exact paired
  obtain ⟨pair, pairMember, same⟩ := ProjectedEdgePair.of_mem_occurrences pairing.pairs firstPaired
  have members := ProjectedEdgePair.occurrence_mem pairing.pairs pairMember
  have firstInput := (EdgeReordering.mem_iff pairing.incidence pair.first).mpr (Membership.mem_append.mpr (Or.inr
    members.1))
  have secondInput := (EdgeReordering.mem_iff pairing.incidence pair.second).mpr (Membership.mem_append.mpr (Or.inr
    members.2))
  rcases same with same | same
  · subst first
    have same := Nodup.eq_of_map_eq_of_mem (OrientedEdge.map labels) unique lastMember secondInput (opposite.trans
      pair.opposite.symm)
    subst last
    exact matched pair pairMember
  · subst first
    have projected : OrientedEdge.map labels last = OrientedEdge.map labels pair.first :=
      opposite.trans ((congrArg OrientedEdge.reverse pair.opposite).trans (OrientedEdge.reverse_reverse _))
    have same := Nodup.eq_of_map_eq_of_mem (OrientedEdge.map labels) unique lastMember firstInput projected
    subst last
    exact ⟨symmetric (matched pair pairMember).2, symmetric (matched pair pairMember).1⟩

end ProjectedEdgePairing

namespace CutPatch

variable {vertexCount faceCount : Nat} {faces : Fin faceCount → Stokes.OrientedTriangle vertexCount}
  {indices : List (Fin faceCount)} {boundary : List (Stokes.OrientedEdge vertexCount)}

/-- Regard each already-sewn cut edge and its literal reverse as a projected edge pair. -/
private def sewnPairs {source target : Nat} (labels : Fin source → Fin target) (edges : List (Stokes.OrientedEdge
  source)) :
    List (ProjectedEdgePairs.ProjectedEdgePair labels) := edges.map fun edge => ⟨edge, edge.reverse, rfl⟩

section
open Purelib.Topology.Surface.Cut.VertexGluing
/-- Already-sewn pairs expand to the original seam occurrence list. -/
private theorem sewnPairs_occurrences {source target : Nat} (labels : Fin source → Fin target) (edges : List
  (Stokes.OrientedEdge source)) :
    ProjectedEdgePair.occurrences (sewnPairs labels edges) = Stokes.pairedEdgeOccurrences edges := by
  induction edges with
  | nil => rfl
  | cons edge rest ih => exact congrArg (List.cons edge) (congrArg (List.cons edge.reverse) ih)

/-- Combine exposed cut pairs and already-sewn seams into a pairing of all original triangle incidences.

The original boundary and pair list are retained; already sewn seams are
appended. The incidence certificate accounts for the original triangle edges. -/
private def allEdgePairs (patch : Patch.CutPatch faces indices boundary)
    (pairing : ProjectedEdgePairs.ProjectedEdgePairing patch.vertexLabels patch.boundary) :
    ProjectedEdgePairs.ProjectedEdgePairing patch.vertexLabels (patch.triangles.flatMap OrientedTriangle.boundary) where
  boundary := pairing.boundary
  pairs := pairing.pairs ++ sewnPairs patch.vertexLabels patch.seams
  incidence := by
    simpa only [ProjectedEdgePair.occurrences_append, sewnPairs_occurrences, Append.append_assoc] using
      patch.incidence.trans (Purelib.Topology.Mesh.EdgeCancellation.EdgeReordering.append_right pairing.incidence
        (Stokes.pairedEdgeOccurrences patch.seams))
  noReverse := pairing.noReverse

end

open Purelib.Topology.Surface.Cut in
open Purelib.Topology.Surface.Cut.VertexGluing in
/-- A dual seam is either already sewn (literal equal endpoints), or one of the retained cut pairs. No unrelated
coincident labels are identified.

Original cut pairs and retained sewn seams generate the endpoint relation.
Unique projected incidence identifies the matching opposite occurrences. -/
theorem opposite_vertices_joined (patch : Patch.CutPatch faces indices boundary)
    (pairing : ProjectedEdgePairs.ProjectedEdgePairing patch.vertexLabels patch.boundary)
    (unique : ((patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels)).Nodup)
    {first last : Stokes.OrientedEdge patch.count}
    (firstMember : first ∈ patch.triangles.flatMap OrientedTriangle.boundary)
    (lastMember : last ∈ patch.triangles.flatMap OrientedTriangle.boundary)
    (opposite : OrientedEdge.map patch.vertexLabels last = (OrientedEdge.map patch.vertexLabels first).reverse) :
    PairVertexJoin pairing.pairs first.start last.finish ∧ PairVertexJoin pairing.pairs
      first.finish last.start := by
  apply ProjectedEdgePairing.opposite_joined (allEdgePairs patch pairing) unique (PairVertexJoin
    pairing.pairs) PairVertexJoin.symm ?_
    firstMember lastMember opposite
  intro pair member
  rcases Membership.mem_append.mp member with original | sewn
  · exact ⟨.start pair original, .finish pair original⟩
  · obtain ⟨edge, _, same⟩ := Map.mem_map.mp sewn
    cases same
    exact ⟨.refl _, .refl _⟩

/-- An edge of a retained triangle belongs to the complete cut-triangle incidence list. -/
private theorem edge_member {patch : Patch.CutPatch faces indices boundary} {triangle : Stokes.OrientedTriangle
  patch.count}
    (member : triangle ∈ patch.triangles) {edge : Stokes.OrientedEdge patch.count} (onTriangle : edge ∈
      triangle.boundary) :
    edge ∈ patch.triangles.flatMap OrientedTriangle.boundary :=
  Flatten.mem_flatMap.mpr ⟨triangle, member, onTriangle⟩

open Purelib.Topology.Surface.Cut in
open Purelib.Topology.Surface.Cut.VertexGluing in
/-- Unique projected incidence identifies retained triangles with identical projections. -/
private theorem triangle_eq_of_projection (patch : Patch.CutPatch faces indices boundary)
    (unique : ((patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels)).Nodup)
    {first last : Stokes.OrientedTriangle patch.count} (firstMember : first ∈ patch.triangles) (lastMember : last ∈
      patch.triangles)
    (equal : OrientedTriangle.map patch.vertexLabels first = OrientedTriangle.map patch.vertexLabels last) : first =
      last := by
  have bottom : (⟨first.first, first.second⟩ : Stokes.OrientedEdge patch.count) = ⟨last.first, last.second⟩ :=
    Nodup.eq_of_map_eq_of_mem (OrientedEdge.map patch.vertexLabels) unique
      (edge_member firstMember List.mem_cons_self) (edge_member lastMember List.mem_cons_self)
      (congrArg (fun triangle => (⟨triangle.first, triangle.second⟩ : Stokes.OrientedEdge vertexCount)) equal)
  have right : (⟨first.second, first.third⟩ : Stokes.OrientedEdge patch.count) = ⟨last.second, last.third⟩ :=
    Nodup.eq_of_map_eq_of_mem (OrientedEdge.map patch.vertexLabels) unique
      (edge_member firstMember (List.mem_cons_of_mem _ List.mem_cons_self))
      (edge_member lastMember (List.mem_cons_of_mem _ List.mem_cons_self))
      (congrArg (fun triangle => (⟨triangle.second, triangle.third⟩ : Stokes.OrientedEdge vertexCount)) equal)
  change OrientedTriangle.mk first.first first.second first.third = OrientedTriangle.mk last.first last.second
    last.third
  have firstEq : first.first = last.first := congrArg OrientedEdge.start bottom
  have secondEq : first.second = last.second := congrArg OrientedEdge.finish bottom
  have thirdEq : first.third = last.third := congrArg OrientedEdge.finish right
  rw [firstEq, secondEq, thirdEq]

open Purelib.Topology.Surface.Cut.VertexGluing in
/-- Nonloop projected triangle edges identify two triangle corners with the same surface label. -/
private theorem corner_eq_of_projection (patch : Patch.CutPatch faces indices boundary)
    (nonloop : ∀ edge ∈ (patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels),
      edge.start ≠ edge.finish)
    {triangle : Stokes.OrientedTriangle patch.count} (member : triangle ∈ patch.triangles)
    {first last : Fin patch.count} (firstAt : OrientedTriangle.ContainsVertex triangle first) (lastAt :
      OrientedTriangle.ContainsVertex triangle last)
    (equal : patch.vertexLabels first = patch.vertexLabels last) : first = last := by
  have bottom := nonloop _ (Map.mem_map_of_mem (f := OrientedEdge.map patch.vertexLabels)
    (edge_member member (show (⟨triangle.first, triangle.second⟩ : Stokes.OrientedEdge patch.count) ∈
      triangle.boundary from List.mem_cons_self)))
  have right := nonloop _ (Map.mem_map_of_mem (f := OrientedEdge.map patch.vertexLabels)
    (edge_member member (show (⟨triangle.second, triangle.third⟩ : Stokes.OrientedEdge patch.count) ∈
      triangle.boundary from
      List.mem_cons_of_mem _ List.mem_cons_self)))
  have left := nonloop _ (Map.mem_map_of_mem (f := OrientedEdge.map patch.vertexLabels)
    (edge_member member (show (⟨triangle.third, triangle.first⟩ : Stokes.OrientedEdge patch.count) ∈
      triangle.boundary from
      List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self))))
  rcases firstAt with same | same | same <;> subst first <;>
    rcases lastAt with same | same | same <;> subst last
  all_goals first
    | rfl
    | exact (bottom equal).elim
    | exact (bottom equal.symm).elim
    | exact (right equal).elim
    | exact (right equal.symm).elim
    | exact (left equal).elim
    | exact (left equal.symm).elim

/-- Each retained cut triangle projects to one original surface face. -/
private theorem triangle_source (patch : Patch.CutPatch faces indices boundary)
    {triangle : Stokes.OrientedTriangle patch.count} (member : triangle ∈ patch.triangles) :
    ∃ index, OrientedTriangle.map patch.vertexLabels triangle = faces index := by
  have projected := Map.mem_map_of_mem (f := OrientedTriangle.map patch.vertexLabels) member
  rw [patch.triangles_eq] at projected
  obtain ⟨index, _, same⟩ := Map.mem_map.mp projected
  exact ⟨index, same.symm⟩

/-- Complete face coverage supplies a retained cut triangle above each original face. -/
private theorem triangle_above (patch : Patch.CutPatch faces indices boundary) (covers : ∀ index, index ∈ indices)
  (index : Fin faceCount) :
    ∃ triangle ∈ patch.triangles, OrientedTriangle.map patch.vertexLabels triangle = faces index := by
  have member := Map.mem_map_of_mem (f := faces) (covers index)
  rw [← patch.triangles_eq] at member
  exact Map.mem_map.mp member

/-- An original face edge lifts to an edge of a retained cut triangle projecting to that face. -/
private theorem edge_above {patch : Patch.CutPatch faces indices boundary} {triangle : Stokes.OrientedTriangle
  patch.count}
    {index : Fin faceCount} (same : OrientedTriangle.map patch.vertexLabels triangle = faces index)
    {edge : Stokes.OrientedEdge vertexCount} (member : edge ∈ (faces index).boundary) :
    ∃ lifted ∈ triangle.boundary, OrientedEdge.map patch.vertexLabels lifted = edge := by
  rw [← same, OrientedTriangle.boundary_map] at member
  exact Map.mem_map.mp member

open Purelib.Topology.Surface.Cut in
/-- Every retained corner over a specified face and vertex is joined to the chosen cut root. -/
private def CornerProperty (patch : Patch.CutPatch faces indices boundary)
    (pairing : ProjectedEdgePairs.ProjectedEdgePairing patch.vertexLabels patch.boundary)
    (root : Fin patch.count) (vertex : Fin vertexCount) (index : Fin faceCount) : Prop :=
  ∀ triangle ∈ patch.triangles, OrientedTriangle.map patch.vertexLabels triangle = faces index →
    ∀ corner, OrientedTriangle.ContainsVertex triangle corner → patch.vertexLabels corner = vertex →
      PairVertexJoin pairing.pairs root corner

open Purelib.Topology.Surface.Cut.VertexGluing in
/-- Transport the retained corner-joining property across a dual seam at the specified surface vertex. -/
private theorem corner_step (patch : Patch.CutPatch faces indices boundary)
    (pairing : ProjectedEdgePairs.ProjectedEdgePairing patch.vertexLabels patch.boundary)
    (unique : ((patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels)).Nodup)
    (nonloop : ∀ edge ∈ (patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels),
      edge.start ≠ edge.finish)
    (covers : ∀ index, index ∈ indices) (root : Fin patch.count) (vertex : Fin vertexCount)
    {first last : Fin faceCount} (edge : Stokes.OrientedEdge vertexCount)
    (firstMember : edge ∈ (faces first).boundary) (lastMember : edge.reverse ∈ (faces last).boundary)
    (atVertex : vertex = edge.start ∨ vertex = edge.finish)
    (initial : CornerProperty patch pairing root vertex first) : CornerProperty patch pairing root
      vertex last := by
  intro lastTriangle lastTriangleMember lastSame lastCorner lastContains lastLabel
  obtain ⟨firstTriangle, firstTriangleMember, firstSame⟩ := triangle_above patch covers first
  obtain ⟨firstEdge, firstEdgeMember, firstEdgeEq⟩ := edge_above firstSame firstMember
  obtain ⟨lastEdge, lastEdgeMember, lastEdgeEq⟩ := edge_above lastSame lastMember
  have joined := opposite_vertices_joined patch pairing unique
    (edge_member firstTriangleMember firstEdgeMember) (edge_member lastTriangleMember lastEdgeMember)
    (lastEdgeEq.trans (congrArg OrientedEdge.reverse firstEdgeEq.symm))
  rcases atVertex with atStart | atFinish
  · have firstLabel : patch.vertexLabels firstEdge.start = vertex :=
      (congrArg OrientedEdge.start firstEdgeEq).trans atStart.symm
    have lastEndpoint : patch.vertexLabels lastEdge.finish = vertex :=
      (congrArg OrientedEdge.finish lastEdgeEq).trans atStart.symm
    have same := corner_eq_of_projection patch nonloop lastTriangleMember lastContains
      (OrientedTriangle.edge_contains lastEdgeMember (Or.inr rfl)) (lastLabel.trans lastEndpoint.symm)
    rw [same]
    exact (initial firstTriangle firstTriangleMember firstSame firstEdge.start
      (OrientedTriangle.edge_contains firstEdgeMember (Or.inl rfl)) firstLabel).trans joined.1
  · have firstLabel : patch.vertexLabels firstEdge.finish = vertex :=
      (congrArg OrientedEdge.finish firstEdgeEq).trans atFinish.symm
    have lastEndpoint : patch.vertexLabels lastEdge.start = vertex :=
      (congrArg OrientedEdge.start lastEdgeEq).trans atFinish.symm
    have same := corner_eq_of_projection patch nonloop lastTriangleMember lastContains
      (OrientedTriangle.edge_contains lastEdgeMember (Or.inl rfl)) (lastLabel.trans lastEndpoint.symm)
    rw [same]
    exact (initial firstTriangle firstTriangleMember firstSame firstEdge.finish
      (OrientedTriangle.edge_contains firstEdgeMember (Or.inr rfl)) firstLabel).trans joined.2

open Purelib.Topology.Surface.Cut in
open Purelib.Topology.Surface.Cut.VertexGluing in
/-- Every equality of actual surface-vertex labels is generated by the recorded paired endpoints. The common-vertex dual
path is essential. -/
theorem vertices_joined (patch : Patch.CutPatch faces indices boundary)
    (pairing : ProjectedEdgePairs.ProjectedEdgePairing patch.vertexLabels patch.boundary)
    (unique : ((patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels)).Nodup)
    (nonloop : ∀ edge ∈ (patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels),
      edge.start ≠ edge.finish)
    (covers : ∀ index, index ∈ indices) (connected : CornerWalks.VertexConnection faces)
    {firstTriangle lastTriangle : Stokes.OrientedTriangle patch.count}
    (firstMember : firstTriangle ∈ patch.triangles) (lastMember : lastTriangle ∈ patch.triangles)
    {first last : Fin patch.count} (firstAt : OrientedTriangle.ContainsVertex firstTriangle first) (lastAt :
      OrientedTriangle.ContainsVertex lastTriangle last)
    (equal : patch.vertexLabels first = patch.vertexLabels last) : PairVertexJoin pairing.pairs first last
      := by
  obtain ⟨firstSource, firstSame⟩ := triangle_source patch firstMember
  obtain ⟨lastSource, lastSame⟩ := triangle_source patch lastMember
  have firstContains : OrientedTriangle.ContainsVertex (faces firstSource) (patch.vertexLabels first) := firstSame ▸
    ContainsVertex.map firstAt patch.vertexLabels
  have lastContains : OrientedTriangle.ContainsVertex (faces lastSource) (patch.vertexLabels first) :=
    equal.symm ▸ (lastSame ▸ ContainsVertex.map lastAt patch.vertexLabels)
  let route := connected (patch.vertexLabels first) firstSource lastSource firstContains lastContains
  have initial : CornerProperty patch pairing first (patch.vertexLabels first) firstSource := by
    intro triangle member same corner contains projected
    have sameTriangle := triangle_eq_of_projection patch unique member firstMember (same.trans firstSame.symm)
    subst triangle
    have sameCorner := corner_eq_of_projection patch nonloop firstMember firstAt contains projected.symm
    exact sameCorner ▸ PairVertexJoin.refl first
  have final := AtVertex.preserves (CornerProperty patch pairing first (patch.vertexLabels first))
    (corner_step patch pairing unique nonloop covers first (patch.vertexLabels first)) route.val route.property
      initial
  exact final lastTriangle lastMember lastSame last lastAt equal.symm

/-- Only vertices occurring on actual retained triangles are relevant; unused allocation slots in the cut bank need not
satisfy a gluing claim. -/
@[expose]
def ActiveVertex (patch : Patch.CutPatch faces indices boundary) (vertex : Fin patch.count) : Prop :=
  ∃ triangle ∈ patch.triangles, OrientedTriangle.ContainsVertex triangle vertex

open Purelib.Topology.Surface.Cut.VertexGluing in
/-- Each endpoint of an original cut-boundary edge occurs on a retained triangle.

The retained incidence certificate places the boundary edge on an original
triangle, whose endpoint certificate contains the displayed vertex. -/
theorem boundary_vertex_active (patch : Patch.CutPatch faces indices boundary)
    {edge : Stokes.OrientedEdge patch.count} (member : edge ∈ patch.boundary) {vertex : Fin patch.count}
    (atVertex : vertex = edge.start ∨ vertex = edge.finish) : ActiveVertex patch vertex := by
  have original := (EdgeReordering.mem_iff patch.incidence edge).mpr (Membership.mem_append.mpr (Or.inl member))
  obtain ⟨triangle, triangleMember, edgeMember⟩ := Flatten.mem_flatMap.mp original
  exact ⟨triangle, triangleMember, OrientedTriangle.edge_contains edgeMember atVertex⟩

/-- Projecting all cut-triangle incidences recovers the original indexed face-edge lists in order.

The retained triangle identity supplies the original indexed triangles.
Mapping their ordered boundaries preserves the displayed face-edge order. -/
theorem projected_edges (patch : Patch.CutPatch faces indices boundary) :
    (patch.triangles.flatMap OrientedTriangle.boundary).map (OrientedEdge.map patch.vertexLabels) =
      indices.flatMap (fun index => (faces index).boundary) := by
  rw [← SewingProjection.triangleBoundaries_map, patch.triangles_eq, Flatten.flatMap_map]

end CutPatch

namespace SewingForest.SinglePolygon

variable {vertexCount faceCount : Nat} {faces : Fin faceCount → Stokes.OrientedTriangle vertexCount}
  {forest : Sewing.SewingForest faces}

open Purelib.Topology.Surface.Cut in
open Purelib.Topology.Surface.Cut.VertexGluing in
/-- Exact characterization of the actual cut-vertex fibers. All topology premises refer to the original finite mesh and
are discharged by its grid constructor; no quotient or guessed vertex identifications occur. -/
theorem vertexJoin_iff (polygon : SewingForest.SinglePolygon forest)
    (unique : (Stokes.triangleEdgeOccurrences faces).Nodup)
    (nonloop : ∀ edge ∈ Stokes.triangleEdgeOccurrences faces, edge.start ≠ edge.finish)
    (connected : CornerWalks.VertexConnection faces)
    (pairing : ProjectedEdgePairs.ProjectedEdgePairing polygon.patch.cut.vertexLabels polygon.patch.cut.boundary)
    {first last : Fin polygon.patch.cut.count}
    (firstActive : CutPatch.ActiveVertex polygon.patch.cut first) (lastActive : CutPatch.ActiveVertex polygon.patch.cut
      last) :
    PairVertexJoin pairing.pairs first last ↔ polygon.patch.cut.vertexLabels first =
      polygon.patch.cut.vertexLabels last := by
  refine ⟨PairVertexJoin.projected, ?_⟩
  intro equal
  obtain ⟨firstTriangle, firstMember, firstAt⟩ := firstActive
  obtain ⟨lastTriangle, lastMember, lastAt⟩ := lastActive
  have cutUnique : ((polygon.patch.cut.triangles.flatMap OrientedTriangle.boundary).map
      (OrientedEdge.map polygon.patch.cut.vertexLabels)).Nodup := by
    rw [CutPatch.projected_edges polygon.patch.cut]
    exact SinglePolygon.originalEdges_unique polygon unique
  have cutNonloop : ∀ edge ∈ (polygon.patch.cut.triangles.flatMap OrientedTriangle.boundary).map
      (OrientedEdge.map polygon.patch.cut.vertexLabels), edge.start ≠ edge.finish := by
    rw [CutPatch.projected_edges polygon.patch.cut]
    intro edge member
    exact nonloop edge ((List.Permutation.mem_iff (SinglePolygon.originalEdges_coverage polygon) edge).mp member)
  exact CutPatch.vertices_joined polygon.patch.cut pairing cutUnique cutNonloop
    (fun index => (List.Permutation.mem_iff polygon.coverage index).mpr
      (List.Permutation.ofFn_mem _ index)) connected firstMember lastMember firstAt lastAt equal

end SewingForest.SinglePolygon
end
end Purelib.Topology.Surface.Cut.VertexGluing
