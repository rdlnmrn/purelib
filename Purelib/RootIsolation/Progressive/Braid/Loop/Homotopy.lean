section
@[expose] public section

/-!
# A finite braid theorem for certified rational polynomial loops

An admissible loop here is exactly the finite data required by the theorem:
rational coefficient tables in certified simple-root chambers, finite Rouché
overlaps between successive tables, rational projection-order root boxes, and
an atomic stationary/crossing certificate for every subdivision cell.  No
completed coefficient path or configuration space is part of the input.

The headline extraction is executable.  It returns the folded Artin word and
proves, in the endpoint projection coordinates, that the word permutation is
the persistent-root monodromy.  Concatenation is word multiplication;
operational refinement leaves the word unchanged; and a finite chain of
refinement and Artin moves preserves the braid class, endpoint transport, and
writhe.
-/

namespace Purelib.RootIsolation.Progressive.Braid.Loop.Homotopy

/-! ## Refinement and finite homotopy -/

/-- A loopwise application of the operational subdivision relation. -/
structure LoopRefinement {strands : Nat}
    {base : ProjectedFrame strands}
    (coarse fine : AdmissibleLoop base) where
  /-- The actual event-preserving refinement between the original based projected paths. -/ pathRefinement :
    RootIsolation.Progressive.Braid.Projected.Refinement coarse.path fine.path

namespace LoopRefinement

/-- An event-preserving refinement of a retained projected loop leaves its extracted word unchanged. -/
theorem word_eq {strands : Nat}
    {base : ProjectedFrame strands} {coarse fine :
      AdmissibleLoop base}
    (refinement : Progressive.Braid.Loop.Homotopy.LoopRefinement coarse fine) : coarse.word = fine.word := by
  exact refinement.pathRefinement.word_eq

end LoopRefinement

/-- Finite admissible homotopy certificates are generated by operational
subdivision and by a displayed finite Artin-equivalence proof between two
certified projected loops.  Symmetry and transitivity retain the actual
finite proof chain. -/
inductive Homotopic {strands : Nat} {base :
  ProjectedFrame strands} :
    AdmissibleLoop base → AdmissibleLoop base → Prop
  /-- An actual event-preserving subdivision relates the original coarse and refined based loops. -/ | refinement
    {coarse fine : AdmissibleLoop base}
      (certificate : LoopRefinement coarse fine) :
        Homotopic coarse fine
  /-- A retained finite Artin equivalence relates the original projected loop words. -/ | artin {left right :
    AdmissibleLoop base}
      (relation : Progressive.Braid.Projected.Artin.BraidClassSame left.path right.path) :
        Homotopic left right
  /-- A retained based loop is homotopic to itself. -/ | refl (loop : AdmissibleLoop base)
    : Homotopic loop loop
  /-- Reverse the retained finite homotopy between the original loops. -/ | symm {left right :
    AdmissibleLoop base}
      (homotopy : Homotopic left right) :
        Homotopic right left
  /-- Compose the retained finite homotopies through their exact common based loop. -/ | trans {first second third :
    AdmissibleLoop base}
      (firstSecond : Homotopic first second)
      (secondThird : Homotopic second third) :
        Homotopic first third

namespace Homotopic

/-- A certified loop followed by its explicitly reversed rational path
contracts by the finite sequence of adjacent cancellation moves. -/
theorem append_reverse {strands : Nat} {base :
  ProjectedFrame strands}
    (loop : AdmissibleLoop base) :
    Progressive.Braid.Loop.Homotopy.Homotopic (loop.append loop.reverse)
      (AdmissibleLoop.identity base) := by
  apply Progressive.Braid.Loop.Homotopy.Homotopic.artin
  unfold Progressive.Braid.Projected.Artin.BraidClassSame
  change Equivalent
    (loop.append loop.reverse).word (AdmissibleLoop.identity base).word
  rw [AdmissibleLoop.append_word, AdmissibleLoop.reverse_word,
    AdmissibleLoop.identity_word]
  exact Equivalent.append_inverse loop.word

/-- A displayed elementary Artin rewrite gives a finite homotopy between the retained based loops. -/
theorem ofRewrite {strands : Nat} {base :
  ProjectedFrame strands}
    {left right : AdmissibleLoop base}
    (rewrite : Rewrite left.word right.word) :
    Progressive.Braid.Loop.Homotopy.Homotopic left right :=
  .artin (.step rewrite)

/-- A certified polynomial path followed by the oppositely signed crossing
admits the finite cancellation homotopy. -/
theorem cancellation {strands : Nat} {base :
  ProjectedFrame strands}
    {left right : AdmissibleLoop base}
    (before after : Word strands) (generator : Topology.Knot.Braid.Generator strands)
    (leftWord : left.word =
      before ++ [generator, generator.reverse] ++ after)
    (rightWord : right.word = before ++ after) : Progressive.Braid.Loop.Homotopy.Homotopic left right := by
  apply Progressive.Braid.Loop.Homotopy.Homotopic.ofRewrite
  rw [leftWord, rightWord]
  exact Rewrite.cancel before after generator

/-- Crossings supported on disjoint pairs are exchanged by a finite
far-commutation homotopy. -/
theorem farCommutation {strands : Nat} {base :
  ProjectedFrame strands}
    {left right : AdmissibleLoop base}
    (before after : Word strands) (first second : Topology.Knot.Braid.Generator strands)
    (separated : first.index.val + 1 < second.index.val ∨
      second.index.val + 1 < first.index.val)
    (leftWord : left.word = before ++ [first, second] ++ after)
    (rightWord : right.word = before ++ [second, first] ++ after) :
    Progressive.Braid.Loop.Homotopy.Homotopic left right := by
  apply Progressive.Braid.Loop.Homotopy.Homotopic.ofRewrite
  rw [leftWord, rightWord]
  exact Rewrite.far
    before after first second separated

/-- The standard three-strand Artin relation is a finite admissible
polynomial-loop homotopy whenever the two displayed certified loop rows have
the corresponding boundary words. -/
theorem artinRelation {strands : Nat} {base :
  ProjectedFrame strands}
    {left right : AdmissibleLoop base}
    (before after : Word strands) (index : Fin (strands - 2))
    (sign : Topology.Knot.Braid.CrossingSign)
    (leftWord : left.word =
      before ++
        [Topology.Knot.Braid.Artin.Generator.lower index sign,
          Topology.Knot.Braid.Artin.Generator.upper index sign,
          Topology.Knot.Braid.Artin.Generator.lower index sign] ++ after)
    (rightWord : right.word =
      before ++
        [Topology.Knot.Braid.Artin.Generator.upper index sign,
          Topology.Knot.Braid.Artin.Generator.lower index sign,
          Topology.Knot.Braid.Artin.Generator.upper index sign] ++ after) :
    Progressive.Braid.Loop.Homotopy.Homotopic left right := by
  apply Progressive.Braid.Loop.Homotopy.Homotopic.ofRewrite
  rw [leftWord, rightWord]
  exact Rewrite.artin before after index sign

/-- Certified finite homotopies preserve the extracted Artin braid class. -/
theorem braidClassSame {strands : Nat}
    {base : ProjectedFrame strands} {left right :
      AdmissibleLoop base}
    (homotopy : Progressive.Braid.Loop.Homotopy.Homotopic left right) :
    Equivalent left.word right.word := by
  induction homotopy with
  | refinement certificate =>
      rw [certificate.word_eq]
      exact .refl _
  | artin relation => exact relation
  | refl loop => exact .refl _
  | symm homotopy inductionHypothesis => exact .symm inductionHypothesis
  | trans firstSecond secondThird firstHypothesis secondHypothesis =>
      exact .trans firstHypothesis secondHypothesis

/-- Finite certified homotopy preserves the extracted loop writhe. -/
theorem writhe_eq {strands : Nat}
    {base : ProjectedFrame strands} {left right :
      AdmissibleLoop base}
    (homotopy : Progressive.Braid.Loop.Homotopy.Homotopic left right) :
    left.word.writhe = right.word.writhe :=
  homotopy.braidClassSame.writhe_eq

/-- Concatenation respects finite admissible homotopy. -/
theorem append {strands : Nat}
    {base : ProjectedFrame strands}
    {firstLeft firstRight secondLeft secondRight : AdmissibleLoop base}
    (first : Progressive.Braid.Loop.Homotopy.Homotopic firstLeft firstRight)
    (second : Progressive.Braid.Loop.Homotopy.Homotopic secondLeft secondRight) :
    Equivalent
      (firstLeft.append secondLeft).word
      (firstRight.append secondRight).word := by
  rw [AdmissibleLoop.append_word, AdmissibleLoop.append_word]
  exact Equivalent.append
    first.braidClassSame second.braidClassSame

end Homotopic

end Purelib.RootIsolation.Progressive.Braid.Loop.Homotopy

end
