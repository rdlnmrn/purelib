module
public import Purelib.Polynomial.Ascending.Integer.Basic

open Purelib.Polynomial.Ascending.Integer.Basic (CoefficientList)

open Purelib.Polynomial

section
@[expose] public section

/-!
# Executable torus-knot genus and Alexander data

This file supplies finite integer-polynomial and positive-braid surface
certificates for the torus family.  Polynomial coefficients are stored in
low-to-high order.  Equality is coefficientwise over one explicit finite
bound, so concrete certificates reduce by kernel computation.

The Alexander candidate uses the numerical semigroup generated by `p` and
`q`: below the conductor `(p-1)(q-1)`, its coefficient at `n` is the change
in the semigroup-membership indicator from `n-1` to `n`.  A certificate checks
the familiar exact identity

`Delta(t) (1-t^p) (1-t^q) = (1-t^(pq)) (1-t)`.

No completed Laurent series or quotient field is constructed.
-/

section

/-! ## Finite integer polynomials -/

section

namespace Purelib.Polynomial.Ascending.Integer.Comparison

/-- Executable check that a displayed coefficient tail is entirely zero. -/
def allZero :
  CoefficientList → Bool
  | [] => true
  | coefficient :: remaining =>
      decide (coefficient = 0) && allZero remaining

/-- Executable coefficientwise equality, ignoring only trailing zeros. -/
def same? : CoefficientList →
  CoefficientList → Bool
  | [], right => Ascending.Integer.Comparison.allZero right
  | left :: leftTail, [] => decide (left = 0) && Ascending.Integer.Comparison.allZero leftTail
  | left :: leftTail, right :: rightTail =>
      decide (left = right) && same? leftTail rightTail

/-- The executable coefficientwise comparison returns true, allowing trailing zeros. -/
def Same (left right :
  CoefficientList) : Prop
  := Ascending.Integer.Comparison.same? left right = true

/-- An integer coefficient table compares equal to itself. -/
theorem same?_self (polynomial :
  CoefficientList) :
    Ascending.Integer.Comparison.same? polynomial polynomial = true := by
  induction polynomial with
  | nil =>
      unfold Ascending.Integer.Comparison.same?
      rfl
  | cons head tail inductionHypothesis =>
      rw [Ascending.Integer.Comparison.same?, decide_eq_true rfl, inductionHypothesis]
      rfl

/-- Coefficient-table comparison is reflexive. -/
theorem same_refl (polynomial :
  CoefficientList) : Same polynomial polynomial :=
  same?_self polynomial

/-- Decide coefficient-table equality using the retained Boolean comparison. -/
instance decidableSame (left right :
  CoefficientList) : Decidable (Same left right) :=
  by
    unfold Same
    infer_instance

/-- Reverse the displayed integer coefficient order without trimming zeros. -/
def reverseCoefficients (polynomial :
  CoefficientList) : CoefficientList :=
  polynomial.reverse

/-- The displayed integer coefficient list equals its reversal. -/
def Symmetric (polynomial :
  CoefficientList) :
  Prop :=
  polynomial.reverse = polynomial

/-- Decide symmetry by literal equality with the reversed coefficient list. -/
instance decidableSymmetric (polynomial :
  CoefficientList) :
    Decidable (Symmetric polynomial) := by
  unfold Symmetric
  infer_instance

end Purelib.Polynomial.Ascending.Integer.Comparison

end
end

