module

meta import Purelib.Elab.ConstructiveInjectivity
import Purelib.Data.Gaussian.Basic
import Purelib.Data.Rat.Interval.Basic
import Purelib.Polynomial.Clearance.Pair.Cover.Retained
import Purelib.Polynomial.Dense.Gaussian.Basic
public import Purelib.Polynomial.Dense.Gaussian.Path.Bounds.Basic

public import Purelib.Polynomial.Geometry.PolynomialClearanceDiagnostics
import Purelib.Data.Rat.Fraction
import Purelib.Data.Rat.Fraction.Arithmetic
import Purelib.Data.Rat.Fraction.Order.Basic
import Purelib.Polynomial.Clearance.Pair.Cover.Prepare

/-!
# Inconclusive path-bound certificates

The original coefficients, affine path and cached coarse bounds remain in
`Data`.  A refined failure additionally retains the exact finite attempt and
all unresolved leaf data.  A coarse-only result is explicitly a preflight
failure with no refinement attempt, not an exhausted search or a root claim.
Exact geometric obstructions are classified separately by the path client.
-/

namespace Purelib.Polynomial.Dense.Gaussian.Path.Bounds.Basic.Data

open Purelib.Data.Gaussian
open Purelib.Data.Gaussian.Basic (Canonical)

open Purelib
open Purelib.Data
open Purelib.Data.Rat
open Purelib.Polynomial
open Purelib.Geometry.Rational

variable {polynomial : Basic.CanonicalCoefficients.CoefficientPolynomial} {origin direction : Canonical} {interval :
  Data.Rat.Interval.Bounds}

set_option genInjectivity false in
/-- Retained evidence that a path-bound attempt has no positive lower bound.

The record retains the actual finite attempt, its complete snapshot list and exactly the nonpositive-floor filter. Exact
equalities link both cached lists to that same run. -/
public inductive Inconclusive (data : Dense.Gaussian.Path.Bounds.Basic.Data polynomial origin direction interval) where
  /-- The coarse lower bound is nonpositive and no refinement attempt is cached. -/ | preflight (nonpositive :
    data.lowerBound ≤ 0) (notAttempted : data.clearance = none)
  /-- Retain a failed refinement report for the exact cached attempt. -/ | exhausted (nonpositive : data.lowerBound ≤ 0)
      (report : Geometry.PolynomialClearanceCover.Inconclusive data.realPolynomial data.imagPolynomial interval)
      (retained : data.clearance = some report.attempted)

constructive_injectivity Inconclusive

/-- Build the diagnostic from retained data, not a second refinement run.
The proof argument is generated by the caller's failed numeric comparison.

The original optional-attempt branch determines whether refinement was attempted. A present cached attempt is packaged
with its exact failure report, without running refinement again. -/
@[expose] public def inconclusiveCertificate (data : Dense.Gaussian.Path.Bounds.Basic.Data polynomial origin direction
  interval) (nonpositive : data.lowerBound ≤ 0) :
    data.Inconclusive :=
  match retained : data.clearance with
  | none => .preflight nonpositive retained
  | some attempted =>
      have failed : attempted.result.normFloor ≤ 0 := by
        have bound : Clearance.Pair.Cover.Retained.optionalNorm data.clearance ≤ data.lowerBound := by
          rw [data.lowerBound_eq]
          exact Fraction.Order.Basic.le_max_right _ _
        rw [retained] at bound
        exact bound.trans nonpositive
      .exhausted nonpositive (Geometry.PolynomialClearanceCover.Inconclusive.ofAttempt attempted failed) retained

namespace Inconclusive

variable {data : Dense.Gaussian.Path.Bounds.Basic.Data polynomial origin direction interval}

/-- Every inconclusive certificate proves its retained lower bound is nonpositive.

Both diagnostic constructors retain a certificate for the same data lower bound. Constructor elimination reads that
supplied evidence. -/
public theorem nonpositive (certificate : data.Inconclusive) : data.lowerBound ≤ 0 := by
  cases certificate with
  | preflight failed _ => exact failed
  | exhausted failed _ _ => exact failed

/-- Read the retained attempt's budget, or zero when refinement was not attempted.

Preflight records zero because no refinement attempt was retained. An exhausted result projects the exact budget of its
cached attempted run. -/
@[expose] public def budget (certificate : data.Inconclusive) : Nat :=
  match certificate with
  | .preflight .. => 0
  | .exhausted _ report _ => report.attempted.budget

/-- The coarse stage has one unresolved interval.  A refinement report
lists exactly its failed leaves; it does not replace them by their hull.

Preflight retains the supplied interval once. An exhausted result projects all cached failed-leaf intervals in their
original occurrence order. -/
@[expose] public def unresolvedIntervals (certificate : data.Inconclusive) : List Data.Rat.Interval.Bounds :=
  match certificate with
  | .preflight .. => [interval]
  | .exhausted _ report _ => report.unresolved.map (·.parameters)

/-- An inconclusive result retains at least one unresolved interval.

The nonpositive aggregate floor supplies an explicit failed snapshot. Exact filter membership places that same witness
in the cached unresolved list. -/
public theorem unresolved_nonempty (certificate : data.Inconclusive) : certificate.unresolvedIntervals ≠ [] := by
  cases certificate with
  | preflight failed notAttempted => exact List.cons_ne_nil _ _
  | exhausted failed report retained =>
      intro empty
      exact report.unresolved_nonempty (List.map_eq_nil_iff.mp empty)

end Inconclusive

end Purelib.Polynomial.Dense.Gaussian.Path.Bounds.Basic.Data
