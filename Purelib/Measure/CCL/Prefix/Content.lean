section
public section

/-!
# Joint finite profile of a completed CCL prefix

A completed-block prefix carries two deliberately separate rational data:

* its fair-bit symbolic cylinder weight, calculated from the raw word; and
* its geometric squared-chordal spread, calculated from block contraction.

Both improve under finite extension, but no theorem identifies them.  A
finite realization certificate also turns the prefix into an inhabited
finite observation, without choosing a point from an eventual intersection.
-/

namespace Purelib.Measure.CCL.Prefix

open Purelib.Data in
open Purelib.Data.CCL.Encoding in
open Purelib.Data.Rat in
/-- The dyadic weight of the exact binary word encoded by the completed block prefix. -/
@[expose] def completedPrefixWeight (blocks : List Data.CCL.Encoding.Block) :
  Fraction.Rational :=
  List.BinaryPrefix.rawPrefixWeight (Block.Basic.rawWord blocks)

open Purelib.Data in
open Purelib.Data.CCL.Encoding in
/-- The binary cylinder event generated by the completed block prefix's exact raw word. -/
@[expose] def completedPrefixEvent (blocks : List Data.CCL.Encoding.Block) :
  RawEvent :=
  RawEvent.ofPrefix (Block.Basic.rawWord blocks)

open Purelib in
open Purelib.Data in
open Purelib.Data.CCL.Encoding in
open Purelib.Measure in
/-- Enumerate weighted binary extensions of the completed prefix at the supplied additional depth. -/
@[expose] def completedPrefixExtensionContent (blocks : List Data.CCL.Encoding.Block)
  (depth
  : Nat) :
    Measure.Content List.BinaryPrefix.CCLMeasureWord :=
  BinaryPrefix.rawExtensionContent (Block.Basic.rawWord blocks) depth

open Purelib.Data.CCL.Encoding in
open Purelib.Measure in
/-- The extension content's total weight equals the original completed-prefix weight. -/
theorem completedPrefixExtensionContent_total
    (blocks : List Data.CCL.Encoding.Block) (depth : Nat) :
    (completedPrefixExtensionContent blocks depth).total =
      completedPrefixWeight blocks :=
  BinaryPrefix.rawExtensionContent_total (Block.Basic.rawWord blocks) depth

section
open Purelib.Data
open Purelib.Data.CCL.Encoding
open Purelib.Measure
/-- The completed-prefix event has exactly the original raw-word weight. -/
theorem completedPrefixEvent_weight (blocks : List Data.CCL.Encoding.Block) :
    (completedPrefixEvent blocks).weight = completedPrefixWeight blocks := by
  exact RawEvent.ofPrefix_weight (Block.Basic.rawWord blocks)

/-- Every binary suffix appended to the completed prefix is classified inside its event. -/
theorem completedPrefixEvent_classifies_append (blocks : List Data.CCL.Encoding.Block)
    (suffix : List.BinaryPrefix.CCLMeasureWord) :
    (completedPrefixEvent blocks).classify
        (Block.Basic.rawWord blocks ++ suffix) =
      Status.inside :=
  RawEvent.ofPrefix_classify_append (Block.Basic.rawWord blocks) suffix

end

open Purelib in
open Purelib.Data in
open Purelib.Data.CCL.Encoding in
open Purelib.Data.Rat in
open Purelib.Measure in
/-- The completed-prefix event's terminal frontier bounds its weight by the exact singleton interval. -/
theorem completedPrefixEvent_eventBound (blocks : List Data.CCL.Encoding.Block) :
    Measure.eventBound
        (completedPrefixEvent blocks).terminalFrontier =
      Interval.exact (completedPrefixWeight blocks) := by
  rw [RawEvent.terminalFrontier_eventBound,
    completedPrefixEvent_weight]

section
open Purelib.Data
open Purelib.Data.CCL.Encoding
open Purelib.Measure
/-- Every completed-prefix weight is nonnegative. -/
theorem completedPrefixWeight_nonneg (blocks : List Data.CCL.Encoding.Block) :
    0 ≤ completedPrefixWeight blocks :=
  List.BinaryPrefix.rawPrefixWeight_nonneg _

/-- Every completed-prefix weight is strictly positive. -/
theorem completedPrefixWeight_pos (blocks : List Data.CCL.Encoding.Block) :
    0 < completedPrefixWeight blocks :=
  List.BinaryPrefix.rawPrefixWeight_pos _

/-- Concatenating block prefixes multiplies their exact dyadic weights. -/
theorem completedPrefixWeight_append (stem suffix : List Data.CCL.Encoding.Block) :
    completedPrefixWeight (stem ++ suffix) =
      completedPrefixWeight stem * completedPrefixWeight suffix := by
  simp only [-eq_self, -iff_self, completedPrefixWeight, Cylinder.rawWord_append,
    List.BinaryPrefix.rawPrefixWeight_append]; try rfl

/-- Appending blocks cannot increase a completed prefix's weight. -/
theorem completedPrefixWeight_le_of_append (stem suffix : List
  Data.CCL.Encoding.Block) :
    completedPrefixWeight (stem ++ suffix) ≤
      completedPrefixWeight stem := by
  apply List.BinaryPrefix.rawPrefixWeight_le_of_prefix
  exact ⟨Block.Basic.rawWord suffix, (Cylinder.rawWord_append stem suffix).symm⟩
end

end Purelib.Measure.CCL.Prefix

