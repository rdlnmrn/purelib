/-- The run's cached maximum inherits the physical width cap, including zero-width owner junctions. No source samples
are recomputed. -/
theorem ReverseSourceRun.ofChain_width_le
    (fragments : List (OwnedFragments.OwnedFragment (originals := originals) (coefficients := coefficients) data))
    (chain : ReverseSourceChains.ReverseSourceChain fragments 1 0) {width : InverseRootPolynomial.Coordinate}
      (nonnegative : 0 ≤ width)
    (bounded : ∀ fragment ∈ fragments, fragment.reverseSourceWidth ≤ width) :
    (ReverseSourceRun.ofChain (acquired := acquired) fragments chain).width ≤ width := by
  change PairedFragmentBlocks.maximum OwnedFragment.reverseSourceWidth fragments ≤ width
  clear chain
  induction fragments with
  | nil => exact nonnegative
  | cons first rest ih =>
      exact Data.Rat.Fraction.Order.Basic.max_le (bounded first List.mem_cons_self)
        (ih (fun fragment member => bounded fragment (List.mem_cons_of_mem _ member)))

end Purelib.Curves.Hyperelliptic.Meshes.PuncturedGrid.Exterior.Basis.ReverseSourceRuns
