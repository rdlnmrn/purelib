/-- Any value function telescopes along the retained root-coordinate chain. -/
theorem Segment.value_total (values : InverseRootPolynomial.Gaussian → InverseRootPolynomial.Gaussian)
    (segments : List (VertexPaths.Segment regular model sample target floor stage))
    {first last : InverseRootPolynomial.Gaussian} (chain : Segment.From first segments last) :
    Data.Gaussian.Norm.Sum.Basic.gaussianSum (segments.map (fun segment => values segment.last.root.coordinate -
      values segment.first.root.coordinate)) =
      values last - values first := by
  induction segments generalizing first with
  | nil => change first = last at chain; rw [chain]; change (0 : InverseRootPolynomial.Gaussian) = _ - _; ring1
  | cons head tail ih =>
      change first = head.first.root.coordinate ∧ Segment.From head.last.root.coordinate tail last at chain
      change values head.last.root.coordinate - values head.first.root.coordinate +
        Data.Gaussian.Norm.Sum.Basic.gaussianSum (tail.map (fun segment => values segment.last.root.coordinate -
          values segment.first.root.coordinate)) = _
      rw [ih chain.2, chain.1]
      ring1

end Purelib.Curves.Hyperelliptic.Charts.Reciprocal.Disk.ChartBasisPath
