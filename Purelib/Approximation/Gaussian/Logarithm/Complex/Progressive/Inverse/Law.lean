/-!
# Finite coherence of progressive transcendental outputs

The local exponential and logarithm algorithms first build limit-free
`Approximation` sidechannels.  Their CCL processes are therefore coherent by
construction.  This module propagates that certificate through global dyadic
range reduction, repeated squaring, and the finite correction arithmetic.

These are statements about every finite rational process branch.  They do not
assert that a completed exponential or logarithm value has been selected.
-/

/-- The actual total exponential of a coherent local complex-log name reaches the explicit diagonal finite exp-log
program. -/
@[expose] def automaticExpLocalComplexLog_toDynamic (input : Gaussian.Name.Basic.Named)
    (disk : Domain.Disk input) :
    Gaussian.Equivalence.NamedEquivalent
      (Exponential.Progressive.Range.Name.named
        (Name.named input disk))
      (Diagonal.dynamicLocalExpLogApproximation input disk).toNamed :=
  NamedEquivalent.trans
    (Exponential.Progressive.Range.Congruence.automaticExp_toLocal
      { name := Name.named input disk
        coherent := Coherent.localComplexLogCoherent input disk }
      (Domain.localComplexLogUnitDisk input disk))
    (NamedEquivalent.symm
      (Reindex.dynamicLocalExpLog_toLocalExp input disk))

/-- The actual total exponential of the progressive local logarithm is the productive CCL name generated by exact
rational Möbius reconstruction of its finite reduced readings. -/
@[expose] def automaticExpLocalComplexLog_toChart (input : Gaussian.Name.Basic.Named)
    (disk : Domain.Disk input) :
    Gaussian.Equivalence.NamedEquivalent
      (Exponential.Progressive.Range.Name.named
        (Name.named input disk))
      (Reconstruction.dynamicLocalExpLogChartApproximation input disk).toNamed :=
  NamedEquivalent.trans
    (Approximation.Gaussian.Logarithm.Complex.Progressive.Inverse.Law.automaticExpLocalComplexLog_toDynamic input disk)
    (Equivalence.dynamicLocalExpLog_chart_named_equivalent input disk)

/-- Multiplying the actual total local-log exponential by one displayed rational factor reaches the pointwise scaled
Möbius reconstruction program.

This packages every analytic and multiplication-resampling step; only the algebraic relation between the chart's reduced
input and its original input remains to identify a full logarithm inverse. -/
@[expose] def automaticExpLocalComplexLog_mulExact_toScaledChart (input : Gaussian.Name.Basic.Named)
    (disk : Domain.Disk input)
    (factor : Data.Gaussian.Basic.Canonical) :
    Gaussian.Equivalence.NamedEquivalent
      (Named.mul
        (Exponential.Progressive.Range.Name.named
          (Name.named input disk))
        (Named.exact factor))
      (Scale.scaledDynamicLocalExpLogChartApproximation input disk factor).toNamed :=
  by
    let actualLeft : Coherent.CoherentNamed :=
      { name := Exponential.Progressive.Range.Name.named
          (Name.named input disk)
        coherent := Exponential.Progressive.Range.Coherent.expNamedCoherent
          (Name.named input disk) }
    let chartedLeft :=
      CoherentNamed.ofApproximation
        (Reconstruction.dynamicLocalExpLogChartApproximation input disk)
    let exactRight :=
      Coherence.exact factor
    let constantRight :=
      CoherentNamed.ofApproximation
        (Constant.constantApproximation factor)
    have productsEquivalent : Gaussian.Equivalence.NamedEquivalent
        (Named.mul
          actualLeft.name exactRight.name)
        (Named.mul
          chartedLeft.name constantRight.name) :=
      Congruence.coherentMul_respects actualLeft chartedLeft exactRight constantRight
        (Approximation.Gaussian.Logarithm.Complex.Progressive.Inverse.Law.automaticExpLocalComplexLog_toChart input
          disk)
        (Exact.exact_toConstantNamed factor)
    have pointwiseBridge : Gaussian.Equivalence.NamedEquivalent
        (Named.mul
          (Reconstruction.dynamicLocalExpLogChartApproximation input disk).toNamed
          (Constant.constantApproximation
            factor).toNamed)
        (Scale.scaledDynamicLocalExpLogChartApproximation input disk factor).toNamed :=
      Bridge.mulToNamed_equivalent_pointwise
        (Reconstruction.dynamicLocalExpLogChartApproximation input disk)
        (Constant.constantApproximation factor)
        (Scale.scaledDynamicLocalExpLogChartApproximation input disk factor)
        (Scale.scaledDynamicLocalExpLogChartApproximation_sample input disk factor)
    exact NamedEquivalent.trans
      (middle := Named.mul chartedLeft.name constantRight.name)
      (by
          simpa only [actualLeft, exactRight, Coherence.exact]
            using productsEquivalent)
      (by
          simpa only [chartedLeft, constantRight, CoherentNamed.ofApproximation]
            using pointwiseBridge)

end

end Purelib.Approximation.Gaussian.Logarithm.Complex.Progressive.Inverse.Law
