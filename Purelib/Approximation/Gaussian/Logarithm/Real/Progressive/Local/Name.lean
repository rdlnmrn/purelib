/-!
# Local logarithm as a CCL computation

This is the local core of logarithm as a CCL-to-CCL computation.  The input is
an arithmetic CCL name carrying an explicit overlapping chart certificate.
Every candidate is a displayed real Gaussian rational whose coordinate lies
in `[1/2,2]`.  The output synchronizes later finite input witnesses with later
finite Horner depths, packages the result as an accuracy sidechannel, and
starts the unchanged productive CCL controller on it.  It does not assert a
completed positive real input or a completed logarithm.
-/

namespace Purelib.Approximation.Gaussian.Logarithm.Real.Progressive.Local.Name

/-- Compute the local real-logarithm sample from the certified chart's finite input sample and matching depth. -/
def domainSample (input :
  Named) (chart : Domain.Chart input) (index : Nat) : Data.Gaussian.Basic.Canonical :=
  Sample.sampleFrom (Sequence.chartSamples input chart) index

/-- Later chart logarithm samples remain within the earlier index's geometric squared-error radius. -/
theorem domainSample_later_close {input :
  Named} (chart : Domain.Chart input)
    {oldIndex newIndex : Nat} (indexOrder : oldIndex ≤ newIndex) :
    Data.Gaussian.Norm.Basic.normSq
      (Sample.sampleFrom (Sequence.chartSamples input chart) newIndex -
        Sample.sampleFrom (Sequence.chartSamples input chart) oldIndex) ≤
      Geometric.Basic.quarterRadius Sample.errorScale oldIndex :=
  Sample.sampleFrom_later_close (Sequence.chartSamples input chart) indexOrder

/-- Every chart logarithm sample has squared norm at most four. -/
theorem domainSample_bounded {input :
  Named} (chart : Domain.Chart input)
    (index : Nat) :
    Data.Gaussian.Norm.Basic.normSq (domainSample
      input chart index) ≤ 4 :=
  Sample.sample_bounded
    (Sampling.inputSample_half chart index) (Sampling.inputSample_two chart index) index

/-- Package the chart's finite logarithm samples with their geometric error, executable refinement search and uniform
norm bound. -/
def approximation (input :
  Named) (chart : Domain.Chart input) : ApproximationData where
  sample := domainSample input chart
  radiusSq := Geometric.Basic.quarterRadius Sample.errorScale
  radiusSq_nonneg index :=
    Geometric.Basic.quarterRadius_nonneg Sample.errorScale_nonneg index
  later_close := domainSample_later_close chart
  refineIndex current target _ :=
    Search.firstQuarterBelow Sample.errorScale current target
  refineIndex_ge current target _ :=
    Search.firstQuarterBelow_ge Sample.errorScale current target
  refineIndex_accurate :=
    Search.firstQuarterBelow_accurate Sample.errorScale
      Sample.errorScale_nonneg
  centerBound := 4
  centerBound_nonneg := by decide
  sample_bounded := domainSample_bounded chart

/-- Start the productive name generated by the certified local real-logarithm approximation. -/
def named (input :
  Named) (chart : Domain.Chart input) : Named :=
  (approximation input chart).toNamed
end Purelib.Approximation.Gaussian.Logarithm.Real.Progressive.Local.Name

end
