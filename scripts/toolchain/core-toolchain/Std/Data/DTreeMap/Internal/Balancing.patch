 theorem BalancedAtRoot.adjust_left {l l' r : Nat} : BalancedAtRoot l r → l - 1 ≤ l' → l' ≤ l + 1 →
-    BalanceLErasePrecond l' r ∨ BalanceLErasePrecond r l' := by tree_tac
+    BalanceLErasePrecond l' r ∨ BalanceLErasePrecond r l' := by
+  intro balanced lower upper
+  by_cases same : l' = l
+  · subst l'
+    exact Or.inl (Or.inr (Or.inr balanced))
+  · by_cases smaller : l' < l
+    · have step : l' + 1 = l := by
+        cases l with
+        | zero => exact False.elim (Nat.not_lt_zero _ smaller)
+        | succ n =>
+          change n ≤ l' at lower
+          exact congrArg Nat.succ (Nat.le_antisymm (Nat.le_of_lt_succ smaller) lower)
+      exact Or.inr (Or.inr (Or.inl (step.symm ▸ balanced.symm)))
+    · have step : l' = l + 1 := Nat.le_antisymm upper
+        (Nat.succ_le_of_lt (Nat.lt_of_le_of_ne (Nat.le_of_not_gt smaller) (Ne.symm same)))
+      subst l'
+      have increased : BalancedAtRoot (l + 1) (r + 1) := by
+        change l + 1 + (r + 1) ≤ 1 ∨ (l + 1 ≤ 3 * (r + 1) ∧ r + 1 ≤ 3 * (l + 1))
+        apply Or.inr
+        change l + r ≤ 1 ∨ (l ≤ 3 * r ∧ r ≤ 3 * l) at balanced
+        rcases balanced with small | large
+        · have hl := Nat.le_trans (Nat.le_add_right l r) small
+          have hr := Nat.le_trans (Nat.le_add_left r l) small
+          constructor
+          · exact Nat.le_trans (Nat.add_le_add_right hl 1)
+              (Nat.le_trans (by decide : 2 ≤ 3)
+                (Nat.mul_le_mul_left 3 (Nat.succ_le_succ (Nat.zero_le r))))
+          · exact Nat.le_trans (Nat.add_le_add_right hr 1)
+              (Nat.le_trans (by decide : 2 ≤ 3)
+                (Nat.mul_le_mul_left 3 (Nat.succ_le_succ (Nat.zero_le l))))
+        · obtain ⟨left, right⟩ := large
+          constructor
+          · exact (Nat.mul_succ 3 r).symm ▸ Nat.le_trans
+              (Nat.add_le_add_right left 1) (Nat.add_le_add_left (by decide : 1 ≤ 3) (3 * r))
+          · exact (Nat.mul_succ 3 l).symm ▸ Nat.le_trans
+              (Nat.add_le_add_right right 1) (Nat.add_le_add_left (by decide : 1 ≤ 3) (3 * l))
+      exact Or.inl (Or.inr (Or.inl increased))
 
