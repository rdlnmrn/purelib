+  induction m using Nat.strongRecOn generalizing n with
+  | ind m ih =>
+    unfold bitwise
+    split
+    · exact Nat.zero_le _
+    · split
+      · exact Nat.zero_le _
+      · rename_i hm
+        have hr : bitwise Bool.and (n / 2) (m / 2) ≤ m / 2 :=
+          ih (m / 2) (bitwise_rec_lemma hm)
+        have hs := Nat.add_le_add hr hr
+        have hd : m / 2 + m / 2 + m % 2 = m := by
+          rewrite [← Nat.two_mul, Nat.add_comm]
+          exact Nat.mod_add_div m 2
+        dsimp only
+        split
+        · rename_i hb
