+theorem div_mul_le_self : ∀ (m n : Nat), m / n * n ≤ m := by
+  intro m n
+  induction m using Nat.strongRecOn with
+  | ind m ih =>
+    rewrite [div_eq]
+    cases (inferInstance : Decidable (0 < n ∧ n ≤ m)) with
