+      rewrite [if_neg h, Nat.zero_mul]
+      exact Nat.zero_le m
+    | isTrue h =>
+      rewrite [if_pos h, Nat.add_one_mul]
+      have smaller : m - n < m := sub_lt (Nat.lt_of_lt_of_le h.1 h.2) h.1
