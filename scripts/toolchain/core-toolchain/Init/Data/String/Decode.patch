+/-- Applies a checked 16-by-16 byte table to an arbitrary byte. -/
+private theorem byteTable (p : UInt8 → Prop)
+    (table : ∀ hi lo : Fin 16, p (UInt8.ofNat (hi.val * 16 + lo.val))) (b : UInt8) : p b := by
+  have hhi : b.toNat / 16 < 16 := by
+    apply Nat.lt_of_not_ge
+    intro hn
+    have hm := Nat.le_trans (Nat.mul_le_mul_right 16 hn) (Nat.div_mul_le_self b.toNat 16)
+    exact Nat.not_le_of_gt b.toNat_lt hm
+  let hi : Fin 16 := ⟨b.toNat / 16, hhi⟩
+  let lo : Fin 16 := ⟨b.toNat % 16, Nat.mod_lt _ (by decide)⟩
+  have hn : hi.val * 16 + lo.val = b.toNat := by
+    change b.toNat / 16 * 16 + b.toNat % 16 = b.toNat
+    rewrite [Nat.mul_comm, Nat.add_comm]
+    exact Nat.mod_add_div _ _
+  have hb : UInt8.ofNat (hi.val * 16 + lo.val) = b := by
+    rewrite [hn]
+    cases b with
+    | ofBitVec bv =>
+      cases bv with
+      | ofFin f => exact congrArg UInt8.ofBitVec (congrArg BitVec.ofFin (Fin.ext (Nat.mod_eq_of_lt f.isLt)))
+  exact hb ▸ table hi lo
