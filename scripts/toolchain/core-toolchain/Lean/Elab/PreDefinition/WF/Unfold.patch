+    else if let some hypothesis := context.findDecl? (fun declaration => if declaration.type == mkNot args[1]! then some declaration else none) then
+      applyDecision goal hypothesis.toExpr false
+    else
+      let (positive, negative) ← goal.byCasesDec args[1]! args[2]! `condition
