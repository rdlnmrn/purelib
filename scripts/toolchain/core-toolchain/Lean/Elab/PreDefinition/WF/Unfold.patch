+/-- Move an original fixed conditional outside its parameter binder. -/
+private def factor (e : Expr) : MetaM (Option Expr) := do
+  unless e.isLambda do return none
+  lambdaTelescope e fun parameters body => do
+    unless parameters.size == 1 do return none
+    let body ← whnfHeadPred body (fun e => pure (!e.isAppOf ``dite && !e.isAppOf ``Bind.bind))
+    unless body.isAppOfArity ``dite 5 do return none
+    let args := body.getAppArgs
+    if args[1]!.containsFVar parameters[0]!.fvarId! then return none
+    let whenTrue ← withLocalDeclD `retained args[1]! fun retained => do
+      let family ← mkLambdaFVars parameters (mkApp args[3]! retained)
+      mkLambdaFVars #[retained] family
+    let negation ← mkAppM ``Not #[args[1]!]
+    let whenFalse ← withLocalDeclD `retained negation fun retained => do
+      let family ← mkLambdaFVars parameters (mkApp args[4]! retained)
+      mkLambdaFVars #[retained] family
+    let parameterType ← inferType parameters[0]!
+    let resultType ← inferType body
+    let levels := [← getLevel parameterType, ← getLevel resultType]
+    return some (mkAppN (mkConst ``WellFounded.Nat.dite_family_eq levels)
+      #[parameterType, resultType, args[1]!, args[2]!, whenTrue, whenFalse])
+
+/-- Prove the actual original step's whole-family congruence by complete transports. -/
+private partial def solve (goal : MVarId) (families left right : Expr) : MetaM Unit := goal.withContext do
+  let some (_, lhs, rhs) := (← goal.getType').eq? | throwError "expected equality"
+  if lhs == rhs then
+    goal.assign (← mkEqRefl lhs)
+    return
+  let lhs ← normalize (beta lhs) left right
+  let rhs ← normalize (beta rhs) left right
+  let goal ← goal.change (← mkEq lhs rhs)
+  if let some call := lhs.find? (fun e => e.getAppFn == left && e.getAppArgs.size == 2 &&
+      e.getAppArgs[0]!.isAppOfArity ``PSigma.mk 4 &&
+      !e.getAppArgs[0]!.getAppArgs[3]!.hasLooseBVars && !e.getAppArgs[1]!.hasLooseBVars) then
+    let callArgs := call.getAppArgs
+    let stateArgs := callArgs[0]!.getAppArgs
+    let nextIndex := stateArgs[3]!
+    let bound := callArgs[1]!
+    let family ← withLocalDeclD `parameter stateArgs[0]! fun parameter => do
+      let next := mkAppN callArgs[0]!.getAppFn #[stateArgs[0]!, stateArgs[1]!, parameter, nextIndex]
+      mkLambdaFVars #[parameter] (mkApp2 left next bound)
+    let eq := mkApp2 families nextIndex bound
+    let familyType ← inferType family
+    withLocalDeclD `recursiveFamily familyType fun placeholder => do
+      let replaceCall (callback : Expr) (e : Expr) : Option Expr := do
+        guard (e.getAppFn == callback && e.getAppArgs.size == 2)
+        let args := e.getAppArgs
+        guard (args[0]!.isAppOfArity ``PSigma.mk 4)
+        let state := args[0]!.getAppArgs
+        guard (state[0]! == stateArgs[0]! && state[1]! == stateArgs[1]! && state[3]! == nextIndex && args[1]! == bound)
+        return mkApp placeholder state[2]!
+      let l := lhs.replace (replaceCall left)
+      let r := rhs.replace (replaceCall right)
+      if l != r then throwError "complete original expanded callback contexts differ"
+      let context ← mkLambdaFVars #[placeholder] l
+      goal.assign (← mkCongrArg context eq)
+    return
+  if let some leftFamily := family? lhs left then
+    if let some rightFamily := family? rhs right then
+      let eq ← lambdaTelescope leftFamily fun parameters body => do
+        let args := (beta body).getAppArgs
+        let nextIndex ← whnf (← mkAppM ``PSigma.snd #[args[0]!])
+        if nextIndex.containsFVar parameters[0]!.fvarId! || args[1]!.containsFVar parameters[0]!.fvarId! then
+          throwError "family index/bound still depends on recursive parameter"
+        return mkAppN families #[nextIndex, args[1]!]
+      unless ← isDefEq (← inferType eq) (← mkEq leftFamily rightFamily) do
+        throwError "actual supplied family equality does not match"
+      let familyType ← inferType leftFamily
+      withLocalDeclD `recursiveFamily familyType fun placeholder => do
+        let l := lhs.replace fun e => if e == leftFamily then some placeholder else none
+        let r := rhs.replace fun e => if e == rightFamily then some placeholder else none
+        unless ← isDefEq l r do throwError "original callback contexts differ"
+        let context ← mkLambdaFVars #[placeholder] l
+        goal.assign (← mkCongrArg context eq)
+      return
+  if let some leftEq ← factor lhs then
+    if let some rightEq ← factor rhs then
+      let (_, _, leftConditional) := (← inferType leftEq).eq?.get!
+      let (_, _, rightConditional) := (← inferType rightEq).eq?.get!
+      let sub ← mkFreshExprSyntheticOpaqueMVar (← mkEq leftConditional rightConditional)
+      solve sub.mvarId! families left right
+      goal.assign (← mkEqTrans leftEq (← mkEqTrans (← instantiateMVars sub) (← mkEqSymm rightEq)))
+      return
+  let lhs ← whnfHeadPred lhs (fun e => pure (!e.isAppOf ``dite && !e.isAppOf ``Bind.bind))
+  let rhs ← whnfHeadPred rhs (fun e => pure (!e.isAppOf ``dite && !e.isAppOf ``Bind.bind))
+  let goal ← goal.change (← mkEq lhs rhs)
+  if lhs.isAppOfArity ``dite 5 && rhs.isAppOfArity ``dite 5 then
+    let a := lhs.getAppArgs
+    let b := rhs.getAppArgs
+    unless ← isDefEq a[1]! b[1]! do throwError "different original discriminators"
+    let trueEqual ← withLocalDeclD `retained a[1]! fun retained => do
+      let sub ← mkFreshExprSyntheticOpaqueMVar (← mkEq (mkApp a[3]! retained) (mkApp b[3]! retained))
+      solve sub.mvarId! families left right
+      mkLambdaFVars #[retained] (← instantiateMVars sub)
+    let falseEqual ← withLocalDeclD `retained (← mkAppM ``Not #[a[1]!]) fun retained => do
+      let sub ← mkFreshExprSyntheticOpaqueMVar (← mkEq (mkApp a[4]! retained) (mkApp b[4]! retained))
+      solve sub.mvarId! families left right
+      mkLambdaFVars #[retained] (← instantiateMVars sub)
+    let proof := mkAppN (mkConst ``WellFounded.Nat.dite_eq_by_branches [← getLevel a[0]!])
+      #[a[0]!, a[1]!, a[2]!, a[3]!, b[3]!, a[4]!, b[4]!, trueEqual, falseEqual]
+    goal.assign proof
+    return
+  throwError "unsupported original family step: {← goal.getType'}"
+
+end FamilyProducer
