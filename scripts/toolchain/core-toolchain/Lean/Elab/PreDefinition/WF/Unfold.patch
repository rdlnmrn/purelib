+/-- Certify the original product-state recursion by whole recursive result families. -/
+private def familyNatFixEq? (fix : Expr) : MetaM (Option Expr) := observing? do
+  let args := fix.getAppArgs
+  unless args.size == 5 do throwError "expected saturated original natural fixed point"
+  let alpha ← whnf args[0]!
+  unless alpha.isAppOfArity ``PSigma 2 do throwError "not an original product state"
+  let some (.lam _ parameters index _) := alpha.getAppArgs.back? | throwError "not a product state family"
+  if index.hasLooseBVars then throwError "index depends on parameter"
+  let motive ← whnf args[1]!
+  unless motive.isLambda do throwError "not a constant original result motive"
+  let result := motive.bindingBody!
+  if result.hasLooseBVars then throwError "result depends on state"
+  let originalMeasure ← whnf args[2]!
+  unless originalMeasure.isLambda do throwError "not an original product measure"
+  let caseBody := originalMeasure.bindingBody!.consumeMData
+  unless caseBody.isAppOf ``PSigma.casesOn do throwError "not an original case-based product measure"
+  let branch := caseBody.getAppArgs.back!
+  let measure ← lambdaTelescope branch fun fields body => do
+    unless fields.size == 2 do throwError "not an original product measure branch"
+    if body.containsFVar fields[0]!.fvarId! then throwError "measure depends on parameter"
+    mkLambdaFVars #[fields[1]!] body
+  let levels := [← getLevel parameters, ← getLevel index, ← getLevel result]
+  let schemaArgs := #[parameters, index, result, measure, args[3]!]
+  let premise := mkAppN (mkConst ``WellFounded.Nat.FamilyStepCongruence levels) schemaArgs
+  let proof ← mkFreshExprSyntheticOpaqueMVar premise
+  let (introduced, goal) ← proof.mvarId!.introN 4
+  solveFamilyFields goal #[mkFVar introduced[0]!]
+    (mkFVar introduced[3]!) (mkFVar introduced[1]!) (mkFVar introduced[2]!)
+  let proof ← instantiateMVars proof
+  if proof.hasMVar then throwError "unresolved whole-family certificate"
+  let equation := mkAppN (mkConst ``WellFounded.Nat.fix_eq_of_familyStepCongruence levels)
+    (schemaArgs ++ #[proof, args[4]!])
+  let expected := mkAppN (mkConst ``WellFounded.Nat.fix_eq fix.getAppFn.constLevels!) args
+  unless ← isDefEq (← inferType equation) (← inferType expected) do
+    throwError "whole-family equation does not preserve original complete claim"
+  return equation
+
+/-- Use an imported pointwise equation certificate for the exact original natural recursion. -/
+private def pointwiseNatFixEq? (fix : Expr) : MetaM (Option Expr) := observing? do
+  let stepName := `WellFounded.Nat.StepCongruence
+  let eqName := `WellFounded.Nat.fix_eq_of_stepCongruence
+  unless (← getEnv).contains stepName && (← getEnv).contains eqName do
+    throwError "pointwise natural equation owner is not imported"
+  let args := fix.getAppArgs
+  unless args.size == 5 do throwError "expected saturated original natural fixed point"
+  -- Pointwise values cannot identify an opaque monadic continuation function.
+  -- The whole-family producer is tried first; unsupported bind steps retain the original equation route.
+  if (exposePointwiseStep args[3]!).find? (fun e => e.isAppOf ``Bind.bind) |>.isSome then
+    throwError "monadic step requires a whole-family certificate"
+  let levels := fix.getAppFn.constLevels!
+  let premise := mkAppN (mkConst stepName levels) args[:4].toArray
+  let proof ← mkFreshExprSyntheticOpaqueMVar premise
+  let (introduced, goal) ← proof.mvarId!.introN 4
+  solvePointwiseStep goal (mkFVar introduced[3]!) (mkFVar introduced[1]!) (mkFVar introduced[2]!)
+  let proof ← instantiateMVars proof
+  return mkAppN (mkConst eqName levels) (args[:4].toArray ++ #[proof, args[4]!])
 
