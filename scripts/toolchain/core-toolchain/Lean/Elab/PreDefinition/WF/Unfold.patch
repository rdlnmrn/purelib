+/-- Split original index products before comparing complete recursive families. -/
+private partial def solveFamilyFields (goal : MVarId) (fields : Array Expr)
+    (families left right : Expr) : MetaM Unit := goal.withContext do
+  if let some field ← fields.findM? (fun field => do
+      pure (field.isFVar && (← whnf (← inferType field)).isAppOf ``PSigma)) then
+    for branch in (← goal.cases field.fvarId!) do
+      solveFamilyFields branch.mvarId branch.fields
+        (branch.subst.apply families) (branch.subst.apply left) (branch.subst.apply right)
+  else
+    FamilyProducer.solve goal families left right
