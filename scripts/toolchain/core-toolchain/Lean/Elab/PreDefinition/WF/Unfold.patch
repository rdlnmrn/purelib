+/-- Close an exact step equality using scalar results and original constructor certificates. -/
+private partial def solvePointwiseStep (goal : MVarId) (pointwise leftCallback rightCallback : Expr) : MetaM Unit := goal.withContext do
+  let some (_, left, right) := (← goal.getType').eq?
+    | throwError "pointwise producer expected equality"
+  if left == right then
+    goal.assign (← mkEqRefl left)
+    return
+  unless ((← goal.getType').find? (· == leftCallback)).isSome do
+    try goal.refl; return catch _ => pure ()
+  if left.getAppFn == leftCallback then
+    if let some _ ← observing? do
+      let remaining ← goal.apply pointwise
+      unless remaining.isEmpty do throwError "not a direct recursive value"
+      return ()
+    then return
+  let left' := exposePointwiseStep (← whnfHeadPred left (fun e => pure (!e.isAppOf ``ite && !e.isAppOf ``dite && !e.isAppOf ``Bind.bind)))
+  let right' := exposePointwiseStep (← whnfHeadPred right (fun e => pure (!e.isAppOf ``ite && !e.isAppOf ``dite && !e.isAppOf ``Bind.bind)))
+  let goal ← goal.change (← mkEq left' right')
+  if left' == right' then
+    goal.assign (← mkEqRefl left')
+    return
+  unless ((← goal.getType').find? (· == leftCallback)).isSome do
+    try goal.refl; return catch _ => pure ()
+  if left'.getAppFn == right'.getAppFn && left'.getAppFn.isConst then
+    let constructorName := left'.getAppFn.constName!
+    if let .ctorInfo _ ← getConstInfo constructorName then
+      let equivalenceName := constructorName ++ `injEq
+      if (← getEnv).contains equivalenceName then
+        if let some _ ← observing? do
+          let equivalence ← mkConstWithFreshMVarLevels equivalenceName
+          let (arguments, _, claim) ← forallMetaTelescopeReducing (← inferType equivalence)
+          unless claim.isAppOfArity ``Iff 2 do throwError "constructor certificate is not Iff"
+          let claims := claim.getAppArgs
+          unless ← isDefEq claims[0]! (← goal.getType') do
+            throwError "constructor certificate does not identify complete original applications"
+          let certificate := mkAppN equivalence arguments
+          let reverse := mkApp3 (mkConst ``Iff.mpr) claims[0]! claims[1]! certificate
+          for remaining in ← goal.apply reverse do
+            for fieldGoal in ← remaining.splitAnd do
+              solvePointwiseStep fieldGoal pointwise leftCallback rightCallback
+          return ()
+        then return
+  if let some elimination := (← goal.getType').find? (fun e =>
+      e.getAppFn.isConst && e.getAppFn.constName!.getString! == "casesOn") then
+    let parent := elimination.getAppFn.constName!.getPrefix
+    for argument in elimination.getAppArgs do
+      if argument.isFVar then
+        let type ← whnf (← inferType argument)
+        if type.getAppFn.isConst && type.getAppFn.constName! == parent then
+          let branches ← goal.cases argument.fvarId!
+          for branch in branches do
+            solvePointwiseStep branch.mvarId (branch.subst.apply pointwise) (branch.subst.apply leftCallback) (branch.subst.apply rightCallback)
+          return
+  if let some recursor := (← goal.getType').find? (fun e =>
+      e.getAppFn.isConst && ["rec", "recOn"].contains e.getAppFn.constName!.getString! && !e.hasLooseBVars) then
+    if let .recInfo information ← getConstInfo recursor.getAppFn.constName! then
+      let arguments := recursor.getAppArgs
+      if information.getMajorIdx < arguments.size then
+        let major ← whnf arguments[information.getMajorIdx]!
+        let rec projectionRoot (e : Expr) : MetaM Expr := do
+          match e with
+          | .proj _ _ value => projectionRoot value
+          | _ =>
+            if e.getAppFn.isConst then
+              if let some information ← getProjectionFnInfo? e.getAppFn.constName! then
+                if information.numParams < e.getAppArgs.size then
+                  return ← projectionRoot e.getAppArgs[information.numParams]!
+            return e
+        let root ← projectionRoot major
+        if root.isFVar then
+          let branches ← goal.cases root.fvarId!
+          for branch in branches do
+            solvePointwiseStep branch.mvarId (branch.subst.apply pointwise) (branch.subst.apply leftCallback) (branch.subst.apply rightCallback)
+          return
+  let conditional? := [left', right'].find? (fun e =>
+      (e.isAppOfArity ``ite 5 || e.isAppOfArity ``dite 5) &&
+      !e.getAppArgs[2]!.hasLooseBVars &&
+      !e.getAppArgs[2]!.isAppOf ``Decidable.isTrue &&
+      !e.getAppArgs[2]!.isAppOf ``Decidable.isFalse)
+  if let some conditional := conditional? then
+    let args := conditional.getAppArgs
+    let applyDecision (branch : MVarId) (hypothesis : Expr) (positive : Bool) : MetaM Unit := branch.withContext do
+      let rule := if conditional.isAppOf ``dite then
+          if positive then ``dif_pos else ``dif_neg
+        else if positive then ``if_pos else ``if_neg
+      let equation := mkAppN (mkConst rule conditional.getAppFn.constLevels!)
+        #[args[1]!, args[2]!, hypothesis, args[0]!, args[3]!, args[4]!]
+      let rewritten ← branch.rewrite (← branch.getType') equation
+      unless rewritten.mvarIds.isEmpty do throwError "unexpected conditional transport goals"
