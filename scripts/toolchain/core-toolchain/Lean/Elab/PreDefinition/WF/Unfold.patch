+private partial def normalizeProofs (e left right : Expr) : MetaM Expr := do
+  if e.getAppFn.isConst && (e.getAppArgs.any (fun sub => sub == left || sub == right)) && (← isProp (← inferType e)) then
+    let info ← getConstInfo e.getAppFn.constName!
+    if let some body := info.value? (allowOpaque := true) then
+      let expanded := (mkAppN (body.instantiateLevelParams info.levelParams e.getAppFn.constLevels!) e.getAppArgs).headBeta
+      if expanded != e then return ← normalizeProofs expanded left right
+  match e with
+  | .app f a => return mkApp (← normalizeProofs f left right) (← normalizeProofs a left right)
+  | .proj owner index value => return .proj owner index (← normalizeProofs value left right)
+  | .lam n t b bi =>
+    withLocalDecl n bi t fun parameter => do
+      mkLambdaFVars #[parameter] (← normalizeProofs (b.instantiate1 parameter) left right)
+  | .letE _ _ value body _ => normalizeProofs (body.instantiate1 value) left right
+  | .mdata metadata body => return .mdata metadata (← normalizeProofs body left right)
+  | _ => return e
