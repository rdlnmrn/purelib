+      e.getAppFn == leftCallback && e.getAppArgs.size == 2 && !e.hasLooseBVars) then
+    let eq := mkAppN pointwise call.getAppArgs
+    let rewritten ← goal.rewrite (← goal.getType') eq
+    unless rewritten.mvarIds.isEmpty do throwError "unexpected recursive transport goals"
+    let next ← goal.replaceTargetEq rewritten.eNew rewritten.eqProof
+    solvePointwiseStep next pointwise leftCallback rightCallback
+    return
+  if left'.isApp && right'.isApp then
+    if (← isDefEq left'.appFn! right'.appFn!) then
+      let sub ← mkFreshExprSyntheticOpaqueMVar (← mkEq left'.appArg! right'.appArg!)
+      solvePointwiseStep sub.mvarId! pointwise leftCallback rightCallback
+      let proof ← mkCongrArg left'.appFn! (← instantiateMVars sub)
+      goal.assign proof
+      return
