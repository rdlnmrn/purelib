+/-- Expose only original lambda and let applications, retaining conditional discriminators. -/
+private partial def exposePointwiseStep (e : Expr) : Expr :=
+  match e with
+  | .letE _ _ value body _ => exposePointwiseStep (body.instantiate1 value)
+  | .mdata _ body => exposePointwiseStep body
+  | .app f a =>
+    let e' := mkApp (exposePointwiseStep f) a
+    let b := e'.headBeta
+    if b != e' then exposePointwiseStep b else
+      if e'.isAppOfArity ``ite 5 || e'.isAppOfArity ``dite 5 then
+        let args := e'.getAppArgs
+        let decision := args[2]!
+        if decision.isAppOfArity ``Decidable.isTrue 2 then
+          exposePointwiseStep (if e'.isAppOf ``dite then mkApp args[3]! decision.appArg! else args[3]!)
+        else if decision.isAppOfArity ``Decidable.isFalse 2 then
+          exposePointwiseStep (if e'.isAppOf ``dite then mkApp args[4]! decision.appArg! else args[4]!)
+        else e'
+      else e'
+  | .lam name type body mode => .lam name type (exposePointwiseStep body) mode
+  | _ => e
