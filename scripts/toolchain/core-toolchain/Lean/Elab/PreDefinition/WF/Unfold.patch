+/-- Expose complete original lambda applications without simplifying beneath functions. -/
+private partial def beta (e : Expr) : Expr :=
+  match e with
+  | .mdata _ body => beta body
+  | .letE _ _ value body _ => beta (body.instantiate1 value)
+  | .app f a =>
+      let e' := mkApp (beta f) (beta a)
+      let reduced := e'.headBeta
+      if reduced == e' then e' else beta reduced
+  | .lam n t body bi => .lam n t (beta body) bi
+  | _ => e
+
+/-- Inline only a retained proof's complete original application. -/
+private partial def inlineProof (e : Expr) : MetaM Expr := do
+  let e := beta e
+  if e.getAppFn.isConst then
+    unless isPrivateName e.getAppFn.constName! do return e
+    let info ← getConstInfo e.getAppFn.constName!
+    if let some body := info.value? (allowOpaque := true) then
+      let reduced ← whnf (beta (mkAppN (body.instantiateLevelParams info.levelParams e.getAppFn.constLevels!) e.getAppArgs))
+      if reduced == e then return e
+      return ← inlineProof reduced
+  return e
+
+/-- Remove irrelevant callback binders from retained scalar bound certificates. -/
+private partial def normalize (e left right : Expr) : MetaM Expr := do
+  if e.isApp && (e.getAppFn == left || e.getAppFn == right) && e.getAppArgs.size == 2 then
+    let args := e.getAppArgs
+    return mkAppN e.getAppFn #[← normalize args[0]! left right, ← inlineProof args[1]!]
+  if (← isProp (← inferType e)) then
+    return ← inlineProof e
+  match e with
+  | .app f a => return mkApp (← normalize f left right) (← normalize a left right)
+  | .lam n t b bi =>
+    withLocalDecl n bi t fun parameter => do
+      mkLambdaFVars #[parameter] (← normalize (b.instantiate1 parameter) left right)
+  | .mdata md b => return .mdata md (← normalize b left right)
+  | _ => return e
+
+/-- Identify a closed whole recursive result family. -/
+private def family? (e callback : Expr) : Option Expr :=
+  e.find? fun e => e.isLambda && !e.hasLooseBVars && (beta e.bindingBody!).getAppFn == callback
