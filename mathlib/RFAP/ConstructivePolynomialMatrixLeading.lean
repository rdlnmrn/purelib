import mathlib.RFAP.ConstructivePolynomialLeading
import mathlib.RFAP.ConstructivePolynomialMatrix

/-!
# Leading-triangular certificates for fraction-free polynomial matrices

Column degree bounds whose top-coefficient matrix is upper triangular survive
the fraction-free Schur step.  Consequently every fixed pivot in the symbolic
scaled-inverse recursion is nonzero.
-/

namespace RFAP.ConstructivePolynomialMatrixLeading

abbrev Polynomial (K : Type*) :=
  RFAP.ComputablePolynomial.DensePolynomial K
abbrev Matrix (K : Type*) (n : Nat) :=
  RFAP.ConstructivePolynomialMatrix.Matrix K n

open RFAP.ConstructivePolynomialLeading

variable {K : Type*} [RFAP.ExplicitField K] [DecidableEq K] [Nontrivial K]

structure UpperTriangularLeading {n : Nat} (matrix : Matrix K n)
    (degrees : Fin n → Nat) (diagonal : Fin n → K) : Prop where
  atMost : ∀ row column,
    DegreeAtMost (matrix row column) (degrees column)
  below : ∀ row column, column < row →
    DegreeBelow (matrix row column) (degrees column)
  diagonalLeading : ∀ index,
    LeadingTerm (matrix index index) (degrees index) (diagonal index)

def schurDegrees (degrees : Fin (n + 1) → Nat) : Fin n → Nat :=
  fun column => degrees 0 + degrees column.succ

def schurDiagonal (diagonal : Fin (n + 1) → K) : Fin n → K :=
  fun index => diagonal 0 * diagonal index.succ

omit [Nontrivial K] in
theorem schur_preserves
    {matrix : Matrix K (n + 1)} {degrees : Fin (n + 1) → Nat}
    {diagonal : Fin (n + 1) → K}
    (leading : UpperTriangularLeading matrix degrees diagonal) :
    UpperTriangularLeading
      (RFAP.ConstructivePolynomialMatrix.schur matrix)
      (schurDegrees degrees) (schurDiagonal diagonal) where
  atMost := by
    intro row column
    rw [RFAP.ConstructivePolynomialMatrix.schur_apply,
      RFAP.ConstructivePolynomialMatrix.tail_apply,
      RFAP.ConstructivePolynomialMatrix.leftColumn_apply,
      RFAP.ConstructivePolynomialMatrix.topRow_apply]
    unfold RFAP.ConstructivePolynomialMatrix.head schurDegrees
    apply DegreeAtMost.sub
    · exact DegreeAtMost.mul
        (leading.diagonalLeading 0).atMost
        (leading.atMost row.succ column.succ)
    · exact DegreeAtMost.mul
        (leading.atMost row.succ 0)
        (leading.atMost 0 column.succ)
  below := by
    intro row column belowDiagonal
    rw [RFAP.ConstructivePolynomialMatrix.schur_apply,
      RFAP.ConstructivePolynomialMatrix.tail_apply,
      RFAP.ConstructivePolynomialMatrix.leftColumn_apply,
      RFAP.ConstructivePolynomialMatrix.topRow_apply]
    unfold RFAP.ConstructivePolynomialMatrix.head schurDegrees
    apply DegreeBelow.sub
    · exact DegreeBelow.atMostMul
        (leading.diagonalLeading 0).atMost
        (leading.below row.succ column.succ
          (Fin.succ_lt_succ_iff.mpr belowDiagonal))
    · exact DegreeBelow.mulAtMost
        (leading.below row.succ 0 (Fin.succ_pos row))
        (leading.atMost 0 column.succ)
  diagonalLeading := by
    intro index
    rw [RFAP.ConstructivePolynomialMatrix.schur_apply,
      RFAP.ConstructivePolynomialMatrix.tail_apply,
      RFAP.ConstructivePolynomialMatrix.leftColumn_apply,
      RFAP.ConstructivePolynomialMatrix.topRow_apply]
    unfold RFAP.ConstructivePolynomialMatrix.head schurDegrees schurDiagonal
    apply LeadingTerm.subBelow
    · exact LeadingTerm.mul
        (leading.diagonalLeading 0)
        (leading.diagonalLeading index.succ)
    · exact DegreeBelow.mulAtMost
        (leading.below index.succ 0 (Fin.succ_pos index))
        (leading.atMost 0 index.succ)

/-- Every scalar pivot generated by the fixed fraction-free recursion is a
nonzero dense polynomial when the input top-coefficient matrix is upper
triangular with nonzero diagonal. -/
theorem scaledInverseData_scalar_nonzero :
    ∀ {n : Nat} {matrix : Matrix K n} {degrees : Fin n → Nat}
      {diagonal : Fin n → K},
      UpperTriangularLeading matrix degrees diagonal →
      (RFAP.ConstructivePolynomialMatrix.scaledInverseData n matrix).scalar.isZero =
        false
  | 0, _, _, _, _ => by
      change (RFAP.ComputablePolynomial.DensePolynomial.constant (1 : K)).isZero =
        false
      exact (LeadingTerm.constant (K := K) one_ne_zero).nonzero
  | n + 1, matrix, degrees, diagonal, leading => by
      change
        (RFAP.ConstructivePolynomialMatrix.head matrix *
          (RFAP.ConstructivePolynomialMatrix.scaledInverseData n
            (RFAP.ConstructivePolynomialMatrix.schur matrix)).scalar).isZero =
          false
      apply RFAP.ComputablePolynomial.DensePolynomial.isZero_mul_eq_false
      · exact (leading.diagonalLeading 0).nonzero
      · exact scaledInverseData_scalar_nonzero (schur_preserves leading)

end RFAP.ConstructivePolynomialMatrixLeading
