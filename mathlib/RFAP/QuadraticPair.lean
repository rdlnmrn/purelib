import Mathlib.Algebra.Ring.MinimalAxioms
import mathlib.Tactic.QuotientFreeRing
import mathlib.Tactic.QuotientFreeOmega

/-!
# A finite quadratic pair ring

`QuadraticPair K b` is the two-coordinate commutative ring generated by an
element `j` with `j² = -b`.  It is an executable finite algebraic
construction: no roots, quotient ring, basis choice, or carrier enumeration
is used.
-/

namespace RFAP

@[ext]
structure QuadraticPair (K : Type*) (radialSquare : K) where
  re : K
  im : K

namespace QuadraticPair

variable {K : Type*} {radialSquare : K}

instance [Zero K] : Zero (QuadraticPair K radialSquare) :=
  ⟨⟨0, 0⟩⟩

instance [Zero K] [One K] : One (QuadraticPair K radialSquare) :=
  ⟨⟨1, 0⟩⟩

instance [Add K] : Add (QuadraticPair K radialSquare) :=
  ⟨fun left right => ⟨left.re + right.re, left.im + right.im⟩⟩

instance [Neg K] : Neg (QuadraticPair K radialSquare) :=
  ⟨fun value => ⟨-value.re, -value.im⟩⟩

instance [CommRing K] : Mul (QuadraticPair K radialSquare) :=
  ⟨fun left right =>
    ⟨left.re * right.re - radialSquare * left.im * right.im,
      left.re * right.im + left.im * right.re⟩⟩

@[simp] theorem zero_re [Zero K] :
    (0 : QuadraticPair K radialSquare).re = 0 := rfl

@[simp] theorem zero_im [Zero K] :
    (0 : QuadraticPair K radialSquare).im = 0 := rfl

@[simp] theorem one_re [Zero K] [One K] :
    (1 : QuadraticPair K radialSquare).re = 1 := rfl

@[simp] theorem one_im [Zero K] [One K] :
    (1 : QuadraticPair K radialSquare).im = 0 := rfl

@[simp] theorem add_re [Add K] (left right : QuadraticPair K radialSquare) :
    (left + right).re = left.re + right.re := rfl

@[simp] theorem add_im [Add K] (left right : QuadraticPair K radialSquare) :
    (left + right).im = left.im + right.im := rfl

@[simp] theorem neg_re [Neg K] (value : QuadraticPair K radialSquare) :
    (-value).re = -value.re := rfl

@[simp] theorem neg_im [Neg K] (value : QuadraticPair K radialSquare) :
    (-value).im = -value.im := rfl

@[simp] theorem mul_re [CommRing K]
    (left right : QuadraticPair K radialSquare) :
    (left * right).re =
      left.re * right.re - radialSquare * left.im * right.im := rfl

@[simp] theorem mul_im [CommRing K]
    (left right : QuadraticPair K radialSquare) :
    (left * right).im = left.re * right.im + left.im * right.re := rfl

private theorem add_assoc [CommRing K]
    (first second third : QuadraticPair K radialSquare) :
    first + second + third = first + (second + third) := by
  ext <;> simp only [add_re, add_im] <;> ring1

private theorem zero_add [CommRing K]
    (value : QuadraticPair K radialSquare) : 0 + value = value := by
  ext <;> simp only [add_re, add_im, zero_re, zero_im] <;> ring1

private theorem neg_add_cancel [CommRing K]
    (value : QuadraticPair K radialSquare) : -value + value = 0 := by
  ext <;> simp only [neg_re, neg_im, add_re, add_im, zero_re, zero_im] <;>
    ring1

private theorem mul_assoc [CommRing K]
    (first second third : QuadraticPair K radialSquare) :
    first * second * third = first * (second * third) := by
  ext <;> simp only [mul_re, mul_im] <;> ring1

private theorem mul_comm [CommRing K]
    (left right : QuadraticPair K radialSquare) : left * right = right * left := by
  ext <;> simp only [mul_re, mul_im] <;> ring1

private theorem one_mul [CommRing K]
    (value : QuadraticPair K radialSquare) : 1 * value = value := by
  ext <;> simp only [mul_re, mul_im, one_re, one_im] <;> ring1

private theorem left_distrib [CommRing K]
    (first second third : QuadraticPair K radialSquare) :
    first * (second + third) = first * second + first * third := by
  ext <;> simp only [mul_re, mul_im, add_re, add_im] <;> ring1

instance instCommRing [CommRing K] : CommRing (QuadraticPair K radialSquare) :=
  CommRing.ofMinimalAxioms add_assoc zero_add neg_add_cancel mul_assoc mul_comm
    one_mul left_distrib

@[simp] theorem sub_re [CommRing K]
    (left right : QuadraticPair K radialSquare) :
    (left - right).re = left.re - right.re := by
  change (left + -right).re = left.re - right.re
  rw [add_re, neg_re, sub_eq_add_neg]

@[simp] theorem sub_im [CommRing K]
    (left right : QuadraticPair K radialSquare) :
    (left - right).im = left.im - right.im := by
  change (left + -right).im = left.im - right.im
  rw [add_im, neg_im, sub_eq_add_neg]

/-- Embed a scalar as a pair with zero generator coefficient. -/
def scalar [Zero K] (value : K) : QuadraticPair K radialSquare := ⟨value, 0⟩

/-- The distinguished generator satisfying `j²=-b`. -/
def generator [Zero K] [One K] : QuadraticPair K radialSquare := ⟨0, 1⟩

@[simp] theorem scalar_re [Zero K] (value : K) :
    (scalar (radialSquare := radialSquare) value).re = value := rfl

@[simp] theorem scalar_im [Zero K] (value : K) :
    (scalar (radialSquare := radialSquare) value).im = 0 := rfl

@[simp] theorem generator_re [Zero K] [One K] :
    (generator (K := K) (radialSquare := radialSquare)).re = 0 := rfl

@[simp] theorem generator_im [Zero K] [One K] :
    (generator (K := K) (radialSquare := radialSquare)).im = 1 := rfl

@[simp] theorem scalar_zero [CommRing K] :
    scalar (radialSquare := radialSquare) (0 : K) = 0 := by
  ext <;> rfl

@[simp] theorem scalar_one [CommRing K] :
    scalar (radialSquare := radialSquare) (1 : K) = 1 := by
  ext <;> rfl

@[simp] theorem scalar_add [CommRing K] (left right : K) :
    scalar (radialSquare := radialSquare) (left + right) =
      scalar left + scalar right := by
  ext <;> simp only [scalar_re, scalar_im, add_re, add_im]
  all_goals ring1

@[simp] theorem scalar_neg [CommRing K] (value : K) :
    scalar (radialSquare := radialSquare) (-value) = -scalar value := by
  ext <;> simp only [scalar_re, scalar_im, neg_re, neg_im]
  all_goals ring1

@[simp] theorem scalar_sub [CommRing K] (left right : K) :
    scalar (radialSquare := radialSquare) (left - right) =
      scalar left - scalar right := by
  ext <;> simp only [scalar_re, scalar_im, sub_re, sub_im]
  all_goals ring1

@[simp] theorem scalar_mul [CommRing K] (left right : K) :
    scalar (radialSquare := radialSquare) (left * right) =
      scalar left * scalar right := by
  ext <;> simp only [scalar_re, scalar_im, mul_re, mul_im] <;> ring1

@[simp] theorem scalar_pow [CommRing K] (value : K) :
    ∀ exponent : Nat,
      scalar (radialSquare := radialSquare) (value ^ exponent) =
        scalar value ^ exponent
  | 0 => by rw [pow_zero, pow_zero, scalar_one]
  | exponent + 1 => by
      rw [pow_succ, pow_succ, scalar_mul, scalar_pow value exponent]

@[simp] theorem natCast_eq_scalar [CommRing K] (value : Nat) :
    (value : QuadraticPair K radialSquare) =
      scalar (radialSquare := radialSquare) (value : K) := by
  induction value with
  | zero => rw [Nat.cast_zero, Nat.cast_zero, scalar_zero]
  | succ value inductionHypothesis =>
      rw [Nat.cast_succ, Nat.cast_succ, inductionHypothesis, ← scalar_one,
        ← scalar_add]

@[simp] theorem two_eq_scalar [CommRing K] :
    (2 : QuadraticPair K radialSquare) =
      scalar (radialSquare := radialSquare) (2 : K) := by
  exact natCast_eq_scalar 2

@[simp] theorem four_eq_scalar [CommRing K] :
    (4 : QuadraticPair K radialSquare) =
      scalar (radialSquare := radialSquare) (4 : K) := by
  exact natCast_eq_scalar 4

@[simp] theorem generator_square [CommRing K] :
    generator (K := K) (radialSquare := radialSquare) ^ 2 =
      scalar (-radialSquare) := by
  ext <;> simp only [pow_two, mul_re, mul_im, generator_re, generator_im,
    scalar_re, scalar_im] <;> ring1

@[simp] theorem generator_even_power [CommRing K] (index : Nat) :
    generator (K := K) (radialSquare := radialSquare) ^ (index + index) =
      scalar ((-radialSquare) ^ index) := by
  calc
    generator (K := K) (radialSquare := radialSquare) ^ (index + index) =
        generator ^ (2 * index) := by
          congr 1
          omega0
    _ = (generator (K := K) (radialSquare := radialSquare) ^ 2) ^ index := by
      rw [pow_mul]
    _ = scalar (radialSquare := radialSquare) (-radialSquare) ^ index := by
      rw [generator_square]
    _ = scalar ((-radialSquare) ^ index) := by rw [scalar_pow]

end QuadraticPair

end RFAP
